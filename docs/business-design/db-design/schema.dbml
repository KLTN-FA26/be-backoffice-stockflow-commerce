}

Table ordering.production_order_status_transition [headercolor: #C0392B] {
  from_status varchar(24) [not null]
  to_status   varchar(24) [not null]
  indexes {
    (from_status, to_status) [pk]
  }
}

Table ordering.quote [headercolor: #C0392B] {
  id                      uuid [pk]
  quote_number            varchar(30) [not null, unique]
  request_id              uuid [not null, unique]

  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table design.design_draft [headercolor: #AA4A9E] {
  id                  uuid [pk]
  customer_id         uuid [not null]
  product_id          uuid [not null]
  name                varchar(200)
  spec                varchar(4000)
  status              design.design_draft_status [not null]
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null]
  created_by          varchar(100)
  last_modified_at    timestamptz
  last_modified_by    varchar(100)
  owner_user_id       uuid
  assigned_user_id    uuid
  current_artifact_id uuid
  preflight_passed    boolean [not null, default: false]
  reviewer_user_id    uuid
  last_editor_user_id uuid
  reviewed_by         uuid
  review_notes        varchar(2000)
  parent_snapshot_id  uuid
  current_artifacts   jsonb [not null]
}

Table design.design_snapshot [headercolor: #AA4A9E] {
  id                uuid [pk]
  draft_id          uuid [not null]
  checksum          varchar(128) [not null]
  artifact_url      varchar(500) [not null]
  confirmed_at      timestamptz [not null]
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
  artifact_id       uuid
  confirmed_by      uuid
  spec              varchar(4000)
  reviewed_by       uuid
  review_notes      varchar(2000)
  artifact_manifest jsonb [not null]
}

// =============================================================================
// SCHEMA: fulfillment
// =============================================================================

Table fulfillment.design_verification [headercolor: #2C7873] {
  id                uuid [pk]
  pack_id           uuid [not null]
  order_id          uuid [not null]
  order_line_id     uuid [not null]
  snapshot_id       uuid [not null]
  expected_checksum varchar(64) [not null]
  actual_checksum   varchar(64) [not null]
  result            fulfillment.design_verification_result [not null]
  verified_by       uuid [not null]
  verified_at       timestamptz [not null]
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
}

Table fulfillment.pack [headercolor: #2C7873] {
  id               uuid [pk]
  pick_id          uuid [not null, unique]
  status           fulfillment.pack_status [not null]
  packed_at        timestamptz
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table fulfillment.package [headercolor: #2C7873] {
  id               uuid [pk]
  pack_id          uuid [not null]
  shipment_id      uuid
  package_no       int [not null]
  weight_kg        decimal(10,3)
  length_cm        decimal(10,2)
  width_cm         decimal(10,2)
  height_cm        decimal(10,2)
  dim_weight_kg    decimal(10,3)
  tracking_number  varchar(128)
  label_url        varchar(500)
  status           fulfillment.package_status [not null, default: 'OPEN']
  sealed_at        timestamptz
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (pack_id, package_no) [unique]
  }
}

Table fulfillment.package_line [headercolor: #2C7873] {
  id               uuid [pk]
  package_id       uuid [not null]
  order_line_id    uuid [not null]
  quantity         int [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (package_id, order_line_id) [unique]
  }
}

Table fulfillment.pick [headercolor: #2C7873] {
  id               uuid [pk]
  wave_id          uuid
  order_id         uuid [not null, unique]
  status           fulfillment.pick_status [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  assigned_user_id uuid
  assigned_at      timestamptz
  started_at       timestamptz
  picked_at        timestamptz
}

Table fulfillment.pick_line [headercolor: #2C7873] {
  id               uuid [pk]
  pick_id          uuid [not null]
  order_line_id    uuid [not null]
  reservation_id   uuid
  sku              varchar(64) [not null]
  location_code    varchar(64) [not null]
  lot_number       varchar(64)
  sequence_no      int [not null, default: 0]
  allocated_qty    int [not null]
  picked_qty       int [not null, default: 0]
  short_qty        int [not null, default: 0]
  status           fulfillment.pick_line_status [not null, default: 'OPEN']
  picked_by        uuid
  picked_at        timestamptz
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table fulfillment.shipment [headercolor: #2C7873] {
  id               uuid [pk]
  pack_id          uuid
  order_id         uuid [not null]
  carrier          varchar(120)
  tracking_number  varchar(128)
  status           fulfillment.shipment_status [not null]
  dispatched_at    timestamptz
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table fulfillment.shipment_event [headercolor: #2C7873] {
  id               uuid [pk]
  shipment_id      uuid [not null]
  status           fulfillment.shipment_event_status [not null]
  occurred_at      timestamptz [not null]
  source           fulfillment.shipment_event_source [not null]
  carrier_event_id varchar(128)
  location_text    varchar(255)
  note             varchar(1000)
  raw_payload      jsonb
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table fulfillment.wave [headercolor: #2C7873] {
  id               uuid [pk]
  code             varchar(64) [not null, unique]
  status           fulfillment.wave_status [not null]
  released_at      timestamptz
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

// =============================================================================
// SCHEMA: catalog
// =============================================================================

Table catalog.catalog_entry [headercolor: #1B998B] {
  id               uuid [pk]
  sku              varchar(64) [not null, unique]
  title            varchar(300) [not null]
  slug             varchar(200) [not null, unique]
  description      varchar(2000)
  price            decimal(18,2)
  currency         varchar(3) [not null, default: 'VND']
  atp              int
  published        boolean [not null, default: false]
  seo_title        varchar(300)
  seo_description  varchar(500)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table catalog.pricing_rule [headercolor: #1B998B] {
  id               uuid [pk]
  name             varchar(200) [not null]
  sku              varchar(64)
  segment_id       uuid
  price            decimal(18,2) [not null]
  currency         varchar(3) [not null, default: 'VND']
  priority         int [not null, default: 0]
  active           boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table catalog.promotion [headercolor: #1B998B] {
  id               uuid [pk]
  code             varchar(64) [not null, unique]
  name             varchar(200) [not null]
  type             catalog.promotion_type [not null]
  value            decimal(18,2) [not null]
  starts_at        timestamptz
  ends_at          timestamptz
  active           boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

// =============================================================================
// SCHEMA: chat
// =============================================================================

Table chat.conversation [headercolor: #4C93A8] {
  id                uuid [pk]
  customer_id       uuid [not null]
  order_id          uuid
  subject           varchar(300)
  status            chat.conversation_status [not null]
  assigned_agent_id uuid
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
}

Table chat.message [headercolor: #4C93A8] {
  id               uuid [pk]
  conversation_id  uuid [not null]
  sender_type      chat.message_sender_type [not null]
  sender_id        uuid
  body             varchar(4000) [not null]
  sent_at          timestamptz [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

// =============================================================================
// SCHEMA: notification
// =============================================================================

Table notification.delivery_log [headercolor: #A6763F] {
  id               uuid [pk]
  template_code    varchar(64)
  channel          notification.delivery_log_channel [not null]
  recipient        varchar(320) [not null]
  status           notification.delivery_log_status [not null]
  error            varchar(1000)
  sent_at          timestamptz
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table notification.preference [headercolor: #A6763F] {
  id               uuid [pk]
  user_id          uuid [not null]
  channel          notification.preference_channel [not null]
  enabled          boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (user_id, channel) [unique]
  }
}

Table notification.template [headercolor: #A6763F] {
  id               uuid [pk]
  code             varchar(64) [not null]
  channel          notification.template_channel [not null]
  subject          varchar(300)
  body             varchar(4000) [not null]
  locale           varchar(10) [not null, default: 'vi']
  active           boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (code, locale) [unique]
  }
}

// =============================================================================
// SCHEMA: reporting
// =============================================================================

Table reporting.product_sales_summary [headercolor: #607D8B] {
  id               uuid [pk]
  sku              varchar(64) [not null]
  period           varchar(7) [not null]
  quantity_sold    int [not null, default: 0]
  revenue          decimal(18,2) [not null, default: 0]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (sku, period) [unique]
  }
}

Table reporting.sales_daily_summary [headercolor: #607D8B] {
  id               uuid [pk]
  day              date [not null, unique]
  orders_count     int [not null, default: 0]
  revenue          decimal(18,2) [not null, default: 0]
  currency         varchar(3) [not null, default: 'VND']
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

// =============================================================================
// SCHEMA: identity
// =============================================================================

Table identity.app_role [headercolor: #5A6ACF] {
  id               uuid [pk]
  code             varchar(64) [not null, unique]
  name             varchar(200) [not null]
  description      varchar(1000)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table identity.app_user [headercolor: #5A6ACF] {
  id               uuid [pk]
  username         varchar(320) [not null, unique]
  email            varchar(320) [not null, unique]
  password_hash    varchar(200) [not null]
  full_name        varchar(200)
  status           identity.app_user_status [not null]
  last_login_at    timestamptz
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table identity.permission [headercolor: #5A6ACF] {
  id               uuid [pk]
  code             varchar(128) [not null, unique]
  resource         varchar(64)
  action           varchar(64)
  description      varchar(500)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table identity.role_permission [headercolor: #5A6ACF] {
  id               uuid [pk]
  role_id          uuid [not null]
  permission_id    uuid [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (role_id, permission_id) [unique]
  }
}

Table identity.user_role [headercolor: #5A6ACF] {
  id               uuid [pk]
  user_id          uuid [not null]
  role_id          uuid [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (user_id, role_id) [unique]
  }
}

Table identity.user_session [headercolor: #5A6ACF] {
  id               uuid [pk]
  user_id          uuid [not null]
  issued_at        timestamptz [not null]
  expires_at       timestamptz [not null]
  revoked_at       timestamptz
  revoked_reason   identity.user_session_revoked_reason
  client_address   varchar(45)
  user_agent       varchar(255)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

// =============================================================================
// SCHEMA: platform
// =============================================================================

Table platform.audit_log [headercolor: #616161] {
  id                uuid [pk]
  actor_id          uuid
  actor_name        varchar(100)
  action            platform.audit_log_action [not null]
  resource_type     varchar(64) [not null]
  resource_id       varchar(128)
  outcome           platform.audit_log_outcome [not null]
  correlation_id    varchar(64)
  client_address    varchar(45)
  details           text
  occurred_at       timestamptz [not null]
  security_relevant boolean [not null]
}

Table platform.document_sequence [headercolor: #616161] {
  document_type varchar(16) [not null]
  sequence_date date [not null]
  last_value    bigint [not null, default: 0]
  indexes {
    (document_type, sequence_date) [pk]
  }
}

Table platform.idempotency_record [headercolor: #616161] {
  id                  uuid [pk]
  idempotency_key     varchar(255) [not null]
  caller              varchar(64) [not null]
  request_fingerprint varchar(64) [not null]
  status              platform.idempotency_record_status [not null]
  response_status     int
  response_body       text
  created_at          timestamptz [not null]
  completed_at        timestamptz
  expires_at          timestamptz [not null]
  indexes {
    (idempotency_key, caller) [unique]
  }
}

Table platform.shedlock [headercolor: #616161] {
  name       varchar(64) [pk]
  lock_until timestamptz [not null]
  locked_at  timestamptz [not null]
  locked_by  varchar(255) [not null]
}

// =============================================================================
// SCHEMA: public
// =============================================================================

Table public.event_publication [headercolor: #9E9E9E] {
  id               uuid [pk]
  listener_id      text [not null]
  event_type       text [not null]
  serialized_event text [not null]
  publication_date timestamptz [not null]
  completion_date  timestamptz
}

// =============================================================================
// RELATIONSHIPS
// =============================================================================

Ref: product.attribute_values.attribute_id > product.attributes.id [delete: restrict]
Ref: product.categories.parent_id > product.categories.id [delete: restrict]
Ref: product.category_attributes.attribute_id > product.attributes.id [delete: restrict]
Ref: product.category_attributes.category_id > product.categories.id [delete: cascade]
Ref: product.customization_templates.variant_id > product.variants.id [delete: cascade]
Ref: product.media.published_by > identity.app_user.id
Ref: product.media.variant_id > product.variants.id [delete: cascade]
Ref: product.print_areas.template_id > product.customization_templates.id [delete: cascade]
Ref: product.product_attribute_options.attribute_value_id > product.attribute_values.id [delete: restrict]
Ref: product.product_attribute_options.product_attribute_id > product.product_attributes.id [delete: cascade]
Ref: product.product_attributes.attribute_id > product.attributes.id [delete: restrict]
Ref: product.product_attributes.product_id > product.products.id [delete: cascade]
Ref: product.product_categories.category_id > product.categories.id [delete: restrict]
Ref: product.product_categories.product_id > product.products.id [delete: cascade]
Ref: product.product_descriptive_values.attribute_value_id > product.attribute_values.id [delete: restrict]
Ref: product.product_descriptive_values.product_attribute_id > product.product_attributes.id [delete: cascade]
Ref: product.products.approved_by > identity.app_user.id
Ref: product.products.brand_id > product.brands.id [delete: set null]
Ref: product.products.submitted_by > identity.app_user.id
Ref: product.variant_attribute_values.product_attribute_option_id > product.product_attribute_options.id [delete: restrict]
Ref: product.variant_attribute_values.variant_id > product.variants.id [delete: cascade]
Ref: product.variants.product_id > product.products.id [delete: restrict]
Ref: inventory.cycle_count.assigned_user_id > identity.app_user.id
Ref: inventory.cycle_count.warehouse_id > warehouse.warehouse.id [delete: restrict]
Ref: inventory.cycle_count_line.counted_by > identity.app_user.id
Ref: inventory.cycle_count_line.cycle_count_id > inventory.cycle_count.id [delete: cascade]
Ref: inventory.cycle_count_line.location_code > warehouse.storage_location.location_code [delete: restrict]
Ref: inventory.cycle_count_line.sku > inventory.inventory_items.sku [delete: restrict]
Ref: inventory.inventory_items.default_supplier_id > procurement.suppliers.id [delete: set null]
Ref: inventory.inventory_items.sku > product.variants.sku [delete: restrict]
Ref: inventory.stock_adjustment.cycle_count_line_id > inventory.cycle_count_line.id [delete: restrict]
Ref: inventory.stock_adjustment.decided_by > identity.app_user.id
Ref: inventory.stock_adjustment.location_code > warehouse.storage_location.location_code [delete: restrict]
Ref: inventory.stock_adjustment.requested_by > identity.app_user.id
Ref: inventory.stock_adjustment.sku > inventory.inventory_items.sku [delete: restrict]
Ref: inventory.stock_item.location_code > warehouse.storage_location.location_code [delete: restrict]
Ref: inventory.stock_item.sku > inventory.inventory_items.sku [delete: restrict]
Ref: inventory.stock_movement.actor_id > identity.app_user.id
Ref: inventory.stock_movement.from_location_code > warehouse.storage_location.location_code [delete: restrict]
Ref: inventory.stock_movement.sku > inventory.inventory_items.sku [delete: restrict]
Ref: inventory.stock_movement.to_location_code > warehouse.storage_location.location_code [delete: restrict]
Ref: inventory.stock_reservation.order_id > ordering.customer_order.id [delete: restrict]
Ref: inventory.stock_reservation.stock_item_id > inventory.stock_item.id [delete: cascade]
Ref: inventory.transfer_order.approved_by > identity.app_user.id
Ref: inventory.transfer_order.dispatched_by > identity.app_user.id
Ref: inventory.transfer_order.from_warehouse_id > warehouse.warehouse.id [delete: restrict]
Ref: inventory.transfer_order.submitted_by > identity.app_user.id
Ref: inventory.transfer_order.to_warehouse_id > warehouse.warehouse.id [delete: restrict]
Ref: inventory.transfer_order_line.received_by > identity.app_user.id
Ref: inventory.transfer_order_line.sku > inventory.inventory_items.sku [delete: restrict]
Ref: inventory.transfer_order_line.transfer_order_id > inventory.transfer_order.id [delete: cascade]
Ref: warehouse.area.location_id > warehouse.storage_location.id [delete: restrict]
Ref: warehouse.area.warehouse_id > warehouse.warehouse.id
Ref: warehouse.bin.level_id > warehouse.shelf_level.id
Ref: warehouse.bin.location_id > warehouse.storage_location.id [delete: restrict]
Ref: warehouse.boundary.warehouse_id > warehouse.warehouse.id
Ref: warehouse.move_task.approved_by > identity.app_user.id

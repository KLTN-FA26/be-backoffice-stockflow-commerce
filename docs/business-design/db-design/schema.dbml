  indexes {
    (quote_line_id, min_quantity) [pk]
  }
}

Table ordering.quote_status_history [headercolor: #C0392B] {
  id          uuid [pk]
  quote_id    uuid [not null]
  revision    int [not null]
  from_status varchar(20)
  to_status   varchar(20) [not null]
  reason      varchar(2000)
  offer       jsonb
  changed_at  timestamptz [not null]
  changed_by  uuid
}

Table ordering.return_number_sequence [headercolor: #C0392B] {
  sequence_date date [pk]
  last_value    bigint [not null, default: 0]
}

Table ordering.return_request [headercolor: #C0392B] {
  id                            uuid [pk]
  rma_number                    varchar(30) [not null, unique]
  order_id                      uuid [not null]
  customer_id                   uuid [not null]
  status                        ordering.return_request_status [not null]
  reason_code                   ordering.return_request_reason_code [not null]
  note                          varchar(2000)

ign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="95" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Duyệt trong hạn mức&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /refunds/{id}/approve&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; refund.approved_by&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ kiểm hạn mức duyệt&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Vượt hạn mức thì KHÔNG hoàn được — BR-PAY-003&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="327" width="292" height="107" as="geometry"/></mxCell><mxCell id="c11" value="Trong hạn mức&lt;br&gt;hoàn tiền?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="105" y="480" width="200" height="74" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Gọi API hoàn tiền của cổng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động sau khi duyệt&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; payment_transaction&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ payload gọi API hoàn tiền&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="580" width="292" height="95" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Cập nhật trạng thái thanh toán&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; payment.status&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → PARTIALLY_REFUNDED | REFUNDED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; PARTIALLY_REFUNDED nếu hoàn một phần&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="721" width="292" height="107" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Import file đối soát của cổng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /payments/reconciliation/import&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; settlement_line&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ import file đối soát của cổng&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="875" width="292" height="95" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;06 &amp;nbsp;·&amp;nbsp; Khớp từng dòng hoặc gắn cờ lệch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /payments/reconciliation/match&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; reconciliation_match&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ khớp hoặc gắn cờ lệch&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; So ba nguồn: payment của mình, settlement của cổng, remittance COD của hãng VC&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="1016" width="292" height="120" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;07 &amp;nbsp;·&amp;nbsp; Cập nhật read model doanh thu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: RefundCompleted&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; revenue_report&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ read model doanh thu&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="1182" width="292" height="95" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; Chuyển lên cấp cao hơn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /refunds/{id}/escalate&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; refund  vẫn REQUESTED&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; refund_escalation&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ Không hoàn được cho tới khi có duyệt&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; BR-PAY-003&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FDF0EE;strokeColor=#A03426;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="462" width="292" height="120" as="geometry"/></mxCell><mxCell id="c18" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="event  RefundCompleted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="vượt hạn mức" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#A03426;strokeWidth=2;fontSize=10;fontColor=#A03426;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="!  Vượt hạn mức người duyệt thì KHÔNG hoàn được, phải chuyển lên cấp trên — BR-PAY-003." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#A03426;" vertex="1" parent="1"><mxGeometry x="40" y="1327" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c27" value="·  Đối soát so ba nguồn: payment của mình, settlement của cổng, và remittance của hãng VC cho COD." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1351" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c9c628d08d61" name="X-SHORT Nhặt thiếu — đơn không hỏng, đơn"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1264" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="X-SHORT — Nhặt thiếu — đơn không hỏng, đơn dừng lại" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.7.5  ·  Tình huống xảy ra hằng ngày ở kho thật. Điều quan trọng là đơn KHÔNG tự huỷ và tồn KHÔNG tự trừ." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="fulfillment-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="944" as="geometry"/></mxCell><mxCell id="c5" value="order-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="944" as="geometry"/></mxCell><mxCell id="c7" value="inventory-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="314" height="944" as="geometry"/></mxCell><mxCell id="c9" value="NHÁNH RẼ · NGOẠI LỆ" style="rounded=0;html=1;fillColor=#F7E3E0;strokeColor=#E5C9C4;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#A03426;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=0;html=1;fillColor=#FDF6F5;strokeColor=#EBD5D1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1030" y="162" width="314" height="944" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Nhân viên báo không đủ hàng để nhặt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /fulfillment/pick-lines/{id}/short&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; pick_line.status = SHORT, .short_qty&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ + outbox_event&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Dòng → SHORT. KHÔNG dòng stock_movement nào được ghi&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="132" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Đơn chuyển sang tạm giữ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: PickShortReported&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; order.status&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; order_hold&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → ON_HOLD(INVENTORY_ISSUE)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; reason = INVENTORY_ISSUE. Đơn KHÔNG tự huỷ&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="364" width="292" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Tự sinh phiếu kiểm kê cho vị trí đó&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; cycle_count (tự sinh)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ kiểm lại vị trí bị thiếu&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Chênh lệch giữa allocated và thực tế luôn kèm một cycle_count&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="530" width="292" height="132" as="geometry"/></mxCell><mxCell id="c14" value="Vị trí khác&lt;br&gt;còn hàng?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="765" y="709" width="200" height="74" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Điều phối chọn cách xử lý&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /fulfillment/allocation/{orderId}/reallocate&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; stock_allocation (nếu tái phân bổ)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ chọn vị trí khác&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Ba lựa chọn: phân bổ lại từ vị trí khác, tách đơn, hoặc huỷ dòng&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="809" width="292" height="120" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Gỡ tạm giữ, chạy lại luồng nhặt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /orders/{id}/release-hold&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; order.status&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; order_status_history&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → CONFIRMED, chạy lại luồng nhặt&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="975" width="292" height="107" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; Tách đơn hoặc huỷ dòng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /orders/{id}/split&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; order  đơn con&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; order_line → CANCELLED&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ Điều phối quyết định, không tự động&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Khách phải được báo trước khi huỷ dòng&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FDF0EE;strokeColor=#A03426;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1049" y="691" width="292" height="120" as="geometry"/></mxCell><mxCell id="c18" value="event  PickShortReported" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#F7F6F3;endArrow=b
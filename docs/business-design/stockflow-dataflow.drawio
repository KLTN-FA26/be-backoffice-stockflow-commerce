ontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1427" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c27" value="·  PO chỉ chuyển sang CLOSED khi hoá đơn đã được duyệt chi." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1451" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c9e2eab092c0" name="F-DSG Thiết kế 2D, xem 3D, chốt snapsh"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1460" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="F-DSG — Thiết kế 2D, xem 3D, chốt snapshot" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.12  ·  Điểm khác biệt của cả nền tảng. Snapshot đã chốt là bất biến — sửa thiết kế nghĩa là tạo snapshot mới." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="design-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="1164" as="geometry"/></mxCell><mxCell id="c5" value="MinIO" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="1164" as="geometry"/></mxCell><mxCell id="c7" value="NHÁNH RẼ · NGOẠI LỆ" style="rounded=0;html=1;fillColor=#F7E3E0;strokeColor=#E5C9C4;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#A03426;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#FDF6F5;strokeColor=#EBD5D1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="314" height="1164" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Khách mở studio thiết kế&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/design/drafts&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; design_draft&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ status = DRAFT, canvas JSON&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; SKU phải có cấu hình in&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="107" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Upload ảnh, thêm chữ và hình khối&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /design/drafts/{id}/assets&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; design-assets/{id}/*&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ ảnh khách upload&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="339" width="292" height="95" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Chạy preflight trước khi chốt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /design/drafts/{id}/preflight&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; design_draft.preflight_result&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ PASS | FAIL + danh sách lỗi&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Sai DPI, tràn vùng an toàn, font chưa nhúng → FAIL, khách phải sửa — BR-DSG-001&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="480" width="292" height="120" as="geometry"/></mxCell><mxCell id="c12" value="Preflight&lt;br&gt;đạt?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="105" y="646" width="200" height="74" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Khách chốt thiết kế&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /design/drafts/{id}/confirm&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; design_snapshot&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ status = CONFIRMED, checksum SHA-256&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Chỉ chốt được khi preflight PASS&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="746" width="292" height="107" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Lưu artifact bất biến + checksum&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;ghi MinIO&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; design-snapshots/{id}.json&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ artifact BẤT BIẾN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Snapshot đã chốt KHÔNG BAO GIỜ sửa — BR-DSG-002&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="900" width="292" height="120" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;06 &amp;nbsp;·&amp;nbsp; Phát tin thiết kế đã sẵn sàng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;outbox: DesignConfirmed&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ DesignConfirmed&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="1066" width="292" height="95" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;07 &amp;nbsp;·&amp;nbsp; Khoá snapshot khi đơn được đặt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động khi OrderPlaced&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; design_snapshot.status&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → LOCKED khi đơn được đặt&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="1207" width="292" height="95" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; Trả về cho khách sửa&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;hiển thị danh sách lỗi&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; design_draft.preflight_result = FAIL&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ Quay lại bước 02, KHÔNG tạo snapshot&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Sai DPI, tràn vùng an toàn, font chưa nhúng — BR-DSG-001&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FDF0EE;strokeColor=#A03426;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="628" width="292" height="120" as="geometry"/></mxCell><mxCell id="c18" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="PASS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="event  OrderPlaced" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="FAIL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#A03426;strokeWidth=2;fontSize=10;fontColor=#A03426;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="·  Preflight kiểm: DPI ảnh, vùng an toàn, bleed, chế độ màu RGB/CMYK, font đã nhúng — BR-DSG-001." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1352" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c27" value="*  Checksum SHA-256 của snapshot được chép sang order_line và so lại lúc đóng gói — BR-DSG-003." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#8A5209;" vertex="1" parent="1"><mxGeometry x="40" y="1376" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="8d4777adc477" name="F-CAT Đồng bộ catalog và số tồn hiển t"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1114" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="F-CAT — Đồng bộ catalog và số tồn hiển thị" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.13  ·  Hai nguồn dữ liệu chảy vào cùng một bản sao đọc: thông tin sản phẩm từ product, con số ATP từ inventory." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="catalog-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="794" as="geometry"/></mxCell><mxCell id="c5" value="Elasticsearch" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="794" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Nhận sản phẩm mới publish&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: ProductPublished&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; processed_event&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; catalog_product&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ từ ProductPublished&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="107" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Dựng bản sao đọc: giá, ảnh, SEO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;ghi sf_catalog&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; catalog_price&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; catalog_media&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; seo_metadata&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Chỉ chứa sản phẩm ĐÃ publish, không phải toàn bộ product master&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="339" width="292" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Đánh index Elasticsearch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;PUT /catalog/_doc/{sku}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; document&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ đánh index tìm kiếm&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="505" width="292" height="95" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Cập nhật số tồn hiển thị&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: StockLevelChanged&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; atp_cache&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ từ StockLevelChanged&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Bản sao có thể trễ vài giây — KHÔNG dùng để quyết định giữ chỗ&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="646" width="292" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Trả trang danh sách và chi tiết&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;GET /api/v1/catalog/products&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;&lt;b&gt;·&lt;/b&gt; → trả PLP/PDP cho khách&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ dải tồn, không phải số chính xác&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Khách chỉ thấy DẢI tồn, không thấy con số chính xác — OQ-10&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="812" width="292" height="120" as="geometry"/></mxCell><mxCell id="c12" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="event  StockLevelChanged" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="·  Khách chỉ thấy DẢI tồn (còn hàng / sắp hết / hết), không thấy con số chính xác — OQ-10." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="982" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c17" value="·  Con số ATP chính xác chỉ trả về ở giỏ hàng, và lúc checkout thì gọi thẳng inventory-service." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1006" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c18" value="!  catalog-service KHÔNG được dùng để quyết định giữ chỗ — bản sao có thể trễ vài giây." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#A03426;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="7ef99c6ccd8c" name="F-CART Giỏ hàng, checkout và giữ chỗ tồ"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1634" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="F-CART — Giỏ hàng, checkout và giữ chỗ tồn" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.14  ·  Chỗ duy nhất trong luồng bán hàng gọi đồng bộ — vì khách đang đứng chờ trước màn hình." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="order-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="1314" as="geometry"/></mxCell><mxCell id="c5" value="Redis" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="1314" as="geometry"/></mxCell><mxCell id="c7" value="inventory-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="314" height="1314" as="geometry"/></mxCell><mxCell id="c9" value="NHÁNH RẼ · NGOẠI LỆ" style="rounded=0;html=1;fillColor=#F7E3E0;strokeColor=#E5C9C4;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#A03426;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=0;html=1;fillColor=#FDF6F5;strokeColor=#EBD5D1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1030" y="162" width="314" height="1314" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Khách thêm sản phẩm vào giỏ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/cart/items&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; cart_item&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ sku, qty, design_snapshot_id nếu là hàng in&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Hàng in phải kèm design_snapshot_id đã CONFIRMED&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Cache giỏ hàng theo phiên&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;ghi Redis&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; cart:{sessionId}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ cache, TTL 30 ngày&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; TTL 30 ngày, gộp giỏ khách vãng lai khi đăng nhập&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="352" width="292" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Tính lại tổng tiền, thuế, phí ship&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/cart/price&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;&lt;b&gt;·&lt;/b&gt; → catalog: lấy giá hiện hành&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ tính tổng, thuế, phí ship&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Lấy giá hiện hành từ catalog-service&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="518" width="292" height="120" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Kiểm hiệu lực voucher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/cart/voucher&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; cart.voucher_code&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ kiểm hiệu lực voucher&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Kiểm lại LẦN NỮA lúc tạo đơn — BR-ORD-006&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="684" width="292" height="107" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Giữ chỗ tồn cho từng dòng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/inventory/reservations&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_reservation&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; stock_item.reserved&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ status = HELD · StockReserved&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; ATP &amp;lt; số lượng → 409, checkout DỪNG, chưa có đơn nào tồn tại — BR-STK-001&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="837" width="292" height="145" as="geometry"/></mxCell><mxCell id="c16" value="ATP đủ cho&lt;br&gt;MỌI dòng?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="765" y="1028" width="200" height="74" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;06 &amp;nbsp;·&amp;nbsp; Tạo đơn hàng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/checkout/place-order&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; order&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; order_line × N&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; order_status_history&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → PENDING_PAYMENT&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Chỉ tạo sau khi MỌI dòng đã giữ chỗ xong — BR-ORD-001&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="1128" width="292" height="145" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;07 &amp;nbsp;·&amp;nbsp; Dọn giỏ và phát tin đơn đã đặt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;outbox: OrderPlaced&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;−&lt;/b&gt; cart_item&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ dọn giỏ · OrderPlaced&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; order_line CHÉP tên SP, giá, địa chỉ tại thời điểm này&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="1319" width="292" height="132" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; Checkout dừng, trả 409&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;HTTP 409 INSUFFICIENT_STOCK&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;−&lt;/b&gt; stock_reservation  rollback các dòng đã giữ&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ CHƯA có đơn hàng nào tồn tại&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Đơn giữ chỗ một phần không bao giờ được lưu — BR-ORD-001&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FDF0EE;strokeColor=#A03426;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1049" y="1010" width="292" height="120" as="geometry"/></mxCell><mxCell id="c20" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="đủ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="không đủ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#A03426;strokeWidth=2;fontSize=10;fontColor=#A03426;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="*  Đơn chỉ được tạo sau khi MỌI dòng đã giữ chỗ xong. Đơn giữ chỗ một phần không bao giờ được lưu — BR-ORD-001." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#8A5209;" vertex="1" parent="1"><mxGeometry x="40" y="1502" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c29" value="*  order_line CHÉP tên sản phẩm, đơn giá và địa chỉ tại thời điểm này. Giá đổi ngày mai không đổi hoá đơn hôm nay." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#8A5209;" vertex="1" parent="1"><mxGeometry x="40" y="1526" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c30" value="·  Reservation có expires_at: 15 phút cho thẻ/ví, 24 giờ cho chuyển khoản, 30 phút cho COD — OQ-03." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1550" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="b34368cd59ac" name="F-PAY Thanh toán — bốn hình thức, bốn "><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1695" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="F-PAY — Thanh toán — bốn hình thức, bốn thời điểm ghi nhận" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.15  ·  Cùng một máy trạng thái, nhưng thời điểm chuyển sang CAPTURED khác nhau hoàn toàn. Nhầm chỗ này là sổ sách lệch." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="payment-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="1351" as="geometry"/></mxCell><mxCell id="c5" value="order-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="1351" as="geometry"/></mxCell><mxCell id="c7" value="NHÁNH RẼ · NGOẠI LỆ" style="rounded=0;html=1;fillColor=#F7E3E0;strokeColor=#E5C9C4;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#A03426;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#FDF6F5;strokeColor=#EBD5D1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="314" height="1351" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Khởi tạo giao dịch thanh toán&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: OrderPlaced&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; processed_event&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; payment&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ status = INITIATED&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="107" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Cổng thanh toán uỷ quyền&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;redirect / gọi API cổng&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; payment.status&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → AUTHORIZED (thẻ/ví)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Thẻ và ví: AUTHORIZED ngay&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="339" width="292" height="107" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Nhận callback từ cổng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/webhooks/payments/{gateway}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; payment_transaction&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ payload thô của cổng, để đối soát&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Sai chữ ký thì KHÔNG đổi trạng thái gì, chỉ ghi log — BR-PAY-001&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="493" width="292" height="120" as="geometry"/></mxCell><mxCell id="c12" value="Chữ ký webhook&lt;br&gt;hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="105" y="659" width="200" height="74" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Ghi nhận đã thu tiền&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động sau callback hợp lệ&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; payment.status&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → CAPTURED · PaymentCaptured&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; COD chỉ CAPTURED khi hãng VC chuyển tiền về — BR-PAY-004&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="759" width="292" height="132" as="geometry"/></mxCell><mxCell id="c14" value="Cổng báo&lt;br&gt;kết quả gì?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="105" y="937" width="200" height="74" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Xác nhận đơn hàng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: PaymentCaptured&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; processed_event&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; order&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; order_status_history&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → CONFIRMED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Đặt cọc: CONFIRMED khi đã thu ≥ mức cọc, không phải bằng tổng đơn — BR-PAY-002&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="1037" width="292" height="145" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;06 &amp;nbsp;·&amp;nbsp; Đối chiếu tiền COD với hãng vận chuyển&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/payments/cod/reconcile&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; cod_remittance (nếu COD)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ đối chiếu với hãng vận chuyển&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="1228" width="292" height="107" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;07 &amp;nbsp;·&amp;nbsp; Theo dõi số dư còn phải trả (đặt cọc)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;GET /payments/deposits/{orderId}/balance&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; deposit_record (nếu đặt cọc)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ theo dõi số dư còn phải trả&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="1382" width="292" height="107" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; Từ chối và ghi log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;HTTP 401&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; security_audit_log&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ KHÔNG đổi trạng thái thanh toán&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Đây là cửa duy nhất người ngoài chạm vào được — BR-PAY-001&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FDF0EE;strokeColor=#A03426;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="641" width="292" height="120" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; Giải phóng giữ chỗ, đơn thất bại&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;outbox: PaymentFailed&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; payment → FAILED&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event  PaymentFailed&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ inventory nhả giữ chỗ, đơn → PAYMENT_FAILED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Giỏ hàng được giữ lại để khách thử lại&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FDF0EE;strokeColor=#A03426;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="919" width="292" height="120" as="geometry"/></mxCell><mxCell id="c20" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="hợp lệ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="CAPTURED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="sai chữ ký" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#A03426;strokeWidth=2;fontSize=10;fontColor=#A03426;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="FAILED · EXPIRED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#A03426;strokeWidth=2;fontSize=10;fontColor=#A03426;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c14" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="·  Thẻ / ví: CAPTURED ngay khi cổng callback. Chuyển khoản: khi kế toán đối chiếu sao kê." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1539" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c31" value="!  COD: CHỈ CAPTURED khi hãng vận chuyển chuyển tiền về — BR-PAY-004. Coi COD là đã trả lúc checkout là sổ sách sai." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#A03426;" vertex="1" parent="1"><mxGeometry x="40" y="1563" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c32" value="·  Đặt cọc: đơn → CONFIRMED khi tổng đã thu ≥ mức cọc yêu cầu, không phải bằng tổng đơn — BR-PAY-002." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1587" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c33" value="!  Webhook sai chữ ký thì KHÔNG đổi trạng thái gì, chỉ ghi log — BR-PAY-001." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#A03426;" vertex="1" parent="1"><mxGeometry x="40" y="1611" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="002825cbb278" name="F-FUL Phát lệnh, nhặt hàng, đóng gói"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1709" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="F-FUL — Phát lệnh, nhặt hàng, đóng gói" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.7 · 3.8  ·  Reservation mềm chuyển thành allocation cứng, rồi mới trừ kho thật. Ba mức, không gộp được." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="order-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="1389" as="geometry"/></mxCell><mxCell id="c5" value="inventory-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="1389" as="geometry"/></mxCell><mxCell id="c7" value="fulfillment-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="314" height="1389" as="geometry"/></mxCell><mxCell id="c9" value="NHÁNH RẼ · NGOẠI LỆ" style="rounded=0;html=1;fillColor=#F7E3E0;strokeColor=#E5C9C4;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#A03426;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=0;html=1;fillColor=#FDF6F5;strokeColor=#EBD5D1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1030" y="162" width="314" height="1389" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Điều phối phát lệnh xuống kho&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/orders/{id}/release&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; order.warehouse_code&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → READY_TO_FULFILL · OrderReleased&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Kho được chọn phải đủ hàng cho MỌI dòng — BR-ORD-002&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="132" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Chuyển giữ chỗ thành phân bổ cứng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: OrderReleased&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_allocation&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; stock_reservation&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; stock_item.allocated&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ HELD → ALLOCATED, chọn FEFO&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Chọn vị trí và lô theo FEFO — BR-STK-006&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="364" width="292" height="132" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Sinh phiếu nhặt và tuyến đi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: OrderReleased&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; pick_list&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; pick_line × N&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ location_code, lot_number từ allocation&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="543" width="292" height="107" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Nhân viên quét và nhặt hàng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /fulfillment/pick-lines/{id}/confirm&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; pick_line.picked_qty&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ PickCompleted&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Nhặt thiếu → dòng SHORT, đơn ON_HOLD, xem X-SHORT&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="696" width="292" height="132" as="geometry"/></mxCell><mxCell id="c15" value="Nhặt đủ&lt;br&gt;số lượng?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="765" y="875" width="200" height="74" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Trừ tồn kho thật&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: PickCompleted&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; stock_item.on_hand −, .allocated −&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_movement&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ StockDeducted&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; ĐÂY mới là lúc on_hand giảm, không phải lúc đặt hàng&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="975" width="292" height="132" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;06 &amp;nbsp;·&amp;nbsp; So checksum thiết kế trước khi đóng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /packing/{orderId}/design-check&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; design_verification&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ so checksum với artifact trong MinIO&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Lệch checksum thì DỪNG đóng gói — BR-DSG-003&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="1153" width="292" height="120" as="geometry"/></mxCell><mxCell id="c18" value="Checksum thiết kế&lt;br&gt;khớp?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="765" y="1319" width="200" height="74" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;07 &amp;nbsp;·&amp;nbsp; Hoàn tất đóng gói&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /packing/{orderId}/complete&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; package&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → PACKED · OrderPacked&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="1419" width="292" height="107" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; Dòng SHORT, đơn tạm giữ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /pick-lines/{id}/short&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; pick_line → SHORT&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; order_hold  INVENTORY_ISSUE&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; cycle_count  tự sinh&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ Xem tiếp luồng X-SHORT&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; KHÔNG dòng stock_movement nào được ghi&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FDF0EE;strokeColor=#A03426;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1049" y="857" width="292" height="132" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; Dừng đóng gói&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;đơn → ON_HOLD&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; design_verification  MISMATCH&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; order_hold  DESIGN_MISMATCH&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ Xem tiếp luồng X-CHK&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Kiện sắp chứa thứ KHÁC thứ khách đã duyệt — BR-DSG-003&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FDF0EE;strokeColor=#A03426;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1049" y="1301" width="292" height="132" as="geometry"/></mxCell><mxCell id="c22" value="event  OrderReleased" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="event  OrderReleased" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="đủ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="khớp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="thiếu hàng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#A03426;strokeWidth=2;fontSize=10;fontColor=#A03426;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c15" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="lệch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#A03426;strokeWidth=2;fontSize=10;fontColor=#A03426;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c18" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="·  Bước phân bổ chọn vị trí và lô cụ thể theo FEFO — BR-STK-006. Trước đó reservation không gắn vị trí nào." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1577" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c33" value="*  Tồn kho THẬT SỰ giảm ở bước PickCompleted, không phải lúc đặt hàng." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#8A5209;" vertex="1" parent="1"><mxGeometry x="40" y="1601" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c34" value="!  Lệch checksum thiết kế lúc đóng gói thì DỪNG, không đóng — BR-DSG-003." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#A03426;" vertex="1" parent="1"><mxGeometry x="40" y="1625" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="1311212ff907" name="F-SHP Giao hàng và theo dõi tới lúc có"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1497" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="F-SHP — Giao hàng và theo dõi tới lúc có POD" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.9  ·  Mỗi hãng vận chuyển đặt tên trạng thái một kiểu. Phải chuẩn hoá về máy trạng thái của mình trước khi cho phần còn lại của hệ thống nhìn thấy." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="fulfillment-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="1201" as="geometry"/></mxCell><mxCell id="c5" value="MinIO" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="1201" as="geometry"/></mxCell><mxCell id="c7" value="NHÁNH RẼ · NGOẠI LỆ" style="rounded=0;html=1;fillColor=#F7E3E0;strokeColor=#E5C9C4;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#A03426;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#FDF6F5;strokeColor=#EBD5D1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="314" height="1201" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Tạo lô giao hàng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/shipping/shipments&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; shipment&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ status = CREATED&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="95" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Xin nhãn và mã vận đơn từ hãng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /shipping/shipments/{id}/label&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; shipment.tracking_number, .awb&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → LABELLED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Địa chỉ phải qua bước validate trước&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="327" width="292" height="107" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Lưu file nhãn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;ghi MinIO&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; labels/{awb}.pdf&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ file nhãn&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="480" width="292" height="95" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Gom manifest và bàn giao cho hãng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /shipping/manifests/{id}/handover&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; manifest_entry&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; manifest&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → MANIFESTED → HANDED_OVER&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Hãng ký nhận thì đơn mới sang SHIPPED&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="621" width="292" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Nhận webhook trạng thái từ hãng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/webhooks/carriers/{carrier}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; tracking_event (mỗi lần webhook)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ nhật ký thô&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="787" width="292" height="95" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;06 &amp;nbsp;·&amp;nbsp; Chuẩn hoá trạng thái về máy của mình&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động sau webhook&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; shipment.tracking_status&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ đã chuẩn hoá&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Mỗi hãng đặt tên khác nhau, phần còn lại của hệ thống không được thấy từ vựng của hãng&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="928" width="292" height="132" as="geometry"/></mxCell><mxCell id="c15" value="Giao&lt;br&gt;thành công?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="105" y="1107" width="200" height="74" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;07 &amp;nbsp;·&amp;nbsp; Ghi nhận POD, ảnh và chữ ký&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động khi giao thành công&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; pod&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ ảnh và chữ ký · OrderDelivered&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Sau 7 ngày không có RMA thì đơn tự COMPLETED — BR-ORD-005&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="1207" width="292" height="132" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; Chuyển sang hoàn về (RTO)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;webhook báo RTO&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; shipment → RTO_IN_TRANSIT&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event  OrderReturnedToOrigin&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ Xem tiếp luồng F-RTO&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Đơn → RTO là trạng thái kết thúc&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FDF0EE;strokeColor=#A03426;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="1089" width="292" height="120" as="geometry"/></mxCell><mxCell id="c18" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="DELIVERED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="thất bại N lần" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#A03426;strokeWidth=2;fontSize=10;fontColor=#A03426;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="·  Trạng thái thô của hãng lưu vào tracking_event; shipment chỉ giữ trạng thái ĐÃ CHUẨN HOÁ — WBS 3.9.5.2." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1389" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c27" value="·  Sau DELIVERED 7 ngày không có RMA thì đơn tự động → COMPLETED — BR-ORD-005." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1413" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d7667cd3dac5" name="F-TRF Điều chuyển giữa hai kho"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1455" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="F-TRF — Điều chuyển giữa hai kho" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.10  ·  Sáu bước, một database. Ngắn nhất nhưng dễ làm hỏng số liệu tồn kho nhất, vì có lúc hàng không thuộc kho nào." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="inventory-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="1135" as="geometry"/></mxCell><mxCell id="c5" value="NHÁNH RẼ · NGOẠI LỆ" style="rounded=0;html=1;fillColor=#F7E3E0;strokeColor=#E5C9C4;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#A03426;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#FDF6F5;strokeColor=#EBD5D1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="1135" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Lập lệnh điều chuyển&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/transfers&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; transfer_order&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; transfer_line × N&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ status = DRAFT&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Kho nguồn phải khác kho đích&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Duyệt theo ngưỡng giá trị&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /transfers/{id}/approve&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; transfer_order&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; transfer_approval&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → APPROVED, theo ngưỡng giá trị&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Giá trị lớn cần duyệt nhiều cấp — BR-TRF-001&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="352" width="292" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Giữ chỗ tại kho nguồn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /transfers/{id}/pick&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_reservation tại kho nguồn&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ chọn theo FEFO&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Chọn lô theo FEFO&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="518" width="292" height="107" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Xuất kho nguồn, hàng vào trạng thái trung chuyển&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /transfers/{id}/issue&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; stock_item(nguồn).on_hand −&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; in_transit_stock&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_movement&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → IN_TRANSIT&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Hàng KHÔNG thuộc kho nào — để lại kho nguồn thì bán vượt, cộng sớm vào kho đích thì bán hàng trên xe tải&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="671" width="292" height="170" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Nhận tại kho đích và đếm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /transfers/{id}/receive&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;−&lt;/b&gt; in_transit_stock&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_item(đích)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_movement&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → COMPLETED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; on_hand(nguồn) + in_transit + on_hand(đích) = hằng số — BR-TRF-002&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="887" width="292" height="145" as="geometry"/></mxCell><mxCell id="c12" value="Số nhận có&lt;br&gt;khớp số xuất?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="105" y="1078" width="200" height="74" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;06 &amp;nbsp;·&amp;nbsp; Xử lý chênh lệch và duyệt hao hụt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /transfers/{id}/resolve-discrepancy&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_adjustment (nếu lệch)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ cần duyệt hao hụt&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="1178" width="292" height="95" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; Điều tra và duyệt hao hụt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /transfers/{id}/resolve-discrepancy&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; transfer_discrepancy&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_adjustment  chờ duyệt&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ Quản lý kho duyệt xong mới COMPLETED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; on_hand(nguồn) + in_transit + on_hand(đích) phải luôn bằng nhau — BR-TRF-002&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FDF0EE;strokeColor=#A03426;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="1060" width="292" height="132" as="geometry"/></mxCell><mxCell id="c15" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="khớp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="lệch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#A03426;strokeWidth=2;fontSize=10;fontColor=#A03426;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="*  Bất biến phải đúng ở MỌI thời điểm: on_hand(nguồn) + in_transit + on_hand(đích) = hằng số — BR-TRF-002." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#8A5209;" vertex="1" parent="1"><mxGeometry x="40" y="1323" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c23" value="!  Để hàng lại ở on_hand kho nguồn → kho nguồn bán vượt. Cộng sớm vào kho đích → bán hàng đang trên xe tải." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#A03426;" vertex="1" parent="1"><mxGeometry x="40" y="1347" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c24" value="·  Nên viết hẳn một integration test khẳng định bất biến trên, thay vì phát hiện lúc kiểm kê cuối năm." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1371" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="da15647a599f" name="F-REP Bổ sung nội bộ kho — từ khu dự t"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1103" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="F-REP — Bổ sung nội bộ kho — từ khu dự trữ ra khu nhặt" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.11  ·  Chạy tự động theo ngưỡng. Nếu không có luồng này thì khu nhặt hàng cạn và picker phải đi tận khu dự trữ." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="warehouse-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="807" as="geometry"/></mxCell><mxCell id="c5" value="inventory-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="807" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Job quét ngưỡng vị trí nhặt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;cron mỗi 15 phút&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;&lt;b&gt;·&lt;/b&gt; đọc replenishment_rule&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ ngưỡng min/max mỗi vị trí nhặt&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Đọc ngưỡng min/max cấu hình cho từng vị trí nhặt&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Sinh việc bổ sung&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động khi dưới ngưỡng&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; replenishment_task&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ status = CREATED, chọn vị trí nguồn&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Chọn vị trí nguồn ở khu dự trữ&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="352" width="292" height="107" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Ưu tiên theo mức cạn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; replenishment_task.priority&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ theo mức cạn&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Vị trí cạn nhất được làm trước&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="505" width="292" height="107" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Nhân viên thực hiện chuyển hàng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /replenishment/tasks/{id}/execute&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; replenishment_task&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → COMPLETED&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="659" width="292" height="107" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Cập nhật vị trí tồn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: ReplenishmentCompleted&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; stock_item.location_code&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_movement&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ chuyển vị trí trong cùng kho&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Cùng một kho nên KHÔNG qua trạng thái trung chuyển&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="812" width="292" height="132" as="geometry"/></mxCell><mxCell id="c12" value="job nền" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#7B808A;strokeWidth=2;fontSize=10;fontColor=#7B808A;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="job nền" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#7B808A;strokeWidth=2;fontSize=10;fontColor=#7B808A;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="event  ReplenishmentCompleted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="·  Nguồn lấy từ khu dự trữ, đích là vị trí nhặt hàng. Cùng một kho nên KHÔNG qua in_transit." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="995" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c17" value="·  Task được ưu tiên theo mức cạn của vị trí nhặt — WBS 3.11.4." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1019" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4116bc572f5f" name="F-CNT Kiểm kê và điều chỉnh tồn"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1344" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="F-CNT — Kiểm kê và điều chỉnh tồn" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.6.6  ·  Chỗ duy nhất trong hệ thống mà một con số có thể ghi đè tồn kho. Vì vậy nó bắt buộc phải qua duyệt." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="inventory-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="1048" as="geometry"/></mxCell><mxCell id="c5" value="NHÁNH RẼ · NGOẠI LỆ" style="rounded=0;html=1;fillColor=#F7E3E0;strokeColor=#E5C9C4;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#A03426;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#FDF6F5;strokeColor=#EBD5D1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="1048" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Lập kế hoạch kiểm kê&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/inventory/cycle-counts&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; cycle_count&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; cycle_count_line × N&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ status = PLANNED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Chọn vị trí hoặc nhóm SKU cần đếm&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Bắt đầu đếm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /cycle-counts/{id}/start&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; cycle_count.status&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → COUNTING&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="352" width="292" height="95" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Nhân viên quét vị trí và đếm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;PUT /inventory/cycle-count-lines/{id}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; cycle_count_line.counted_qty&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ đếm bằng mobile, quét vị trí&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Đếm mù: không hiện số hệ thống cho người đếm&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="493" width="292" height="107" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Tính chênh lệch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;GET /cycle-counts/{id}/variance&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; count_variance&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ so counted vs on_hand&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; So counted_qty với on_hand&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="646" width="292" height="107" as="geometry"/></mxCell><mxCell id="c11" value="Có chênh&lt;br&gt;lệch không?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="105" y="800" width="200" height="74" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Tạo phiếu điều chỉnh chờ duyệt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động khi có lệch&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_adjustment&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → VARIANCE_REVIEW, chờ duyệt&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Lệch = 0 thì post thẳng, không cần duyệt&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="900" width="292" height="107" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;06 &amp;nbsp;·&amp;nbsp; Duyệt và ghi vào tồn kho&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /cycle-counts/{id}/approve&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; stock_item.on_hand&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_movement&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → POSTED sau khi duyệt&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Mọi chênh lệch đều cần duyệt quản lý kho — BR-STK-005&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="1053" width="292" height="132" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; Post thẳng, không cần duyệt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; cycle_count → POSTED&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ Không tạo phiếu điều chỉnh&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FDF0EE;strokeColor=#A03426;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="782" width="292" height="95" as="geometry"/></mxCell><mxCell id="c15" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="có lệch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="lệch = 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#A03426;strokeWidth=2;fontSize=10;fontColor=#A03426;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="*  Mọi chênh lệch đều cần duyệt của quản lý kho trước khi chạm vào tồn — BR-STK-005." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#8A5209;" vertex="1" parent="1"><mxGeometry x="40" y="1236" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c23" value="·  Điều chỉnh vượt ngưỡng giá trị cấu hình thì cần cấp duyệt cao hơn." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="b5f1330bfa43" name="F-EXP Quét hết hạn hằng đêm"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1065" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="F-EXP — Quét hết hạn hằng đêm" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.6.7  ·  Job chạy 1 lần mỗi đêm. Không có nó thì hàng quá hạn vẫn nằm trong ATP và vẫn bán được." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="inventory-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="769" as="geometry"/></mxCell><mxCell id="c5" value="catalog-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="769" as="geometry"/></mxCell><mxCell id="c7" value="notification-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="314" height="769" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Job quét hàng quá hạn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;cron 02:00 hằng đêm&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;&lt;b&gt;·&lt;/b&gt; quét stock_item WHERE expiry_date &amp;lt; today&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ điều kiện BR-STK-004&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Điều kiện: expiry_date &amp;lt; hôm nay — BR-STK-004&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="107" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Chuyển sang trạng thái hết hạn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; stock_item.condition = EXPIRED&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ rơi khỏi ATP&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Rơi khỏi ATP NGAY, không chờ ai duyệt&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="339" width="292" height="107" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Ghi bút toán và phát tin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;outbox: StockBlocked&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_movement&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ StockBlocked(EXPIRED)&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="493" width="292" height="107" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Cập nhật số tồn hiển thị&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: StockBlocked&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; atp_cache&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ số hiển thị giảm&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="646" width="292" height="95" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Báo quản lý kho danh sách lô hết hạn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: StockBlocked&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; notification&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ báo quản lý kho danh sách lô hết hạn&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Hàng SẮP hết hạn chỉ cảnh báo, chưa chặn bán&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="787" width="292" height="120" as="geometry"/></mxCell><mxCell id="c14" value="job nền" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#7B808A;strokeWidth=2;fontSize=10;fontColor=#7B808A;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="job nền" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#7B808A;strokeWidth=2;fontSize=10;fontColor=#7B808A;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="event  StockBlocked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="event  StockBlocked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="·  expiry_date &lt; hôm nay → condition = EXPIRED, rơi khỏi ATP ngay lập tức — BR-STK-004." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="957" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c19" value="·  Hàng sắp hết hạn (trong N ngày) thì chỉ cảnh báo, chưa chặn bán." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="981" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cc9b4a12595b" name="F-RMA Trả hàng và đổi hàng"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="1838" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="F-RMA — Trả hàng và đổi hàng" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.17.5  ·  Hàng trả về LUÔN vào trạng thái cách ly, không bao giờ thẳng vào GOOD. Bán lại được hay không là quyết định của QC." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="order-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="1542" as="geometry"/></mxCell><mxCell id="c5" value="fulfillment-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="1542" as="geometry"/></mxCell><mxCell id="c7" value="procurement-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="314" height="1542" as="geometry"/></mxCell><mxCell id="c9" value="inventory-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1030" y="162" width="314" height="1542" as="geometry"/></mxCell><mxCell id="c11" value="payment-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1360" y="162" width="314" height="1542" as="geometry"/></mxCell><mxCell id="c13" value="NHÁNH RẼ · NGOẠI LỆ" style="rounded=0;html=1;fillColor=#F7E3E0;strokeColor=#E5C9C4;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#A03426;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1690" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=0;html=1;fillColor=#FDF6F5;strokeColor=#EBD5D1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1690" y="162" width="314" height="1542" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Khách mở yêu cầu trả hàng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/rma&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; rma&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; rma_line × N&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; order.status&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → REQUESTED · RETURN_REQUESTED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Chỉ mở được trong thời hạn đổi trả sau khi đã giao — BR-RMA-001&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="145" as="geometry"/></mxCell><mxCell id="c16" value="Trong chính sách&lt;br&gt;đổi trả?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="105" y="377" width="200" height="74" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Kinh doanh duyệt hoặc từ chối&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /rma/{id}/approve&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; rma.approved_by&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → APPROVED, kiểm BR-RMA-002&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Hàng in theo yêu cầu KHÔNG được trả trừ khi lỗi — BR-RMA-002&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="477" width="292" height="120" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Sinh nhãn gửi hàng chiều về&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /rma/{id}/return-label&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; return_shipment, MinIO + labels/return-*.pdf&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ nhãn chiều về&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="643" width="292" height="95" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Kho nhận kiện trả về&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /rma/{id}/receive&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; return_receipt&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; qc_task&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ đối chiếu số RMA trên kiện&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Đối chiếu số RMA ghi trên kiện&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="784" width="292" height="120" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Nhập tồn ở trạng thái cách ly&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: RmaGoodsReceived&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_item condition = QUARANTINE&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_movement&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ KHÔNG BAO GIỜ là GOOD&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; KHÔNG BAO GIỜ vào thẳng GOOD — bán lại được hay không là quyết định của QC&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1049" y="950" width="292" height="132" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;06 &amp;nbsp;·&amp;nbsp; QC kiểm hàng trả&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /rma/{id}/inspect&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; qc_result&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ ACCEPTED → GOOD · REJECTED → DAMAGED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; ACCEPTED → GOOD · REJECTED → DAMAGED&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="1128" width="292" height="107" as="geometry"/></mxCell><mxCell id="c22" value="Hàng trả&lt;br&gt;còn dùng được?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="765" y="1282" width="200" height="74" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;07 &amp;nbsp;·&amp;nbsp; Kế toán duyệt hoàn tiền&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /refunds/{id}/approve&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; refund&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; payment.status&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → REFUNDED · RefundCompleted&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Vượt hạn mức thì phải chuyển lên cấp trên — BR-PAY-003&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1379" y="1382" width="292" height="145" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;08 &amp;nbsp;·&amp;nbsp; Đóng RMA và cập nhật đơn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: RefundCompleted&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; rma&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; order.status&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → RETURNED&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="1573" width="292" height="107" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; Từ chối yêu cầu trả hàng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /rma/{id}/reject&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; rma → REJECTED&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; order  quay lại DELIVERED&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ Luồng KẾT THÚC&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Hàng in theo yêu cầu không được trả trừ khi lỗi — BR-RMA-002&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FDF0EE;strokeColor=#A03426;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1709" y="359" width="292" height="132" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; Chuyển sang hàng hỏng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;qc_result = REJECTED&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; stock_item.condition → DAMAGED&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ Chờ quyết định huỷ bỏ&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Hàng in bị lỗi vào thẳng DAMAGED, không có gì để kiểm lại&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FDF0EE;strokeColor=#A03426;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1709" y="1264" width="292" height="120" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" sour
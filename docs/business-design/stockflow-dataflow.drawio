<mxfile host="app.diagrams.net" modified="2026-09-07T00:00:00.000Z" agent="StockFlowCommerce" version="24.0.0" type="device"><diagram id="3ba688ba1c65" name="00 · Cách đọc"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="830" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Cách đọc — bản đồ luồng dữ liệu StockFlowCommerce" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="FA26SE029 · 25 luồng, mỗi luồng một trang. Cột = service sở hữu dữ liệu. Hộp = một bước. Đọc từ trên xuống theo số thứ tự." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Giữ chỗ tồn cho từng dòng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/inventory/reservations&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; stock_reservation&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; stock_item.reserved&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ status = HELD · StockReserved&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; ATP &amp;lt; số lượng → 409, checkout DỪNG — BR-STK-001&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="292" height="150" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="358" y="150" width="8" height="8" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="402" y="150" width="8" height="8" as="geometry"/></mxCell><mxCell id="c6" value="" style="endArrow=none;html=1;strokeColor=#C9C5BB;strokeWidth=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="Số thứ tự bước và việc đang làm — đọc dòng này là biết bước này để làm gì" style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="412" y="142" width="780" height="24" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="358" y="176" width="8" height="8" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="402" y="176" width="8" height="8" as="geometry"/></mxCell><mxCell id="c10" value="" style="endArrow=none;html=1;strokeColor=#C9C5BB;strokeWidth=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="API hoặc trigger: người dùng gọi endpoint nào, hoặc nghe event nào" style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="412" y="168" width="780" height="24" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="358" y="214" width="8" height="8" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="402" y="214" width="8" height="8" as="geometry"/></mxCell><mxCell id="c14" value="" style="endArrow=none;html=1;strokeColor=#C9C5BB;strokeWidth=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="Ghi vào đâu.  + tạo dòng mới  ·  ~ sửa dòng đã có  ·  − trừ đi hoặc xoá" style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="412" y="206" width="780" height="24" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="358" y="270" width="8" height="8" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="402" y="270" width="8" height="8" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=none;html=1;strokeColor=#C9C5BB;strokeWidth=1;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="Kết quả: trạng thái mới, và event phát ra nếu có" style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="412" y="262" width="780" height="24" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="358" y="294" width="8" height="8" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="402" y="294" width="8" height="8" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=none;html=1;strokeColor=#C9C5BB;strokeWidth=1;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Dấu ! là điều kiện chặn — không thoả thì bước này không chạy, kèm mã business rule" style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="412" y="286" width="780" height="24" as="geometry"/></mxCell><mxCell id="c24" value="Mũi tên nối hai bước cho biết bước sau được kích hoạt bằng cách nào" style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="700" height="24" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="416" width="120" height="30" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="330" y="416" width="8" height="30" as="geometry"/></mxCell><mxCell id="c27" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="Có người bấm nút. Bước này bắt đầu từ giao diện." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="900" height="26" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="468" width="120" height="30" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="330" y="468" width="8" height="30" as="geometry"/></mxCell><mxCell id="c31" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="Service gọi service, và CHỜ kết quả. Trong luồng bán hàng chỉ có đúng một lần." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="400" y="472" width="900" height="26" as="geometry"/></mxCell><mxCell id="c33" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="120" height="30" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="330" y="520" width="8" height="30" as="geometry"/></mxCell><mxCell id="c35" value="event  OrderPlaced" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="Bất đồng bộ qua Kafka, đi qua transactional outbox. Xem trang 02." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="400" y="524" width="900" height="26" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="572" width="120" height="30" as="geometry"/></mxCell><mxCell id="c38" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="330" y="572" width="8" height="30" as="geometry"/></mxCell><mxCell id="c39" value="job nền" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#7B808A;strokeWidth=2;fontSize=10;fontColor=#7B808A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="Cron chạy theo lịch, không ai bấm gì cả." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="400" y="576" width="900" height="26" as="geometry"/></mxCell><mxCell id="c41" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="624" width="120" height="30" as="geometry"/></mxCell><mxCell id="c42" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="330" y="624" width="8" height="30" as="geometry"/></mxCell><mxCell id="c43" value="nhánh hỏng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#A03426;strokeWidth=2;fontSize=10;fontColor=#A03426;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c41" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="Thanh toán thất bại, QC không đạt, nhặt thiếu — luồng rẽ sang hướng bù trừ." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="400" y="628" width="900" height="26" as="geometry"/></mxCell><mxCell id="c45" value="Cột (làn) = service SỞ HỮU dữ liệu của bước đó" style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1400" height="26" as="geometry"/></mxCell><mxCell id="c46" value="Một bước nằm ở làn nào nghĩa là bảng bị ghi thuộc database của service đó. Mũi tên đi ngang giữa hai làn nghĩa là dữ liệu vượt qua ranh giới service — và mọi lần vượt ranh giới đều phải qua REST hoặc event, không bao giờ qua JOIN.&lt;br&gt;&lt;br&gt;Làn MinIO, Redis, Elasticsearch, Kafka là kho phụ trợ, không phải nguồn sự thật." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="1400" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="8607b2facbff" name="01 · Bản đồ tổng 14 service"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Bản đồ tổng — 14 service, 14 database" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="Ba làn nghiệp vụ. Bên ngoài chỉ vào được qua API Gateway. Các service nói chuyện với nhau qua Kafka." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Web · Mobile" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;dashed=1;dashPattern=6 4;fillColor=#F5F5F5;strokeColor=#5B6169;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="150" height="46" as="geometry"/></mxCell><mxCell id="c4" value="API Gateway" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;" vertex
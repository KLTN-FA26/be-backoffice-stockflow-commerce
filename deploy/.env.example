# =============================================================================
# Environment for the dev server (deploy/docker-compose.yml).
#
# On the VPS:   cp .env.example .env && chmod 600 .env   then fill in every CHANGE_ME.
# CI never touches .env (rsync excludes it); it lives only on the server.
# After a release, compare the server's .env with this file:   scripts/check-env.sh
# Every variable docker-compose.yml reads is listed here, set or commented out (optional).
#
# Generate secrets with:   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# Avoid $ and quotes in values: compose interpolates $ and keeps quotes literally.
# =============================================================================

# ---- where and what ---------------------------------------------------------
# The zone in Cloudflare. Sites are served at api., jaeger. and logs. under it.
DOMAIN=example.com
# GHCR image, ALWAYS lowercase (registry rule) even though the GitHub org is KLTN-FA26.
APP_IMAGE=ghcr.io/kltn-fa26/be-backoffice-stockflow-commerce

# IMAGE_TAG (the running image) is appended here by scripts/deploy.sh on the first deploy and
# kept up to date by it. Leave it alone: compose reads it, so it is what a plain
# `docker compose up -d` runs. Until the first deploy, check this file with
#   IMAGE_TAG=check docker compose config --quiet && echo CONFIG OK

# ---- PostgreSQL ---------------------------------------------------------------
DB_NAME=stockflow
DB_USER=stockflow
DB_PASSWORD=CHANGE_ME
# Postgres allows 40 connections and has 768 MB; 10 is plenty for a team-sized load.
DB_POOL_MAX=10

# ---- Redis --------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# ---- object storage: AWS S3 (README, "Object storage on AWS S3") -----------------------------
# No MinIO on this server since 2026-11-18. The bucket, and the keys of the IAM user holding only infra/aws's
# ApplicationMediaPolicyArn (never root keys). Compose refuses any of these four missing. AWS_REGION is the
# bucket's own region: a wrong one fails every call and every presigned link with a redirect.
S3_BUCKET=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
AWS_REGION=ap-southeast-2
# The CloudFront origin that serves product-images/ (output ProductMediaBaseUrl of infra/aws/media-cloudfront.yaml),
# e.g. https://dxxxxxxxxxxxx.cloudfront.net - host only, no path. Blank: private files and uploads still work,
# the public product gallery answers 503.
PRODUCT_MEDIA_CDN_BASE_URL=
# Only after infra/aws/configure-existing-bucket.sh enabled Object Lock on the bucket:
# S3_OBJECT_LOCK_ENABLED=true
# Only for an S3-compatible service other than AWS; unset (empty / false) means AWS itself.
# S3_ENDPOINT=https://s3.example.com
# S3_PATH_STYLE=true
# Upload scanning needs the ClamAV container (~1.2 GB, not on the 4 GB machine): both lines together.
# The first starts it (docker-compose.yml, service clamav); the second points the application at it.
# COMPOSE_PROFILES=scan
# UPLOAD_INSPECTION_ENABLED=true
# Optional: the scanner's host when it is not the clamav service above.
# UPLOAD_INSPECTION_HOST=clamav

# ---- application --------------------------------------------------------------
# No JWT key setting here: docker-compose.yml points JWT_PRIVATE_KEY_PATH at ./jwt, which scripts/deploy.sh
# prepares and the application fills on its first start (README, "The JWT signing key").
# Demo data (db/demo). OFF for now: it seeds the NEW product/procurement tables, which the code
# does not read yet (old and new tables coexist until each module moves), so the frontend would
# see none of it. Switching it on or off later requires resetting the database (README, "Reset the
# database"), because Flyway refuses migrations that appear out of order. Demo data includes no
# usable login either way: create accounts with scripts/create-user.sh.
FLYWAY_LOCATIONS=classpath:db/migration
# FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo
# Lets the storefront check out without an account. The request carries its own unit price and
# nothing checks it yet, so leave this false unless the frontend team is testing that flow.
GUEST_CHECKOUT_ENABLED=false

# Browser origins allowed to call the API, comma-separated. localhost:* lets the frontend team run
# their dev server against this backend; add the host a deployed frontend is served from.
# Each entry needs its scheme and no trailing slash; a bare '*' is refused at startup.
# The STOMP socket (/ws, sales chat) accepts the same origins, so list both deployed frontends - the back office
# and the storefront - next to localhost, e.g.:
# CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,https://backoffice.example.com,https://shop.example.com
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,https://*.example.com
# Optional. Regex over the peer address of connections allowed to set the client IP through
# X-Forwarded-For (what the login rate limit keys on). Unset = private ranges, which is the compose
# network nginx reaches the application over. Narrow it (e.g. to nginx's fixed IP) only if you pin the
# network's subnet; an empty value trusts nobody and every client then shares nginx's address.
# TRUSTED_PROXIES=
# com.stockflow log level. The dev profile also logs SQL statements (not their parameters).
LOG_LEVEL=DEBUG
# Fraction of requests traced into Jaeger. 1.0 = every request.
TRACE_SAMPLING=1.0
# Bump on a release whose cached types changed shape (see .env.example at the repository root).
CACHE_VERSION=v1
# THE PURGE JOB DELETES PERMANENTLY - confirm against the signed retention policy.
AUDIT_ROUTINE_RETENTION=P180D
AUDIT_SECURITY_RETENTION=P730D

# ---- secrets the application holds --------------------------------------------------------------
# Shared with the frontend's server (BFF): requests carrying it may set the login rate-limit identity.
BFF_ORIGIN_SECRET=CHANGE_ME_openssl_rand_hex_32
# Optional: seals carriers' API keys and webhook secrets, and the e-invoice provider's account password, in the
# database (openssl rand -base64 32). Blank: they cannot be saved until it is set. Back it up with the database.
STOCKFLOW_SECRETS_KEY=

# Contract e-signing. REQUIRED: CONTRACT_SIGNING_SECRET, at least 32 characters - generate it once with
#   openssl rand -base64 48
# It seals the generated signing key in the database and hashes customers' one-time codes; Compose and the application
# (every profile but local and test) refuse to start without it. Keep it with the database backups: changing it makes the
# stored key unreadable and ends the codes in flight. Optional: the company signs contracts with a TEST certificate nobody
# vouches for - either a PKCS#12 you supply, base64 on one line (base64 -w0 company.p12), with its password, or none and
# an RSA 3072 key is generated at the first signing. CONTRACT_VERIFICATION_BASE_URL is the storefront's origin the QR
# code on the certificate page points at.
CONTRACT_SIGNING_KEYSTORE=
CONTRACT_SIGNING_KEYSTORE_PASSWORD=
CONTRACT_SIGNING_SECRET=
CONTRACT_VERIFICATION_BASE_URL=

# Links a producer opens without signing in (4A-3: its production order slip and print files, mailed when a
# production order is approved). The HMAC key the links are signed with, base64 of at least 32 bytes - use exactly
# `openssl rand -base64 32` (NOT the shortened secret recipe at the top). Required while STOCKFLOW_PUBLIC_BASE_URL
# below is unset or set: blank, the application (not compose) refuses to start, so set it before deploying a
# release with 4A-3. Changing it breaks every link already mailed; staff re-send them from the production order.
STOCKFLOW_LINKS_KEY=
# Optional: where the API is reached from outside; every link starts with it. Unset = https://api.<DOMAIN>.
# Set it present and EMPTY to mail no links (the mail then says the coordinator sends the files).
# STOCKFLOW_PUBLIC_BASE_URL=https://api.example.com

# Optional: the output intent stamped into approved print files. Unset = the ICC profile bundled in the image,
# ISO Coated v2 (ECI), FOGRA39 - the one the storefront embeds; nothing to install. Only for a printer's own profile:
# a path inside the container (mount the file in docker-compose.yml) and its registered condition, both together.
# DESIGN_PRINT_ICC_PROFILE=/var/lib/stockflow/icc/printer.icc
# DESIGN_PRINT_OUTPUT_CONDITION=FOGRA51
# DESIGN_PRINT_OUTPUT_INFO=PSO Coated v3

# ---- e-mail -------------------------------------------------------------------------------------
# Every message goes out through Resend and reaches a real inbox: there is no SMTP server (Mailpit) on this
# machine since 2026-11-18. Both are required - without either the application refuses to start. The key needs
# only "Sending access"; the sender is an address on a domain verified in Resend, e.g.
# "StockFlow <no-reply@example.com>".
RESEND_API_KEY=CHANGE_ME
RESEND_FROM=CHANGE_ME
# Optional: where a customer's reply goes (e.g. Sales' shared mailbox). Blank: customer mail says not to reply.
RESEND_REPLY_TO=
# Optional: the signing secret of the Resend webhook ("whsec_..."), for delivery reports on customer mail.
# Endpoint to register: https://<api-domain>/api/v1/notifications/webhooks/resend. Blank: that endpoint answers 503.
# Subscribing to every event is fine: those the application does not track are acknowledged and ignored.
RESEND_WEBHOOK_SECRET=
# false: no customer order mail at all (each recorded as skipped); staff and producer mail and the portal
# invitation unchanged. Never true on a server holding copies of real customers that must not hear from it, nor
# with made-up customer addresses: every bounce counts against the sending domain at Resend.
CUSTOMER_EMAIL_ENABLED=false

# ---- customers, payments, invoices ---------------------------------------------------------------
# Required: public frontend URL where customers redeem Sales invitations.
# Set the real HTTPS URL (for example, https://your-domain/portal/activate) on the VPS.
# Leave blank in this template so docker compose fails until it is configured.
PORTAL_ACTIVATION_URL=

# Bank transfer instructions (SCRUM-193): the company account customers are told to transfer to, shown by
# GET /api/v1/orders/me/{orderId}/transfer-instructions. Set all three; while any is blank that endpoint answers
# 503 TRANSFER_INSTRUCTIONS_UNAVAILABLE (nothing else fails). The account holder as the bank prints it.
COMPANY_BANK_NAME=
COMPANY_BANK_ACCOUNT_NUMBER=
COMPANY_BANK_ACCOUNT_NAME=
# The bank's six-digit NAPAS BIN: the chat's transfer card draws a VietQR code with it (none without it).
COMPANY_BANK_BIN=

# Bank feed, SePay (credit plan 2026-11-26 part C; docs/bank-feed-sepay.md): incoming transfers recorded from the
# bank. Off unless true. The webhook on my.sepay.vn points at https://<this server>/api/v1/bank-transactions/webhooks/sepay
# and authenticates with HMAC-SHA256 (its secret key here) or an API key. The account defaults to COMPANY_BANK_ACCOUNT_NUMBER.
# The API token is for the nightly catch-up; one made in SePay's Test mode needs the sandbox base URL.
BANK_FEED_ENABLED=false
BANK_FEED_WEBHOOK_HMAC_SECRET=
BANK_FEED_WEBHOOK_API_KEY=
BANK_FEED_ACCOUNT_NUMBER=
BANK_FEED_API_TOKEN=
BANK_FEED_API_BASE_URL=https://userapi.sepay.vn/v2

# The seller named on sales contracts and e-invoices (4B-4, WF-05 E1): exactly as on the business registration.
# Blank on a dev-profile server: a made-up demo company is used, so real documents must not be issued from it.
# Required in the prod profile: the application refuses to start until all five are set.
SELLER_NAME=
SELLER_TAX_CODE=
SELLER_ADDRESS=
SELLER_REPRESENTATIVE=
SELLER_REPRESENTATIVE_TITLE=
# The seller's letterhead on quotations and contracts (optional; a blank one is left off the paper, and on a
# dev-profile server falls back to the demo company's). The bank account follows COMPANY_BANK_* unless set here.
# SELLER_LOGO is a PNG as a Spring resource location, e.g. file:/opt/stockflow/logo.png (mount it into the container).
SELLER_PHONE=
SELLER_EMAIL=
SELLER_WEBSITE=
SELLER_BANK_ACCOUNT_NUMBER=
SELLER_BANK_NAME=
SELLER_BANK_BRANCH=
SELLER_CITY=
SELLER_LOGO=

# E-invoices (WF-05). Whether an issued invoice is e-mailed to the buyer's invoice address (PDF + XML + lookup
# code). Off: the invoice is still listed on the customer portal and the buyer gets an in-app notice.
EINVOICE_EMAIL_ENABLED=true
# Object Lock retention mode for e-invoice files (10-year legal retention). GOVERNANCE lets an admin with the
# bypass right remove a file; COMPLIANCE lets nobody, not even root, until the period ends. Effective only when
# S3_OBJECT_LOCK_ENABLED=true and the bucket has Object Lock (see the AWS block above).
S3_OBJECT_LOCK_EINVOICE_MODE=COMPLIANCE
# SePay eInvoice (optional; the built-in sandbox issues until it is switched on). From SePay's portal, the page
# "API xuat hoa don dien tu": the client id and secret of the SANDBOX environment for testing (simulated invoices,
# nothing reaches the tax authority) or of PRODUCTION for real ones - a key works only in its own environment.
# Then switch the provider: POST /api/v1/einvoice-settings/providers/SEPAY_EINVOICE/activation. Never commit them.
# The portal shows them as "Ten dang nhap" (the client id, EINV-TEST-... on the Sandbox tab) and "Mat khau" (the
# client secret): SePay's POST /v1/token takes them as the Basic authentication's user name and password.
EINVOICE_SEPAY_ENVIRONMENT=SANDBOX
EINVOICE_SEPAY_CLIENT_ID=
EINVOICE_SEPAY_CLIENT_SECRET=
# Optional: which invoicing registration issues (GET /v1/provider-accounts). Blank: the first active one.
EINVOICE_SEPAY_PROVIDER_ACCOUNT_ID=

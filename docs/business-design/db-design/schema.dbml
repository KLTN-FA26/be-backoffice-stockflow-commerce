// =============================================================================
// SCHEMA: payment
// =============================================================================

Table payment.installment [headercolor: #B8860B] {
  id                      uuid [pk]
  contract_id             uuid [not null]
  contract_installment_id uuid [unique]
  order_id                uuid [not null]
  customer_id             uuid [not null]
  contract_number         varchar(40) [not null]
  order_number            varchar(32) [not null]
  seq                     smallint [not null]
  name                    varchar(100) [not null]
  milestone               payment.installment_milestone [not null]
  delivery_batch_id       uuid
  delivery_batch_seq      smallint
  amount                  decimal(19,4) [not null]
  paid_amount             decimal(19,4) [not null, default: 0]
  currency                varchar(3) [not null]
  due_days                int
  reached_at              timestamptz
  due_date                date
  status                  payment.installment_status [not null]
  paid_at                 timestamptz
  cancelled_at            timestamptz
  version                 bigint [not null, default: 0]
  created_at              timestamptz [not null, default: `now()`]
  created_by              varchar(100)
  last_modified_at        timestamptz
  last_modified_by        varchar(100)
  reduced_amount          decimal(19,4) [not null, default: 0]
  indexes {
    (contract_id, seq) [unique]
  }
}

Table payment.installment_reduction [headercolor: #B8860B] {
  id             uuid [pk]
  settlement_id  uuid [not null]
  installment_id uuid [not null]
  amount         decimal(19,4) [not null]
  created_at     timestamptz [not null, default: `now()`]
  indexes {
    (settlement_id, installment_id) [unique]
  }
}

Table payment.order_settlement [headercolor: #B8860B] {
  id                 uuid [pk]
  order_id           uuid [not null]
  contract_id        uuid [not null]
  customer_id        uuid [not null]
  order_number       varchar(32) [not null]
  contract_number    varchar(40) [not null]
  kind               payment.order_settlement_kind [not null]
  source_id          uuid [not null]
  currency           varchar(3) [not null]
  collected_amount   decimal(19,4) [not null]
  closed_amount      decimal(19,4) [not null, default: 0]
  reduced_amount     decimal(19,4) [not null, default: 0]
  surplus_amount     decimal(19,4) [not null]
  fee_amount         decimal(19,4) [not null, default: 0]
  fee_percent        decimal(5,2)
  fee_reason         varchar(500)
  fee_detail         varchar(2000)
  fee_covered_amount decimal(19,4) [not null, default: 0]
  refundable_amount  decimal(19,4) [not null, default: 0]
  fee_owed_amount    decimal(19,4) [not null, default: 0]
  fee_installment_id uuid [unique]
  settled_by         uuid
  settled_at         timestamptz [not null]
  version            bigint [not null, default: 0]
  created_at         timestamptz [not null, default: `now()`]
  created_by         varchar(100)
  last_modified_at   timestamptz
  last_modified_by   varchar(100)
  indexes {
    (kind, source_id) [unique]
  }
}

Table payment.payment_receipt [headercolor: #B8860B] {
  id               uuid [pk]
  customer_id      uuid [not null]
  reference        varchar(100) [not null]
  received_on      date [not null]
  amount           decimal(19,4) [not null]
  currency         varchar(3) [not null]
  note             varchar(500)
  status           payment.payment_receipt_status [not null]
  recorded_by      uuid [not null]
  recorded_at      timestamptz [not null]
  voided_by        uuid
  voided_at        timestamptz
  void_reason      varchar(500)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table payment.payment_receipt_line [headercolor: #B8860B] {
  id             uuid [pk]
  receipt_id     uuid [not null]
  installment_id uuid [not null]
  amount         decimal(19,4) [not null]
  created_at     timestamptz [not null, default: `now()`]
  indexes {
    (receipt_id, installment_id) [unique]
  }
}

Table payment.refund_record [headercolor: #B8860B] {
  id               uuid [pk]
  order_id         uuid [not null]
  customer_id      uuid [not null]
  order_number     varchar(32) [not null]
  amount           decimal(19,4) [not null]
  currency         varchar(3) [not null]
  refunded_on      date [not null]
  reference        varchar(100) [not null]
  note             varchar(500)
  status           payment.refund_record_status [not null]
  recorded_by      uuid [not null]
  recorded_at      timestamptz [not null]
  voided_by        uuid
  voided_at        timestamptz
  void_reason      varchar(500)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

// =============================================================================
// SCHEMA: invoicing
// =============================================================================

Table invoicing.einvoice [headercolor: #A0522D] {
  id                   uuid [pk]
  code                 varchar(32) [not null, unique]
  type                 invoicing.einvoice_type [not null]
  status               invoicing.einvoice_status [not null]
  adjusted             boolean [not null, default: false]
  order_id             uuid [not null]
  order_number         varchar(32) [not null]
  contract_number      varchar(40)
  shipment_id          uuid
  shipment_code        varchar(48)
  delivery_batch_id    uuid
  customer_id          uuid [not null]
  original_einvoice_id uuid
  provider             varchar(32)
  attempt              int [not null, default: 0]
  transaction_id       varchar(64) [unique]
  template_code        varchar(1)
  symbol               varchar(6)
  invoice_number       int
  tax_authority_code   varchar(64)
  lookup_code          varchar(64)
  issue_date           date [not null]
  issue_due_at         timestamptz [not null]
  due_warned_at        timestamptz
  signed_at            timestamptz
  seller_name          varchar(200) [not null]
  seller_tax_code      varchar(14) [not null]
  seller_address       varchar(500) [not null]
  buyer_name           varchar(200) [not null]
  buyer_tax_code       varchar(14)
  buyer_address        varchar(500)
  buyer_email          varchar(320)
  currency             varchar(3) [not null]
  payment_method       varchar(16) [not null]
  subtotal             decimal(19,4) [not null]
  tax_total            decimal(19,4) [not null]
  grand_total          decimal(19,4) [not null]
  amount_in_words      varchar(500) [not null]
  warnings             varchar(200)
  adjustment_reason    varchar(500)
  agreement_file_key   varchar(500)
  xml_file_key         varchar(500)
  pdf_file_key         varchar(500)
  rejection_code       varchar(64)
  rejection_message    varchar(500)
  submitted_at         timestamptz
  submitted_by         uuid
  issued_at            timestamptz
  voided_at            timestamptz
  voided_by            uuid
  void_reason          varchar(500)
  version              bigint [not null, default: 0]
  created_at           timestamptz [not null, default: `now()`]
  created_by           varchar(100)
  last_modified_at     timestamptz
  last_modified_by     varchar(100)
  correction_basis     varchar(16)
  agreement_number     varchar(64)
  agreement_date       date
  return_request_id    uuid
}

Table invoicing.einvoice_adjustment_listing [headercolor: #A0522D] {
  einvoice_id        uuid [not null]
  listed_einvoice_id uuid [not null]
  indexes {
    (einvoice_id, listed_einvoice_id) [pk]
  }
}

Table invoicing.einvoice_error_notice [headercolor: #A0522D] {
  id                    uuid [pk]
  einvoice_id           uuid [not null]
  form_code             varchar(16) [not null, default: '04/SS-HDDT']
  reason                varchar(500) [not null]
  status                invoicing.einvoice_error_notice_status [not null, default: 'DRAFT']
  sent_at               timestamptz
  response_code         varchar(64)
  response_message      varchar(500)
  responded_at          timestamptz
  version               bigint [not null, default: 0]
  created_at            timestamptz [not null, default: `now()`]
  created_by            varchar(100)
  last_modified_at      timestamptz
  last_modified_by      varchar(100)
  subject               invoicing.einvoice_error_notice_subject [not null, default: 'BUYER_NAME_ADDRESS']
  correct_buyer_name    varchar(200)
  correct_buyer_address varchar(500)
  recorded_by           uuid
}

Table invoicing.einvoice_line [headercolor: #A0522D] {
  id               uuid [pk]
  einvoice_id      uuid [not null]
  line_no          int [not null]
  kind             invoicing.einvoice_line_kind [not null]
  fee_kind         varchar(16)
  order_line_id    uuid
  sku              varchar(64)
  item_name        varchar(500) [not null]
  unit             varchar(16) [not null]
  quantity         int [not null]
  units_per_carton int
  unit_price       decimal(19,4) [not null]
  tax_rate         decimal(5,2) [not null]
  amount           decimal(19,4) [not null]
  tax_amount       decimal(19,4) [not null]
  indexes {
    (einvoice_id, line_no) [unique]
  }
}

Table invoicing.einvoice_provider_call [headercolor: #A0522D] {
  id             uuid [pk]
  einvoice_id    uuid [not null]
  provider       varchar(32) [not null]
  transaction_id varchar(64) [not null]
  operation      invoicing.einvoice_provider_call_operation [not null]
  outcome        invoicing.einvoice_provider_call_outcome [not null]
  http_status    int
  error_code     varchar(64)
  request_hash   varchar(64)
  response_hash  varchar(64)
  called_at      timestamptz [not null]
  duration_ms    bigint [not null]
}

Table invoicing.einvoice_provider_config [headercolor: #A0522D] {
  id               uuid [pk]
  provider         invoicing.einvoice_provider_config_provider [not null, unique]
  environment      invoicing.einvoice_provider_config_environment [not null]
  endpoint         varchar(500)
  username         varchar(200)
  secret_sealed    varchar(2000)
  active           boolean [not null, default: false]
  auto_issue       boolean [not null, default: false]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table invoicing.einvoice_sending [headercolor: #A0522D] {
  einvoice_id    uuid [pk]
  transaction_id varchar(64)
  last_sent_at   timestamptz
  holder         uuid
  held_until     timestamptz
}

Table invoicing.einvoice_series [headercolor: #A0522D] {
  id                     uuid [pk]
  provider               varchar(32) [not null]
  template_code          varchar(1) [not null]
  symbol                 varchar(6) [not null]
  year                   smallint [not null]
  active                 boolean [not null, default: true]
  version                bigint [not null, default: 0]
  created_at             timestamptz [not null, default: `now()`]
  created_by             varchar(100)
  last_modified_at       timestamptz
  last_modified_by       varchar(100)
  provider_template_code varchar(20)
  indexes {
    (provider, template_code, symbol) [unique]
  }
}

Table invoicing.einvoice_stuck_notice [headercolor: #A0522D] {
  einvoice_id    uuid [not null]
  transaction_id varchar(64) [not null]
  notified_at    timestamptz [not null]
  indexes {
    (einvoice_id, transaction_id) [pk]
  }
}

Table invoicing.sandbox_issuance [headercolor: #A0522D] {
  transaction_id          varchar(64) [pk]
  state                   invoicing.sandbox_issuance_state [not null]
  template_code           varchar(1) [not null]
  symbol                  varchar(6) [not null]
  invoice_number          int
  tax_authority_code      varchar(64)
  lookup_code             varchar(64)
  rejection_code          varchar(64)
  rejection_message       varchar(500)
  xml_document            text
  pdf_document            bytea
  request_hash            varchar(64) [not null]
  received_at             timestamptz [not null]
  ready_at                timestamptz [not null]
  kind                    invoicing.sandbox_issuance_kind [not null, default: 'ORIGINAL']
  original_template_code  varchar(1)
  original_symbol         varchar(6)
  original_invoice_number int
  indexes {
    (template_code, symbol, invoice_number) [unique]
  }
}

Table invoicing.sandbox_number [headercolor: #A0522D] {
  template_code varchar(1) [not null]
  symbol        varchar(6) [not null]
  last_number   int [not null, default: 0]
  indexes {
    (template_code, symbol) [pk]
  }
}

// =============================================================================
// SCHEMA: design
// =============================================================================

Table design.design_artifact [headercolor: #AA4A9E] {
  id                uuid [pk]
  draft_id          uuid [not null]
  storage_key       varchar(500) [not null, unique]
  original_name     varchar(255) [not null]
  content_type      varchar(100) [not null]
  size_bytes        bigint [not null]
  stored_at         timestamptz [not null]
  checksum          varchar(64) [not null]
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
  upload_key        varchar(400)
  artifact_role     design.design_artifact_artifact_role [not null]
  document_checksum varchar(64)
  template_version  bigint
  indexes {
    (draft_id, id) [unique]
  }
}

Table design.design_asset [headercolor: #AA4A9E] {
  draft_id      uuid [not null]
  id            uuid [not null]
  storage_key   varchar(500) [not null]
  original_name varchar(255) [not null]
  content_type  varchar(100) [not null]
  size_bytes    bigint [not null]
  checksum      varchar(64) [not null]
  width_px      int [not null]
  height_px     int [not null]
  upload_key    varchar(300)
  created_at    timestamptz [not null]
  created_by    varchar(100)
  indexes {
    (draft_id, id) [pk]
  }
}

Table design.design_decision [headercolor: #AA4A9E] {
  id               uuid [pk]
  draft_id         uuid [not null]
  artifact_id      uuid
  actor_id         uuid [not null]
  decision         design.design_decision_decision [not null]
  notes            varchar(4000) [not null]
  draft_version    bigint [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table design.design_document [headercolor: #AA4A9E] {
  draft_id   uuid [pk]
  document   text [not null]
  checksum   varchar(64) [not null]
  updated_at timestamptz [not null]
}

Table design.design_draft [headercolor: #AA4A9E] {
  id                  uuid [pk]
  customer_id         uuid [not null]
  product_id          uuid [not null]
  name                varchar(200)
  spec                varchar(4000)
  status              design.design_draft_status [not null]
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null]
  created_by          varchar(100)
  last_modified_at    timestamptz
  last_modified_by    varchar(100)
  owner_user_id       uuid
  current_artifact_id uuid
  reviewed_by         uuid
  review_notes        varchar(2000)
  parent_snapshot_id  uuid
  current_artifacts   jsonb [not null]
  variant_id          uuid
  sku                 varchar(64)
  template_id         uuid
  template_code       varchar(50)
  review_requested_at timestamptz
  reviewed_at         timestamptz
  archived_at         timestamptz
  project_id          uuid
}

Table design.design_project [headercolor: #AA4A9E] {
  id               uuid [pk]
  customer_id      uuid [not null]
  owner_user_id    uuid [not null]
  name             varchar(200) [not null]
  description      varchar(2000)
  status           design.design_project_status [not null]
  archived_at      timestamptz
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (id, customer_id) [unique]
  }
}

Table design.design_project_asset [headercolor: #AA4A9E] {
  id               uuid [pk]
  project_id       uuid [not null]
  storage_key      varchar(500) [not null]
  original_name    varchar(255) [not null]
  content_type     varchar(100) [not null]
  size_bytes       bigint [not null]
  checksum         varchar(64) [not null]
  width_px         int [not null]
  height_px        int [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  upload_key       varchar(300)
}

Table design.design_project_event [headercolor: #AA4A9E] {
  id               uuid [pk]
  project_id       uuid [not null]
  actor_id         uuid [not null]
  event            design.design_project_event_event [not null]
  notes            varchar(4000) [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table design.design_project_quote_request [headercolor: #AA4A9E] {
  id                    uuid [pk]
  project_id            uuid [not null]
  requested_by          uuid [not null]
  desired_delivery_date date
  version               bigint [not null, default: 0]
  created_at            timestamptz [not null]
  created_by            varchar(100)
  last_modified_at      timestamptz
  last_modified_by      varchar(100)
}

Table design.design_project_quote_request_line [headercolor: #AA4A9E] {
  request_id uuid [not null]
  draft_id   uuid [not null]
  cartons    int [not null]
  indexes {
    (request_id, draft_id) [pk]
  }
}

Table design.design_project_text [headercolor: #AA4A9E] {
  id               uuid [pk]
  project_id       uuid [not null]
  text             varchar(500) [not null]
  style            jsonb [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table design.design_quote_request [headercolor: #AA4A9E] {
  id                    uuid [pk]
  draft_id              uuid [not null]
  requested_by          uuid [not null]
  cartons               int [not null]
  desired_delivery_date date
  status                design.design_quote_request_status [not null]
  closed_at             timestamptz
  closed_by             uuid
  version               bigint [not null, default: 0]
  created_at            timestamptz [not null]
  created_by            varchar(100)
  last_modified_at      timestamptz
  last_modified_by      varchar(100)
}

Table design.design_review_round [headercolor: #AA4A9E] {
  id               uuid [pk]
  project_id       uuid [not null]
  submitted_by     uuid [not null]
  submitted_at     timestamptz [not null]
  closed_at        timestamptz
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table design.design_review_round_design [headercolor: #AA4A9E] {
  round_id   uuid [not null]
  draft_id   uuid [not null]
  outcome    design.design_review_round_design_outcome
  decided_at timestamptz
  indexes {
    (round_id, draft_id) [pk]
  }
}

Table design.design_snapshot [headercolor: #AA4A9E] {
  id                uuid [pk]
  draft_id          uuid [not null]
  checksum          varchar(128) [not null]
  artifact_url      varchar(500) [not null]
  confirmed_at      timestamptz [not null]
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
  artifact_id       uuid
  confirmed_by      uuid
  spec              varchar(4000)
  reviewed_by       uuid
  review_notes      varchar(2000)
  artifact_manifest jsonb [not null]
  document          text
  document_checksum varchar(64)
  assets            jsonb
  template          jsonb
}

// =============================================================================
// SCHEMA: fulfillment
// =============================================================================

Table fulfillment.carrier [headercolor: #2C7873] {
  id                             uuid [pk]
  code                           varchar(32) [not null, unique]
  name                           varchar(120) [not null]
  contact_name                   varchar(120)
  contact_phone                  varchar(32)
  status                         fulfillment.carrier_status [not null, default: 'ACTIVE']
  version                        bigint [not null, default: 0]
  created_at                     timestamptz [not null, default: `now()`]
  created_by                     varchar(100)
  last_modified_at               timestamptz
  last_modified_by               varchar(100)
  connection_type                fulfillment.carrier_connection_type [not null, default: 'MANUAL']
  webhook_enabled                boolean [not null, default: false]
  webhook_secret_sealed          text
  webhook_auth_header            varchar(64)
  webhook_auth_value_sealed      text
  api_environment                fulfillment.carrier_api_environment
  api_account                    varchar(64)
  api_key_sealed                 text
  failure_reason_map             jsonb [not null, default: `'{}'::jsonb`]
  webhook_auth_value_next_sealed text
}

Table fulfillment.carrier_api_call [headercolor: #2C7873] {
  id               uuid [pk]
  carrier_id       uuid [not null]
  booking_id       uuid
  operation        fulfillment.carrier_api_call_operation [not null]
  outcome          fulfillment.carrier_api_call_outcome [not null]
  http_status      int
  request_body     text
  response_body    text
  error            varchar(1000)
  duration_ms      int [not null]
  called_at        timestamptz [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table fulfillment.carrier_booking [headercolor: #2C7873] {
  id               uuid [pk]
  load_id          uuid [not null]
  carrier_id       uuid [not null]
  service_code     varchar(64) [not null]
  stops            jsonb [not null]
  order_time       timestamptz
  status           fulfillment.carrier_booking_status [not null]
  carrier_order_id varchar(64)
  tracking_link    varchar(500)
  requested_by     uuid [not null]
  requested_at     timestamptz [not null]
  booked_at        timestamptz
  cancelled_at     timestamptz
  cancel_reason    varchar(500)
  cancel_attempts  int [not null, default: 0]
  last_error       varchar(1000)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table fulfillment.carrier_event [headercolor: #2C7873] {
  id                  uuid [pk]
  carrier_id          uuid
  carrier_code        varchar(64) [not null]
  received_at         timestamptz [not null]
  payload             text [not null]
  signature_valid     boolean [not null]
  event_kind          fulfillment.carrier_event_event_kind
  carrier_reference   varchar(128)
  carrier_reported_at timestamptz
  dedupe_key          varchar(64)
  warehouse_id        uuid
  load_id             uuid
  shipment_id         uuid
  result              fulfillment.carrier_event_result [not null]
  result_note         varchar(1000)
  decided_at          timestamptz
  resolved_by         uuid
  resolved_at         timestamptz
  resolution_note     varchar(1000)
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null, default: `now()`]
  created_by          varchar(100)
  last_modified_at    timestamptz
  last_modified_by    varchar(100)
  source              fulfillment.carrier_event_source [not null, default: 'WEBHOOK']
  outcome_import_id   uuid
  outcome_import_line int
}

Table fulfillment.carrier_pickup_point [headercolor: #2C7873] {
  id               uuid [pk]
  carrier_id       uuid [not null]
  warehouse_id     uuid [not null]
  province_code    varchar(20) [not null]
  address          varchar(500) [not null]
  contact_name     varchar(120)
  contact_phone    varchar(32)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (carrier_id, warehouse_id) [unique]
  }
}

Table fulfillment.carrier_service_code [headercolor: #2C7873] {
  id                uuid [pk]
  carrier_id        uuid [not null]
  vehicle_type_id   uuid [not null]
  province_code     varchar(20) [not null]
  carrier_city_code varchar(32) [not null]
  service_code      varchar(64) [not null]
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null, default: `now()`]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
  indexes {
    (carrier_id, vehicle_type_id, province_code) [unique]
  }
}

Table fulfillment.delivery_outcome_correction [headercolor: #2C7873] {
  id               uuid [pk]
  shipment_id      uuid [not null]
  from_status      varchar(24) [not null]
  to_status        varchar(24) [not null]
  failure_reason   varchar(32)
  failure_note     varchar(1000)
  reason           varchar(500) [not null]
  corrected_by     uuid [not null]
  corrected_at     timestamptz [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table fulfillment.delivery_outcome_import [headercolor: #2C7873] {
  id               uuid [pk]
  file_name        varchar(255) [not null]
  file_sha256      varchar(64) [not null]
  uploaded_by      uuid [not null]
  uploaded_at      timestamptz [not null]
  rows_total       int [not null]
  rows_accepted    int [not null]
  rows_rejected    int [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table fulfillment.delivery_outcome_import_row [headercolor: #2C7873] {
  id               uuid [pk]
  import_id        uuid [not null]
  line_no          int [not null]
  waybill_no       varchar(255)
  outcome          varchar(255)
  failure_reason   varchar(500)
  reported_at      varchar(255)
  recipient        varchar(255)
  note             varchar(500)
  shipment_code    varchar(255)
  carrier_code     varchar(255)
  load_id          uuid
  verdict          fulfillment.delivery_outcome_import_row_verdict [not null]
  problem          varchar(32)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (import_id, line_no) [unique]
  }
}

Table fulfillment.dispatch_load [headercolor: #2C7873] {
  id                     uuid [pk]
  code                   varchar(30) [not null, unique]
  request_id             uuid [not null, unique]
  warehouse_id           uuid [not null]
  carrier_id             uuid
  load_plan_vehicle_id   uuid
  vehicle_plate          varchar(20)
  driver_name            varchar(120)
  driver_phone           varchar(32)
  status                 fulfillment.dispatch_load_status [not null]
  booked_at              timestamptz
  booked_by              uuid
  loading_started_at     timestamptz
  loading_started_by     uuid
  dispatched_at          timestamptz
  dispatched_by          uuid
  carrier_representative varchar(120)
  signature_ref          varchar(255)
  handover_note          varchar(500)
  shipment_count         int [not null, default: 0]
  package_count          int [not null, default: 0]
  cancelled_at           timestamptz
  cancelled_by           uuid
  cancel_reason          varchar(500)
  version                bigint [not null, default: 0]
  created_at             timestamptz [not null, default: `now()`]
  created_by             varchar(100)
  last_modified_at       timestamptz
  last_modified_by       varchar(100)
  booking_cancelled_at   timestamptz
  booking_cancelled_by   uuid
  booking_cancel_reason  varchar(500)
  cancel_reason_code     varchar(20)
  waybill_no             varchar(64)
}

Table fulfillment.dispatch_load_package [headercolor: #2C7873] {
  id               uuid [pk]
  load_id          uuid [not null]
  package_id       uuid [not null]
  shipment_id      uuid [not null]
  scan_id          uuid [not null, unique]
  loaded_at        timestamptz [not null]
  loaded_by        uuid [not null]
  active           boolean [not null, default: true]
  removed_at       timestamptz
  removed_by       uuid
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (load_id, package_id) [unique]
  }
}

Table fulfillment.dispatch_load_shipment [headercolor: #2C7873] {
  id               uuid [pk]
  load_id          uuid [not null]
  shipment_id      uuid [not null]
  active           boolean [not null, default: true]
  added_at         timestamptz [not null]
  added_by         uuid [not null]
  removed_at       timestamptz
  removed_by       uuid
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (load_id, shipment_id) [unique]
  }
}

Table fulfillment.dispatch_load_unload [headercolor: #2C7873] {
  id               uuid [pk]
  load_id          uuid [not null]
  package_id       uuid [not null]
  shipment_id      uuid [not null]
  reason           varchar(500) [not null]
  requested_at     timestamptz [not null]
  unloaded_at      timestamptz
  unloaded_by      uuid
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  reason_code      fulfillment.dispatch_load_unload_reason_code
  overridden       boolean [not null, default: false]
  override_note    varchar(500)
  indexes {
    (load_id, package_id) [unique]
  }
}

Table fulfillment.load_estimate [headercolor: #2C7873] {
  id               uuid [pk]
  source_type      varchar(16) [not null]
  source_id        uuid [not null]
  warehouse_id     uuid
  vehicle_type_ids jsonb [not null, default: `'[]'::jsonb`]
  mode             fulfillment.load_estimate_mode [not null]
  status           fulfillment.load_estimate_status [not null]
  lines            jsonb [not null, default: `'[]'::jsonb`]
  layout           jsonb [not null, default: `'{}'::jsonb`]
  warnings         jsonb [not null, default: `'[]'::jsonb`]
  missing          jsonb [not null, default: `'[]'::jsonb`]
  incomplete       boolean [not null, default: false]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table fulfillment.load_placement [headercolor: #2C7873] {
  id                   uuid [pk]
  load_plan_id         uuid [not null]
  load_plan_vehicle_id uuid [not null]
  package_id           uuid [not null]
  x_mm                 int [not null]
  y_mm                 int [not null]
  z_mm                 int [not null]
  w_mm                 int [not null]
  h_mm                 int [not null]
  d_mm                 int [not null]
  orientation          smallint [not null]
  version              bigint [not null, default: 0]
  created_at           timestamptz [not null, default: `now()`]
  created_by           varchar(100)
  last_modified_at     timestamptz
  last_modified_by     varchar(100)
  indexes {
    (load_plan_id, package_id) [unique]
  }
}

Table fulfillment.load_plan [headercolor: #2C7873] {
  id                       uuid [pk]
  code                     varchar(30) [not null, unique]
  request_id               uuid [not null, unique]
  warehouse_id             uuid [not null]
  source_type              varchar(16) [not null, default: 'ORDER']
  selection_mode           fulfillment.load_plan_selection_mode [not null, default: 'SINGLE_TYPE']
  status                   fulfillment.load_plan_status [not null]
  note                     varchar(500)
  calculated_at            timestamptz
  calculated_by            uuid
  solver_meta              jsonb
  unplaced_acknowledged_at timestamptz
  unplaced_acknowledged_by uuid
  unplaced_ack_note        varchar(500)
  confirmed_at             timestamptz
  confirmed_by             uuid
  reopened_at              timestamptz
  reopened_by              uuid
  reopen_reason            varchar(500)
  dispatched_at            timestamptz
  cancelled_at             timestamptz
  cancelled_by             uuid
  cancel_reason            varchar(500)
  revised_at               timestamptz [not null, default: `now()`]
  version                  bigint [not null, default: 0]
  created_at               timestamptz [not null, default: `now()`]
  created_by               varchar(100)
  last_modified_at         timestamptz
  last_modified_by         varchar(100)
  cancel_reason_code       varchar(20)
}

Table fulfillment.load_plan_package [headercolor: #2C7873] {
  id               uuid [pk]
  load_plan_id     uuid [not null]
  package_id       uuid [not null]
  shipment_id      uuid [not null]
  active           boolean [not null, default: true]
  unplaced_reason  fulfillment.load_plan_package_unplaced_reason
  added_at         timestamptz [not null]
  added_by         uuid
  released_at      timestamptz
  release_reason   fulfillment.load_plan_package_release_reason
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (load_plan_id, package_id) [unique]
  }
}

Table fulfillment.load_plan_vehicle [headercolor: #2C7873] {
  id                  uuid [pk]
  load_plan_id        uuid [not null]
  seq                 int [not null]
  active              boolean [not null, default: true]
  vehicle_type_id     uuid [not null]
  vehicle_code        varchar(32) [not null]
  vehicle_kind        fulfillment.load_plan_vehicle_vehicle_kind [not null]
  inner_length_mm     int [not null]
  inner_width_mm      int [not null]
  inner_height_mm     int [not null]
  max_payload_kg      decimal(10,3) [not null]
  gusset_mm           int [not null, default: 0]
  door_width_mm       int
  door_height_mm      int
  used_volume_mm3     bigint [not null, default: 0]
  used_weight_kg      decimal(12,3) [not null, default: 0]
  volume_fill_pct     decimal(7,2) [not null, default: 0]
  weight_fill_pct     decimal(7,2) [not null, default: 0]
  needs_recalculation boolean [not null, default: false]
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null, default: `now()`]
  created_by          varchar(100)
  last_modified_at    timestamptz
  last_modified_by    varchar(100)
  indexes {
    (id, load_plan_id) [unique]
  }
}

Table fulfillment.load_plan_vehicle_type [headercolor: #2C7873] {
  id               uuid [pk]
  load_plan_id     uuid [not null]
  vehicle_type_id  uuid [not null]
  sort_order       int [not null, default: 0]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (load_plan_id, vehicle_type_id) [unique]
  }
}

Table fulfillment.load_waybill_file [headercolor: #2C7873] {
  id                uuid [pk]
  load_id           uuid [not null]
  storage_key       varchar(512) [not null]
  file_name         varchar(255) [not null]
  content_type      varchar(100) [not null]
  size_bytes        bigint [not null]
  uploaded_by       uuid [not null]
  uploaded_at       timestamptz [not null]
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null, default: `now()`]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
  waybill_import_id uuid
  indexes {
    (load_id, storage_key) [unique]
  }
}

Table fulfillment.pack [headercolor: #2C7873] {
  id               uuid [pk]
  pick_id          uuid [not null, unique]
  status           fulfillment.pack_status [not null]
  packed_at        timestamptz
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  started_at       timestamptz
  started_by       uuid
  packed_by        uuid
}

Table fulfillment.package [headercolor: #2C7873] {
  id                   uuid [pk]
  pack_id              uuid [not null]
  shipment_id          uuid
  package_no           int [not null]
  weight_kg            decimal(10,3)
  length_cm            decimal(10,2)
  width_cm             decimal(10,2)
  height_cm            decimal(10,2)
  dim_weight_kg        decimal(10,3)
  label_url            varchar(500)
  status               fulfillment.package_status [not null, default: 'OPEN']
  sealed_at            timestamptz
  version              bigint [not null, default: 0]
  created_at           timestamptz [not null, default: `now()`]
  created_by           varchar(100)
  last_modified_at     timestamptz
  last_modified_by     varchar(100)
  label_code           varchar(48) [not null, unique]
  rotatable            boolean [not null, default: true]
  rotatable_overridden boolean [not null, default: false]
  sealed_by            uuid
  voided_at            timestamptz
  voided_by            uuid
  pick_line_id         uuid [unique]
  lpn                  varchar(30)
  checked_at           timestamptz
  checked_by           uuid
  labeled_at           timestamptz
  labeled_by           uuid
  label_version        int [not null, default: 0]
  removed_at           timestamptz
  removed_by           uuid
  removal_reason       varchar(16)
  removal_note         varchar(500)
  indexes {
    (pack_id, package_no) [unique]
  }
}

Table fulfillment.pick [headercolor: #2C7873] {
  id                    uuid [pk]
  wave_id               uuid
  order_id              uuid [not null]
  status                fulfillment.pick_status [not null]
  version               bigint [not null, default: 0]
  created_at            timestamptz [not null]
  created_by            varchar(100)
  last_modified_at      timestamptz
  last_modified_by      varchar(100)
  assigned_user_id      uuid
  assigned_at           timestamptz
  started_at            timestamptz
  picked_at             timestamptz
  needs_put_back        boolean [not null, default: false]
  order_number          varchar(32) [not null]
  warehouse_id          uuid [not null]
  destination           fulfillment.pick_destination [not null, default: 'DISPATCH']
  staging_location_code varchar(64)
  staged_at             timestamptz
  moved_to_dispatch_at  timestamptz
  moved_to_dispatch_by  uuid
  delivery_batch_id     uuid
  redelivery_case_id    uuid
  indexes {
    (order_id, delivery_batch_id, redelivery_case_id) [unique]
  }
}

Table fulfillment.pick_line [headercolor: #2C7873] {
  id                     uuid [pk]
  pick_id                uuid [not null]
  order_line_id          uuid [not null]
  reservation_id         uuid
  sku                    varchar(64) [not null]
  location_code          varchar(64) [not null]
  lot_number             varchar(64)
  sequence_no            int [not null, default: 0]
  allocated_qty          int [not null]
  picked_qty             int [not null, default: 0]
  short_qty              int [not null, default: 0]
  status                 fulfillment.pick_line_status [not null, default: 'OPEN']
  picked_by              uuid
  picked_at              timestamptz
  version                bigint [not null, default: 0]
  created_at             timestamptz [not null, default: `now()`]
  created_by             varchar(100)
  last_modified_at       timestamptz
  last_modified_by       varchar(100)
  consumed_at            timestamptz
  scanned_location_code  varchar(64)
  scanned_code           varchar(64)
  put_back_qty           int [not null, default: 0]
  put_back_location_code varchar(64)
  put_back_by            uuid
  put_back_at            timestamptz
  lpn                    varchar(30)
  whole_carton           boolean [not null, default: false]
  short_reason           varchar(16)
  staged_at              timestamptz
  staged_location_code   varchar(64)
}

Table fulfillment.shipment [headercolor: #2C7873] {
  id                   uuid [pk]
  pack_id              uuid
  order_id             uuid [not null]
  carrier              varchar(120)
  tracking_number      varchar(128)
  status               fulfillment.shipment_status [not null]
  dispatched_at        timestamptz
  version              bigint [not null, default: 0]
  created_at           timestamptz [not null]
  created_by           varchar(100)
  last_modified_at     timestamptz
  last_modified_by     varchar(100)
  code                 varchar(48) [not null, unique]
  request_id           uuid [unique]
  warehouse_id         uuid [not null]
  package_count        int [not null, default: 1]
  partial              boolean [not null, default: false]
  partial_note         varchar(500)
  ready_at             timestamptz [not null]
  ready_by             uuid
  handed_over_at       timestamptz
  handed_over_by       uuid
  outcome_at           timestamptz
  outcome_by           uuid
  failure_reason       varchar(24)
  failure_note         varchar(500)
  cancelled_at         timestamptz
  cancel_reason        varchar(500)
  carrier_id           uuid
  load_id              uuid
  whole_order_handover boolean [not null, default: false]
}

Table fulfillment.shipment_event [headercolor: #2C7873] {
  id               uuid [pk]
  shipment_id      uuid [not null]
  status           fulfillment.shipment_event_status [not null]
  occurred_at      timestamptz [not null]
  source           fulfillment.shipment_event_source [not null]
  carrier_event_id varchar(128)
  location_text    varchar(255)
  note             varchar(1000)
  raw_payload      jsonb
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  recorded_by      uuid
}

Table fulfillment.shipment_pod_file [headercolor: #2C7873] {
  id               uuid [pk]
  shipment_id      uuid [not null]
  storage_key      varchar(512) [not null, unique]
  file_name        varchar(255) [not null]
  content_type     varchar(100) [not null]
  size_bytes       bigint [not null]
  uploaded_by      uuid [not null]
  uploaded_at      timestamptz [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table fulfillment.tracking_milestone [headercolor: #2C7873] {
  id                  uuid [pk]
  load_id             uuid [not null]
  milestone           fulfillment.tracking_milestone_milestone [not null]
  carrier_reported_at timestamptz [not null]
  source              fulfillment.tracking_milestone_source [not null]
  carrier_event_id    uuid
  recorded_at         timestamptz [not null]
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null, default: `now()`]
  created_by          varchar(100)
  last_modified_at    timestamptz
  last_modified_by    varchar(100)
  indexes {
    (load_id, milestone) [unique]
  }
}

Table fulfillment.vehicle_type [headercolor: #2C7873] {
  id               uuid [pk]
  code             varchar(32) [not null, unique]
  name             varchar(120) [not null]
  kind             fulfillment.vehicle_type_kind [not null]
  inner_length_mm  int [not null]
  inner_width_mm   int [not null]
  inner_height_mm  int [not null]
  gusset_mm        int [not null, default: 0]
  max_payload_kg   decimal(10,3) [not null]
  available_count  int [not null, default: 0]
  rental_price     decimal(19,4)
  is_preset        boolean [not null, default: false]
  status           fulfillment.vehicle_type_status [not null, default: 'ACTIVE']
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  door_width_mm    int
  door_height_mm   int
}

Table fulfillment.wave [headercolor: #2C7873] {
  id               uuid [pk]
  code             varchar(64) [not null, unique]
  status           fulfillment.wave_status [not null]
  released_at      timestamptz
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table fulfillment.waybill_change [headercolor: #2C7873] {
  id               uuid [pk]
  load_id          uuid [not null]
  old_waybill_no   varchar(64)
  new_waybill_no   varchar(64)
  source           fulfillment.waybill_change_source [not null]
  changed_by       uuid
  changed_at       timestamptz [not null]
  reason           varchar(500)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table fulfillment.waybill_import [headercolor: #2C7873] {
  id               uuid [pk]
  file_name        varchar(255) [not null]
  storage_key      varchar(512) [not null, unique]
  uploaded_by      uuid [not null]
  uploaded_at      timestamptz [not null]
  rows_total       int [not null]
  rows_applied     int [not null]
  rows_rejected    int [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table fulfillment.waybill_import_row [headercolor: #2C7873] {
  id               uuid [pk]
  import_id        uuid [not null]
  line_no          int [not null]
  load_code        varchar(64)
  waybill_no       varchar(255)
  vehicle_plate    varchar(255)
  driver_name      varchar(255)
  driver_phone     varchar(255)
  load_id          uuid
  outcome          fulfillment.waybill_import_row_outcome [not null]
  problem          varchar(32)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (import_id, line_no) [unique]
  }
}

// =============================================================================
// SCHEMA: catalog
// =============================================================================

Table catalog.catalog_entry [headercolor: #1B998B] {
  id               uuid [pk]
  sku              varchar(64) [not null, unique]
  title            varchar(300) [not null]
  slug             varchar(200) [not null, unique]
  description      text
  atp              int
  published        boolean [not null, default: false]
  seo_title        varchar(300)
  seo_description  text
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  product_id       uuid
  source_revision  bigint
}

Table catalog.customer_price [headercolor: #1B998B] {
  id               uuid [pk]
  customer_id      uuid [not null]
  sku              varchar(64) [not null]
  currency         varchar(3) [not null, default: 'VND']
  note             varchar(500)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (customer_id, sku) [unique]
  }
}

Table catalog.customer_price_tier [headercolor: #1B998B] {
  id                uuid [pk]
  customer_price_id uuid [not null]
  min_quantity      int [not null]
  unit_price        decimal(18,2) [not null]
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
  indexes {
    (customer_price_id, min_quantity) [unique]
  }
}

Table catalog.product_listing [headercolor: #1B998B] {
  product_id                uuid [pk]
  slug                      varchar(255) [not null, unique]
  seo_title                 varchar(255)
  seo_description           text
  revision                  bigint [not null, default: 0]
  projected_revision        bigint [not null, default: `'-1'::integer`]
  enabled                   boolean [not null, default: false]
  ever_published            boolean [not null, default: false]
  published_title           varchar(300)
  published_description     text
  published_seo_title       varchar(255)
  published_seo_description text
  last_attempt_at           timestamptz
  search_document           tsvector [note: 'generated: (setweight(to_tsvector(\'simple\'::regconfig, catalog.immutable_unaccent((COALESCE(published_title, \'\'::character varying))::text)), \'A\'::"char") || setweight(to_tsvector(\'simple\'::regconfig, catalog.immutable_unaccent(COALESCE(published_description, \'\'::text))), \'C\'::"char"))']
}

// =============================================================================
// SCHEMA: chat
// =============================================================================

Table chat.canned_response [headercolor: #4C93A8] {
  id               uuid [pk]
  owner_id         uuid
  title            varchar(200) [not null]
  body             varchar(4000) [not null]
  shortcut         varchar(32)
  category         varchar(64)
  archived_at      timestamptz
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table chat.conversation [headercolor: #4C93A8] {
  id                        uuid [pk]
  customer_id               uuid [not null]
  order_id                  uuid
  subject                   varchar(300)
  status                    chat.conversation_status [not null]
  assigned_agent_id         uuid
  version                   bigint [not null, default: 0]
  created_at                timestamptz [not null]
  created_by                varchar(100)
  last_modified_at          timestamptz
  last_modified_by          varchar(100)
  opened_by_type            chat.conversation_opened_by_type [not null]
  opened_by                 uuid
  assigned_at               timestamptz
  status_changed_at         timestamptz [not null]
  first_response_due_at     timestamptz
  first_responded_at        timestamptz
  first_response_alerted_at timestamptz
  resolution_due_at         timestamptz
  resolution_alerted_at     timestamptz
  escalation_reason         varchar(1000)
  escalated_to_id           uuid
  resolved_at               timestamptz
  resolved_by               uuid
  auto_closed_at            timestamptz
  closed_at                 timestamptz
  reopen_until              timestamptz
  last_customer_message_at  timestamptz
  last_message_at           timestamptz
  last_message_seq          bigint [not null, default: 0]
  csat_score                smallint
  csat_comment              varchar(2000)
  csat_submitted_at         timestamptz
  continued_from_id         uuid
  merged_into_id            uuid
}

Table chat.conversation_context [headercolor: #4C93A8] {
  id                  uuid [pk]
  conversation_id     uuid [not null]
  kind                chat.conversation_context_kind [not null]
  product_id          uuid
  variant_id          uuid
  design_id           uuid
  design_project_id   uuid
  quote_id            uuid
  order_id            uuid
  contract_id         uuid
  production_order_id uuid
  einvoice_id         uuid
  is_primary          boolean [not null, default: false]
  attached_by         uuid
  attached_at         timestamptz [not null]
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null]
  created_by          varchar(100)
  last_modified_at    timestamptz
  last_modified_by    varchar(100)
  indexes {
    (id, conversation_id) [unique]
  }
}

Table chat.conversation_event [headercolor: #4C93A8] {
  id               uuid [pk]
  conversation_id  uuid [not null]
  type             chat.conversation_event_type [not null]
  actor_type       varchar(16) [not null]
  actor_id         uuid
  occurred_at      timestamptz [not null]
  from_status      varchar(32)
  to_status        varchar(32)
  context_id       uuid
  message_id       uuid
  target_user_id   uuid
  note             varchar(1000)
  detail           jsonb
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table chat.message [headercolor: #4C93A8] {
  id                uuid [pk]
  conversation_id   uuid [not null]
  sender_type       chat.message_sender_type [not null]
  sender_id         uuid
  body              varchar(4000)
  sent_at           timestamptz [not null]
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
  seq               bigint [not null]
  kind              chat.message_kind [not null, default: 'TEXT']
  visibility        chat.message_visibility [not null, default: 'CUSTOMER']
  client_message_id varchar(64)
  context_id        uuid
  card_kind         chat.message_card_kind
  card_payload      jsonb
  card_state        chat.message_card_state
  card_updated_at   timestamptz
  edited_at         timestamptz
  deleted_at        timestamptz
  deleted_by        uuid
  indexes {
    (conversation_id, seq) [unique]
    (id, kind) [unique]
    (id, conversation_id) [unique]
  }
}

Table chat.message_attachment [headercolor: #4C93A8] {
  id               uuid [pk]
  message_id       uuid [not null]
  message_kind     chat.message_attachment_message_kind [not null, default: 'ATTACHMENT']
  file_key         varchar(512) [not null, unique]
  original_name    varchar(255)
  content_type     varchar(100) [not null]
  size_bytes       bigint [not null]
  sha256           varchar(64) [not null]
  width            int
  height           int
  uploaded_by      uuid [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table chat.message_mention [headercolor: #4C93A8] {
  id           uuid [pk]
  message_id   uuid [not null]
  message_kind varchar(16) [not null, default: 'INTERNAL_NOTE']
  user_id      uuid [not null]
  created_at   timestamptz [not null]
  indexes {
    (message_id, user_id) [unique]
  }
}

Table chat.participant_read [headercolor: #4C93A8] {
  id                   uuid [pk]
  conversation_id      uuid [not null]
  user_id              uuid [not null]
  reader_type          chat.participant_read_reader_type [not null]
  last_read_seq        bigint [not null, default: 0]
  last_read_message_id uuid
  last_read_at         timestamptz
  version              bigint [not null, default: 0]
  created_at           timestamptz [not null]
  created_by           varchar(100)
  last_modified_at     timestamptz
  last_modified_by     varchar(100)
  indexes {
    (conversation_id, user_id) [unique]
  }
}

// =============================================================================
// SCHEMA: notification
// =============================================================================

Table notification.delivery_log [headercolor: #A6763F] {
  id                  uuid [pk]
  template_code       varchar(64)
  channel             notification.delivery_log_channel [not null]
  recipient           varchar(500) [not null]
  status              notification.delivery_log_status [not null]
  error               varchar(1000)
  sent_at             timestamptz
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null]
  created_by          varchar(100)
  last_modified_at    timestamptz
  last_modified_by    varchar(100)
  external_reference  varchar(100)
  operation_reference varchar(100)
  terminal            boolean [not null, default: false]
  delivery_generation int [not null, default: 0]
  attempt_number      int [not null, default: 1]
  provider            notification.delivery_log_provider
  provider_message_id varchar(100)
  next_attempt_at     timestamptz
  provider_status     notification.delivery_log_provider_status
  provider_status_at  timestamptz
}

Table notification.preference [headercolor: #A6763F] {
  id               uuid [pk]
  user_id          uuid [not null]
  channel          notification.preference_channel [not null]
  enabled          boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (user_id, channel) [unique]
  }
}

Table notification.template [headercolor: #A6763F] {
  id               uuid [pk]
  code             varchar(64) [not null]
  channel          notification.template_channel [not null]
  subject          varchar(300)
  body             varchar(4000) [not null]
  locale           varchar(10) [not null, default: 'vi']
  active           boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (code, locale) [unique]
  }
}

Table notification.user_notification [headercolor: #A6763F] {
  id           uuid [pk]
  recipient_id uuid [not null]
  category     varchar(40) [not null]
  severity     notification.user_notification_severity [not null]
  title        varchar(200) [not null]
  body         varchar(1000)
  link         varchar(300)
  source_type  varchar(40)
  source_id    varchar(100)
  dedupe_key   varchar(200) [not null]
  created_at   timestamptz [not null, default: `now()`]
  read_at      timestamptz
  indexes {
    (recipient_id, dedupe_key) [unique]
  }
}

// =============================================================================
// SCHEMA: reporting
// =============================================================================

Table reporting.processed_order_closures [headercolor: #607D8B] {
  closure_id   uuid [pk]
  order_id     uuid [not null]
  placed_day   date [not null]
  currency     varchar(3) [not null]
  total        decimal(18,2) [not null]
  lines        jsonb [not null, default: `'[]'::jsonb`]
  processed_at timestamptz [not null, default: `now()`]
}

Table reporting.processed_order_events [headercolor: #607D8B] {
  order_id     uuid [not null]
  event_type   reporting.processed_order_events_event_type [not null]
  placed_day   date [not null]
  currency     varchar(3) [not null]
  total        decimal(18,2) [not null]
  lines        jsonb [not null, default: `'[]'::jsonb`]
  processed_at timestamptz [not null, default: `now()`]
  indexes {
    (order_id, event_type) [pk]
  }
}

Table reporting.processed_return_events [headercolor: #607D8B] {
  return_request_id uuid [not null]
  event_type        reporting.processed_return_events_event_type [not null]
  order_id          uuid [not null]
  placed_day        date [not null]
  currency          varchar(3) [not null]
  total             decimal(18,2) [not null]
  lines             jsonb [not null, default: `'[]'::jsonb`]
  processed_at      timestamptz [not null, default: `now()`]
  indexes {
    (return_request_id, event_type) [pk]
  }
}

Table reporting.product_sales_summary [headercolor: #607D8B] {
  id               uuid [pk]
  sku              varchar(64) [not null]
  period           varchar(10) [not null]
  quantity_sold    int [not null, default: 0]
  revenue          decimal(18,2) [not null, default: 0]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  cartons_sold     int [not null, default: 0]
  indexes {
    (sku, period) [unique]
  }
}

Table reporting.sales_daily_summary [headercolor: #607D8B] {
  id               uuid [pk]
  day              date [not null]
  orders_count     int [not null, default: 0]
  revenue          decimal(18,2) [not null, default: 0]
  currency         varchar(3) [not null, default: 'VND']
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (day, currency) [unique]
  }
}

// =============================================================================
// SCHEMA: identity
// =============================================================================

Table identity.app_role [headercolor: #5A6ACF] {
  id               uuid [pk]
  code             varchar(64) [not null, unique]
  name             varchar(200) [not null]
  description      varchar(1000)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  is_system        boolean [not null, default: false]
  data_scope       identity.app_role_data_scope [not null, default: 'ALL']
}

Table identity.app_user [headercolor: #5A6ACF] {
  id                        uuid [pk]
  username                  varchar(320) [not null, unique]
  email                     varchar(320) [not null, unique]
  password_hash             varchar(200)
  full_name                 varchar(200)
  status                    identity.app_user_status [not null]
  last_login_at             timestamptz
  version                   bigint [not null, default: 0]
  created_at                timestamptz [not null]
  created_by                varchar(100)
  last_modified_at          timestamptz
  last_modified_by          varchar(100)
  must_change_password      boolean [not null, default: false]
  failed_login_count        int [not null, default: 0]
  locked_until              timestamptz
  temporary_password_set_at timestamptz
}

Table identity.permission [headercolor: #5A6ACF] {
  id               uuid [pk]
  code             varchar(128) [not null, unique]
  resource         varchar(64)
  action           varchar(64)
  description      varchar(500)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table identity.portal_invitation [headercolor: #5A6ACF] {
  id                    uuid [pk]
  user_id               uuid [not null]
  token_digest          character(64) [not null, unique]
  issued_at             timestamptz [not null]
  expires_at            timestamptz [not null]
  consumed_at           timestamptz
  revoked_at            timestamptz
  issued_by             uuid
  delivery_status       varchar(16)
  delivery_attempted_at timestamptz
  version               bigint [not null, default: 0]
  created_at            timestamptz [not null, default: `now()`]
  created_by            varchar(100)
  last_modified_at      timestamptz
  last_modified_by      varchar(100)
}

Table identity.role_permission [headercolor: #5A6ACF] {
  id               uuid [pk]
  role_id          uuid [not null]
  permission_id    uuid [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (role_id, permission_id) [unique]
  }
}

Table identity.user_role [headercolor: #5A6ACF] {
  id               uuid [pk]
  user_id          uuid [not null]
  role_id          uuid [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (user_id, role_id) [unique]
  }
}

Table identity.user_session [headercolor: #5A6ACF] {
  id               uuid [pk]
  user_id          uuid [not null]
  issued_at        timestamptz [not null]
  expires_at       timestamptz [not null]
  revoked_at       timestamptz
  revoked_reason   identity.user_session_revoked_reason
  client_address   varchar(45)
  user_agent       varchar(255)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table identity.user_status_change [headercolor: #5A6ACF] {
  id               uuid [pk]
  user_id          uuid [not null]
  action           identity.user_status_change_action [not null]
  from_status      identity.user_status_change_from_status [not null]
  to_status        identity.user_status_change_to_status [not null]
  reason           varchar(500) [not null]
  actor_id         uuid
  actor_username   varchar(320) [not null]
  changed_at       timestamptz [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table identity.user_warehouse [headercolor: #5A6ACF] {
  id               uuid [pk]
  user_id          uuid [not null]
  warehouse_id     uuid [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (user_id, warehouse_id) [unique]
  }
}

// =============================================================================
// SCHEMA: platform
// =============================================================================

Table platform.audit_log [headercolor: #616161] {
  id                uuid [pk]
  actor_id          uuid
  actor_name        varchar(100)
  action            platform.audit_log_action [not null]
  resource_type     varchar(64) [not null]
  resource_id       varchar(128)
  outcome           platform.audit_log_outcome [not null]
  correlation_id    varchar(64)
  client_address    varchar(45)
  details           text
  occurred_at       timestamptz [not null]
  security_relevant boolean [not null]
}

Table platform.document_sequence [headercolor: #616161] {
  document_type varchar(16) [not null]
  sequence_date date [not null]
  last_value    bigint [not null, default: 0]
  indexes {
    (document_type, sequence_date) [pk]
  }
}

Table platform.idempotency_record [headercolor: #616161] {
  id                  uuid [pk]
  idempotency_key     varchar(255) [not null]
  caller              varchar(64) [not null]
  request_fingerprint varchar(64) [not null]
  status              platform.idempotency_record_status [not null]
  response_status     int
  response_body       text
  created_at          timestamptz [not null]
  completed_at        timestamptz
  expires_at          timestamptz [not null]
  indexes {
    (idempotency_key, caller) [unique]
  }
}

Table platform.legacy_archive [headercolor: #616161] {
  id           bigint [pk]
  source_table varchar(100) [not null]
  row_id       uuid
  row_data     jsonb [not null]
  archived_at  timestamptz [not null, default: `now()`]
}

Table platform.shedlock [headercolor: #616161] {
  name       varchar(64) [pk]
  lock_until timestamptz [not null]
  locked_at  timestamptz [not null]
  locked_by  varchar(255) [not null]
}

// =============================================================================
// SCHEMA: public
// =============================================================================

Table public.event_publication [headercolor: #9E9E9E] {
  id               uuid [pk]
  listener_id      text [not null]
  event_type       text [not null]
  serialized_event text [not null]
  publication_date timestamptz [not null]
  completion_date  timestamptz
}


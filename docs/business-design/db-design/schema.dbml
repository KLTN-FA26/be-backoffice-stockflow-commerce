// =============================================================================
// SCHEMA: catalog
// =============================================================================

Table catalog.catalog_entry [headercolor: #1B998B] {
  id               uuid [pk]
  sku              varchar(64) [not null, unique]
  title            varchar(300) [not null]
  slug             varchar(200) [not null, unique]
  description      text
  price            decimal(18,2)
  currency         varchar(3) [not null, default: 'VND']
  atp              int
  published        boolean [not null, default: false]
  seo_title        varchar(300)
  seo_description  text
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  product_id       uuid
  source_revision  bigint
}

Table catalog.customer_price [headercolor: #1B998B] {
  id               uuid [pk]
  customer_id      uuid [not null]
  sku              varchar(64) [not null]
  currency         varchar(3) [not null, default: 'VND']
  note             varchar(500)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (customer_id, sku) [unique]
  }
}

Table catalog.customer_price_tier [headercolor: #1B998B] {
  id                uuid [pk]
  customer_price_id uuid [not null]
  min_quantity      int [not null]
  unit_price        decimal(18,2) [not null]
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
  indexes {
    (customer_price_id, min_quantity) [unique]
  }
}

Table catalog.pricing_rule [headercolor: #1B998B] {
  id               uuid [pk]
  name             varchar(200) [not null]
  sku              varchar(64)
  segment_id       uuid
  price            decimal(18,2) [not null]
  currency         varchar(3) [not null, default: 'VND']
  priority         int [not null, default: 0]
  active           boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table catalog.product_listing [headercolor: #1B998B] {
  product_id                uuid [pk]
  slug                      varchar(255) [not null, unique]
  seo_title                 varchar(255)
  seo_description           text
  revision                  bigint [not null, default: 0]
  projected_revision        bigint [not null, default: `'-1'::integer`]
  enabled                   boolean [not null, default: false]
  ever_published            boolean [not null, default: false]
  published_title           varchar(300)
  published_description     text
  published_seo_title       varchar(255)
  published_seo_description text
  last_attempt_at           timestamptz
  search_document           tsvector
}

Table catalog.promotion [headercolor: #1B998B] {
  id               uuid [pk]
  code             varchar(64) [not null, unique]
  name             varchar(200) [not null]
  type             catalog.promotion_type [not null]
  value            decimal(18,2) [not null]
  starts_at        timestamptz
  ends_at          timestamptz
  active           boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

// =============================================================================
// SCHEMA: chat
// =============================================================================

Table chat.conversation [headercolor: #4C93A8] {
  id                uuid [pk]
  customer_id       uuid [not null]
  order_id          uuid
  subject           varchar(300)
  status            chat.conversation_status [not null]
  assigned_agent_id uuid
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
}

Table chat.message [headercolor: #4C93A8] {
  id               uuid [pk]
  conversation_id  uuid [not null]
  sender_type      chat.message_sender_type [not null]
  sender_id        uuid
  body             varchar(4000) [not null]
  sent_at          timestamptz [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

// =============================================================================
// SCHEMA: notification
// =============================================================================

Table notification.delivery_log [headercolor: #A6763F] {
  id                  uuid [pk]
  template_code       varchar(64)
  channel             notification.delivery_log_channel [not null]
  recipient           varchar(500) [not null]
  status              notification.delivery_log_status [not null]
  error               varchar(1000)
  sent_at             timestamptz
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null]
  created_by          varchar(100)
  last_modified_at    timestamptz
  last_modified_by    varchar(100)
  external_reference  varchar(100)
  operation_reference varchar(100)
  terminal            boolean [not null, default: false]
  delivery_generation int [not null, default: 0]
  attempt_number      int [not null, default: 1]
  provider            notification.delivery_log_provider
  provider_message_id varchar(100)
  next_attempt_at     timestamptz
  provider_status     notification.delivery_log_provider_status
  provider_status_at  timestamptz
}

Table notification.po_delivery_control [headercolor: #A6763F] {
  purchase_order_id      uuid [pk]
  generation             int [not null, default: 0]
  suppressed             boolean [not null, default: false]
  cancellation_requested boolean [not null, default: false]
}

Table notification.po_retry_cursor [headercolor: #A6763F] {
  id                  smallint [pk]
  last_publication_id uuid
}

Table notification.preference [headercolor: #A6763F] {
  id               uuid [pk]
  user_id          uuid [not null]
  channel          notification.preference_channel [not null]
  enabled          boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (user_id, channel) [unique]
  }
}

Table notification.template [headercolor: #A6763F] {
  id               uuid [pk]
  code             varchar(64) [not null]
  channel          notification.template_channel [not null]
  subject          varchar(300)
  body             varchar(4000) [not null]
  locale           varchar(10) [not null, default: 'vi']
  active           boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (code, locale) [unique]
  }
}

Table notification.user_notification [headercolor: #A6763F] {
  id           uuid [pk]
  recipient_id uuid [not null]
  category     varchar(40) [not null]
  severity     notification.user_notification_severity [not null]
  title        varchar(200) [not null]
  body         varchar(1000)
  link         varchar(300)
  source_type  varchar(40)
  source_id    varchar(100)
  dedupe_key   varchar(200) [not null]
  created_at   timestamptz [not null, default: `now()`]
  read_at      timestamptz
  indexes {
    (recipient_id, dedupe_key) [unique]
  }
}

// =============================================================================
// SCHEMA: reporting
// =============================================================================

Table reporting.processed_order_closures [headercolor: #607D8B] {
  closure_id   uuid [pk]
  order_id     uuid [not null]
  placed_day   date [not null]
  currency     varchar(3) [not null]
  total        decimal(18,2) [not null]
  lines        jsonb [not null, default: `'[]'::jsonb`]
  processed_at timestamptz [not null, default: `now()`]
}

Table reporting.processed_order_events [headercolor: #607D8B] {
  order_id     uuid [not null]
  event_type   reporting.processed_order_events_event_type [not null]
  placed_day   date [not null]
  currency     varchar(3) [not null]
  total        decimal(18,2) [not null]
  lines        jsonb [not null, default: `'[]'::jsonb`]
  processed_at timestamptz [not null, default: `now()`]
  indexes {
    (order_id, event_type) [pk]
  }
}

Table reporting.processed_return_events [headercolor: #607D8B] {
  return_request_id uuid [not null]
  event_type        reporting.processed_return_events_event_type [not null]
  order_id          uuid [not null]
  placed_day        date [not null]
  currency          varchar(3) [not null]
  total             decimal(18,2) [not null]
  lines             jsonb [not null, default: `'[]'::jsonb`]
  processed_at      timestamptz [not null, default: `now()`]
  indexes {
    (return_request_id, event_type) [pk]
  }
}

Table reporting.product_sales_summary [headercolor: #607D8B] {
  id               uuid [pk]
  sku              varchar(64) [not null]
  period           varchar(10) [not null]
  quantity_sold    int [not null, default: 0]
  revenue          decimal(18,2) [not null, default: 0]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (sku, period) [unique]
  }
}

Table reporting.sales_daily_summary [headercolor: #607D8B] {
  id               uuid [pk]
  day              date [not null]
  orders_count     int [not null, default: 0]
  revenue          decimal(18,2) [not null, default: 0]
  currency         varchar(3) [not null, default: 'VND']
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (day, currency) [unique]
  }
}

// =============================================================================
// SCHEMA: identity
// =============================================================================

Table identity.app_role [headercolor: #5A6ACF] {
  id               uuid [pk]
  code             varchar(64) [not null, unique]
  name             varchar(200) [not null]
  description      varchar(1000)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  is_system        boolean [not null, default: false]
  data_scope       identity.app_role_data_scope [not null, default: 'ALL']
}

Table identity.app_user [headercolor: #5A6ACF] {
  id                        uuid [pk]
  username                  varchar(320) [not null, unique]
  email                     varchar(320) [not null, unique]
  password_hash             varchar(200)
  full_name                 varchar(200)
  status                    identity.app_user_status [not null]
  last_login_at             timestamptz
  version                   bigint [not null, default: 0]
  created_at                timestamptz [not null]
  created_by                varchar(100)
  last_modified_at          timestamptz
  last_modified_by          varchar(100)
  must_change_password      boolean [not null, default: false]
  failed_login_count        int [not null, default: 0]
  locked_until              timestamptz
  temporary_password_set_at timestamptz
}

Table identity.permission [headercolor: #5A6ACF] {
  id               uuid [pk]
  code             varchar(128) [not null, unique]
  resource         varchar(64)
  action           varchar(64)
  description      varchar(500)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table identity.portal_invitation [headercolor: #5A6ACF] {
  id                    uuid [pk]
  user_id               uuid [not null]
  token_digest          character(64) [not null, unique]
  issued_at             timestamptz [not null]
  expires_at            timestamptz [not null]
  consumed_at           timestamptz
  revoked_at            timestamptz
  issued_by             uuid
  delivery_status       varchar(16)
  delivery_attempted_at timestamptz
  version               bigint [not null, default: 0]
  created_at            timestamptz [not null, default: `now()`]
  created_by            varchar(100)
  last_modified_at      timestamptz
  last_modified_by      varchar(100)
}

Table identity.role_permission [headercolor: #5A6ACF] {
  id               uuid [pk]
  role_id          uuid [not null]
  permission_id    uuid [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (role_id, permission_id) [unique]
  }
}

Table identity.user_role [headercolor: #5A6ACF] {
  id               uuid [pk]
  user_id          uuid [not null]
  role_id          uuid [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (user_id, role_id) [unique]
  }
}

Table identity.user_session [headercolor: #5A6ACF] {
  id               uuid [pk]
  user_id          uuid [not null]
  issued_at        timestamptz [not null]
  expires_at       timestamptz [not null]
  revoked_at       timestamptz
  revoked_reason   identity.user_session_revoked_reason
  client_address   varchar(45)
  user_agent       varchar(255)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table identity.user_status_change [headercolor: #5A6ACF] {
  id               uuid [pk]
  user_id          uuid [not null]
  action           identity.user_status_change_action [not null]
  from_status      identity.user_status_change_from_status [not null]
  to_status        identity.user_status_change_to_status [not null]
  reason           varchar(500) [not null]
  actor_id         uuid
  actor_username   varchar(320) [not null]
  changed_at       timestamptz [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table identity.user_warehouse [headercolor: #5A6ACF] {
  id               uuid [pk]
  user_id          uuid [not null]
  warehouse_id     uuid [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (user_id, warehouse_id) [unique]
  }
}

// =============================================================================
// SCHEMA: platform
// =============================================================================

Table platform.audit_log [headercolor: #616161] {
  id                uuid [pk]
  actor_id          uuid
  actor_name        varchar(100)
  action            platform.audit_log_action [not null]
  resource_type     varchar(64) [not null]
  resource_id       varchar(128)
  outcome           platform.audit_log_outcome [not null]
  correlation_id    varchar(64)
  client_address    varchar(45)
  details           text
  occurred_at       timestamptz [not null]
  security_relevant boolean [not null]
}

Table platform.document_sequence [headercolor: #616161] {
  document_type varchar(16) [not null]
  sequence_date date [not null]
  last_value    bigint [not null, default: 0]
  indexes {
    (document_type, sequence_date) [pk]
  }
}

Table platform.idempotency_record [headercolor: #616161] {
  id                  uuid [pk]
  idempotency_key     varchar(255) [not null]
  caller              varchar(64) [not null]
  request_fingerprint varchar(64) [not null]
  status              platform.idempotency_record_status [not null]
  response_status     int
  response_body       text
  created_at          timestamptz [not null]
  completed_at        timestamptz
  expires_at          timestamptz [not null]
  indexes {
    (idempotency_key, caller) [unique]
  }
}

Table platform.legacy_archive [headercolor: #616161] {
  id           bigint [pk]
  source_table varchar(100) [not null]
  row_id       uuid
  row_data     jsonb [not null]
  archived_at  timestamptz [not null, default: `now()`]
}

Table platform.shedlock [headercolor: #616161] {
  name       varchar(64) [pk]
  lock_until timestamptz [not null]
  locked_at  timestamptz [not null]
  locked_by  varchar(255) [not null]
}

// =============================================================================
// SCHEMA: public
// =============================================================================

Table public.event_publication [headercolor: #9E9E9E] {
  id               uuid [pk]
  listener_id      text [not null]
  event_type       text [not null]
  serialized_event text [not null]
  publication_date timestamptz [not null]
  completion_date  timestamptz
}


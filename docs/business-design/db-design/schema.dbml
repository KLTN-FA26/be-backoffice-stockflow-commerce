// =============================================================================
// SCHEMA: product
// =============================================================================

Table product.attribute_values [headercolor: #2E86AB] {
  id               uuid [pk]
  attribute_id     uuid [not null]
  code             varchar(50) [not null]
  label            varchar(255) [not null]
  value_number     decimal(18,4)
  hex_color        varchar(7)
  sort_order       int [not null, default: 0]
  is_active        boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (attribute_id, code) [unique]
  }
}

Table product.attributes [headercolor: #2E86AB] {
  id               uuid [pk]
  code             varchar(50) [not null, unique]
  name             varchar(255) [not null]
  data_type        product.attributes_data_type [not null]
  unit             varchar(20)
  is_filterable    boolean [not null, default: false]
  is_searchable    boolean [not null, default: false]
  sort_order       int [not null, default: 0]
  is_active        boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table product.brands [headercolor: #2E86AB] {
  id               uuid [pk]
  code             varchar(50) [not null, unique]
  name             varchar(255) [not null]
  slug             varchar(255) [not null, unique]
  logo_url         text
  is_active        boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table product.categories [headercolor: #2E86AB] {
  id               uuid [pk]
  parent_id        uuid
  code             varchar(50) [not null, unique]
  name             varchar(255) [not null]
  slug             varchar(255) [not null, unique]
  path             text [not null]
  depth            int [not null, default: 0]
  sort_order       int [not null, default: 0]
  image_url        text
  seo_title        varchar(255)
  seo_description  text
  is_active        boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table product.category_attributes [headercolor: #2E86AB] {
  id               uuid [pk]
  category_id      uuid [not null]
  attribute_id     uuid [not null]
  default_role     product.category_attributes_default_role [not null]
  is_required      boolean [not null, default: false]
  sort_order       int [not null, default: 0]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (category_id, attribute_id) [unique]
  }
}

Table product.customization_templates [headercolor: #2E86AB] {
  id                   uuid [pk]
  variant_id           uuid [not null]
  code                 varchar(50) [not null]
  name                 varchar(255) [not null]
  template_2d_url      text [not null]
  model_3d_url         text
  min_dpi              int [not null, default: 150]
  color_mode           product.customization_templates_color_mode [not null, default: 'CMYK']
  allowed_file_formats text[] [not null]
  max_file_size_mb     int [not null]
  max_colors           int
  allowed_font_codes   text[]
  is_active            boolean [not null, default: true]
  version              bigint [not null, default: 0]
  created_at           timestamptz [not null, default: `now()`]
  created_by           varchar(100)
  last_modified_at     timestamptz
  last_modified_by     varchar(100)
  indexes {
    (variant_id, code) [unique]
  }
}

Table product.media [headercolor: #2E86AB] {
  id               uuid [pk]
  variant_id       uuid [not null]
  kind             product.media_kind [not null, default: 'IMAGE']
  url              text
  storage_key      varchar(500) [unique]
  original_name    varchar(255)
  content_type     varchar(100)
  size_bytes       bigint
  checksum         varchar(64)
  stored_at        timestamptz
  renditions       jsonb [not null, default: `'[]'::jsonb`]
  upload_key       varchar(300)
  alt_text         varchar(255)
  sort_order       int [not null, default: 0]
  is_primary       boolean [not null, default: false]
  is_published     boolean [not null, default: false]
  published_at     timestamptz
  published_by     uuid
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table product.print_areas [headercolor: #2E86AB] {
  id               uuid [pk]
  template_id      uuid [not null]
  code             varchar(50) [not null]
  name             varchar(255) [not null]
  x_mm             decimal(10,2) [not null]
  y_mm             decimal(10,2) [not null]
  width_mm         decimal(10,2) [not null]
  height_mm        decimal(10,2) [not null]
  safe_margin_mm   decimal(10,2) [not null, default: 0]
  bleed_mm         decimal(10,2) [not null, default: 0]
  shape_json       jsonb
  uv_mapping_json  jsonb
  sort_order       int [not null, default: 0]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (template_id, code) [unique]
  }
}

Table product.product_attribute_options [headercolor: #2E86AB] {
  id                   uuid [pk]
  product_attribute_id uuid [not null]
  attribute_value_id   uuid [not null]
  version              bigint [not null, default: 0]
  created_at           timestamptz [not null, default: `now()`]
  created_by           varchar(100)
  last_modified_at     timestamptz
  last_modified_by     varchar(100)
  indexes {
    (product_attribute_id, attribute_value_id) [unique]
  }
}

Table product.product_attributes [headercolor: #2E86AB] {
  id               uuid [pk]
  product_id       uuid [not null]
  attribute_id     uuid [not null]
  role             product.product_attributes_role [not null]
  sort_order       int [not null, default: 0]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (product_id, attribute_id) [unique]
  }
}

Table product.product_categories [headercolor: #2E86AB] {
  id               uuid [pk]
  product_id       uuid [not null]
  category_id      uuid [not null]
  is_primary       boolean [not null, default: false]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (product_id, category_id) [unique]
  }
}

Table product.product_descriptive_values [headercolor: #2E86AB] {
  id                   uuid [pk]
  product_attribute_id uuid [not null]
  attribute_value_id   uuid
  value_text           text
  value_number         decimal(18,4)
  value_boolean        boolean
  version              bigint [not null, default: 0]
  created_at           timestamptz [not null, default: `now()`]
  created_by           varchar(100)
  last_modified_at     timestamptz
  last_modified_by     varchar(100)
  indexes {
    (product_attribute_id, attribute_value_id) [unique]
  }
}

Table product.products [headercolor: #2E86AB] {
  id                uuid [pk]
  brand_id          uuid
  code              varchar(50) [not null, unique]
  name              varchar(255) [not null]
  name_en           varchar(300)
  slug              varchar(255) [not null, unique]
  short_description text
  description       text
  description_en    text
  tax_class         product.products_tax_class
  kind              product.products_kind [not null, default: 'STANDARD']
  status            product.products_status [not null, default: 'DRAFT']
  rejection_reason  text
  seo_title         varchar(255)
  seo_description   text
  submitted_by      uuid
  submitted_at      timestamptz
  approved_by       uuid
  approved_at       timestamptz
  published_at      timestamptz
  discontinued_at   timestamptz
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null, default: `now()`]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
}

Table product.variant_attribute_values [headercolor: #2E86AB] {
  id                          uuid [pk]
  variant_id                  uuid [not null]
  product_attribute_option_id uuid [not null]
  version                     bigint [not null, default: 0]
  created_at                  timestamptz [not null, default: `now()`]
  created_by                  varchar(100)
  last_modified_at            timestamptz
  last_modified_by            varchar(100)
  indexes {
    (variant_id, product_attribute_option_id) [unique]
  }
}

Table product.variants [headercolor: #2E86AB] {
  id                  uuid [pk]
  product_id          uuid [not null]
  sku                 varchar(64) [not null, unique]
  name                varchar(255) [not null]
  status              product.variants_status [not null, default: 'DRAFT']
  is_default          boolean [not null, default: false]
  attribute_signature varchar(512) [not null]
  position            int [not null, default: 0]
  obsoleted_at        timestamptz
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null, default: `now()`]
  created_by          varchar(100)
  last_modified_at    timestamptz
  last_modified_by    varchar(100)
  indexes {
    (product_id, attribute_signature) [unique]
  }
}

// =============================================================================
// SCHEMA: inventory
// =============================================================================

Table inventory.cycle_count [headercolor: #3E7C4A] {
  id               uuid [pk]
  count_number     varchar(30) [not null, unique]
  warehouse_id     uuid [not null]
  trigger_type     inventory.cycle_count_trigger_type [not null]
  status           inventory.cycle_count_status [not null, default: 'PLANNED']
  is_blind         boolean [not null, default: true]
  assigned_user_id uuid
  planned_date     date
  started_at       timestamptz
  completed_at     timestamptz
  note             varchar(1000)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table inventory.cycle_count_line [headercolor: #3E7C4A] {
  id               uuid [pk]
  cycle_count_id   uuid [not null]
  location_code    varchar(64) [not null]
  sku              varchar(64) [not null]
  lot_number       varchar(64)
  expected_qty     int [not null]
  counted_qty      int
  counted_by       uuid
  counted_at       timestamptz
  recount_required boolean [not null, default: false]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table inventory.inventory_items [headercolor: #3E7C4A] {
  id                        uuid [pk]
  sku                       varchar(64) [not null, unique]
  unit_of_measure           varchar(16) [not null, default: 'EACH']
  barcode                   varchar(64)
  weight_kg                 decimal(10,3)
  length_cm                 decimal(10,2)
  width_cm                  decimal(10,2)
  height_cm                 decimal(10,2)
  package_weight_kg         decimal(10,3)
  package_length_cm         decimal(10,2)
  package_width_cm          decimal(10,2)
  package_height_cm         decimal(10,2)
  package_count             int [not null, default: 1]
  pack_size                 int [not null, default: 1]
  storage_class             inventory.inventory_items_storage_class [not null, default: 'NORMAL']
  lot_tracked               boolean [not null, default: false]
  expiry_tracked            boolean [not null, default: false]
  serial_tracked            boolean [not null, default: false]
  min_qty                   int
  max_qty                   int
  reorder_point             int
  default_supplier_id       uuid
  requires_adult_signature  boolean [not null, default: false]
  shipping_restriction_note varchar(500)
  version                   bigint [not null, default: 0]
  created_at                timestamptz [not null, default: `now()`]
  created_by                varchar(100)
  last_modified_at          timestamptz
  last_modified_by          varchar(100)
  qc_required               boolean [not null, default: false]
}

Table inventory.stock_adjustment [headercolor: #3E7C4A] {
  id                  uuid [pk]
  adjustment_number   varchar(30) [not null, unique]
  location_code       varchar(64) [not null]
  sku                 varchar(64) [not null]
  lot_number          varchar(64)
  quantity_delta      int [not null]
  reason_code         inventory.stock_adjustment_reason_code [not null]
  note                varchar(1000)
  status              inventory.stock_adjustment_status [not null, default: 'PENDING_APPROVAL']
  cycle_count_line_id uuid
  requested_by        uuid [not null]
  decided_by          uuid
  decided_at          timestamptz
  rejection_reason    varchar(500)
  posted_at           timestamptz
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null, default: `now()`]
  created_by          varchar(100)
  last_modified_at    timestamptz
  last_modified_by    varchar(100)
}

Table inventory.stock_item [headercolor: #3E7C4A] {
  id               uuid [pk]
  sku              varchar(64) [not null]
  location_code    varchar(64) [not null]
  lot_number       varchar(64)
  expiry_date      date
  on_hand          int [not null, default: 0]
  reserved         int [not null, default: 0]
  status           inventory.stock_item_status [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table inventory.stock_movement [headercolor: #3E7C4A] {
  id                 uuid [pk]
  movement_type      inventory.stock_movement_movement_type [not null]
  sku                varchar(64) [not null]
  lot_number         varchar(64)
  from_location_code varchar(64)
  to_location_code   varchar(64)
  quantity           int [not null]
  from_status        varchar(32)
  to_status          varchar(32)
  reference_type     inventory.stock_movement_reference_type [not null]
  reference_id       uuid [not null]
  reason             varchar(500)
  actor_id           uuid
  occurred_at        timestamptz [not null]
  version            bigint [not null, default: 0]
  created_at         timestamptz [not null, default: `now()`]
  created_by         varchar(100)
  last_modified_at   timestamptz
  last_modified_by   varchar(100)
}

Table inventory.stock_reservation [headercolor: #3E7C4A] {
  id              uuid [pk]
  stock_item_id   uuid [not null]
  order_id        uuid [not null]
  root_request_id uuid [not null]
  request_id      uuid [not null, unique]
  quantity        int [not null]
  reserved_at     timestamptz [not null]
  expires_at      timestamptz [not null]
  status          inventory.stock_reservation_status [not null]
  release_reason  varchar(32)
  closed_at       timestamptz
}

Table inventory.transfer_order [headercolor: #3E7C4A] {
  id                uuid [pk]
  transfer_number   varchar(30) [not null, unique]
  from_warehouse_id uuid [not null]
  to_warehouse_id   uuid [not null]
  status            inventory.transfer_order_status [not null, default: 'DRAFT']
  reason            inventory.transfer_order_reason
  expected_date     date
  carrier           varchar(120)
  tracking_number   varchar(128)
  shipping_cost     decimal(18,2)
  submitted_by      uuid
  submitted_at      timestamptz
  approved_by       uuid
  approved_at       timestamptz
  dispatched_by     uuid
  dispatched_at     timestamptz
  received_at       timestamptz
  closed_at         timestamptz
  close_reason      varchar(500)
  cancel_reason     varchar(500)
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null, default: `now()`]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
}

Table inventory.transfer_order_line [headercolor: #3E7C4A] {
  id                uuid [pk]
  transfer_order_id uuid [not null]
  line_no           int [not null]
  sku               varchar(64) [not null]
  lot_number        varchar(64)
  requested_qty     int [not null]
  shipped_qty       int [not null, default: 0]
  received_qty      int [not null, default: 0]
  damaged_qty       int [not null, default: 0]
  received_by       uuid
  discrepancy_note  varchar(1000)
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null, default: `now()`]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
  indexes {
    (transfer_order_id, line_no) [unique]
  }
}

// =============================================================================
// SCHEMA: warehouse
// =============================================================================

Table warehouse.area [headercolor: #8E6C3A] {
  id               uuid [pk]
  warehouse_id     uuid [not null]
  location_id      uuid [unique]
  code             varchar(20) [not null]
  type             warehouse.area_type [not null]
  name             varchar(200) [not null]
  x                decimal(10,3) [not null]
  y                decimal(10,3) [not null]
  width            decimal(10,3) [not null]
  length           decimal(10,3) [not null]
  rotation         int [not null]
  is_obstacle      boolean [not null]
  status           warehouse.area_status [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (warehouse_id, code) [unique]
  }
}

Table warehouse.bin [headercolor: #8E6C3A] {
  id                     uuid [pk]
  level_id               uuid [not null]
  location_id            uuid [not null, unique]
  code                   varchar(20) [not null]
  description            varchar(1000)
  x                      decimal(10,3) [not null]
  y                      decimal(10,3) [not null]
  width                  decimal(10,3) [not null]
  length                 decimal(10,3) [not null]
  rotation               int [not null]
  type                   warehouse.bin_type [not null]
  storage_class_override warehouse.bin_storage_class_override
  version                bigint [not null, default: 0]
  created_at             timestamptz [not null, default: `now()`]
  created_by             varchar(100)
  last_modified_at       timestamptz
  last_modified_by       varchar(100)
  indexes {
    (level_id, code) [unique]
  }
}

Table warehouse.boundary [headercolor: #8E6C3A] {
  id                 uuid [pk]
  warehouse_id       uuid [not null]
  type               warehouse.boundary_type [not null]
  start_x            decimal(10,3) [not null]
  start_y            decimal(10,3) [not null]
  end_x              decimal(10,3) [not null]
  end_y              decimal(10,3) [not null]
  is_passable        boolean [not null]
  operational_status varchar(32)
  version            bigint [not null, default: 0]
  created_at         timestamptz [not null, default: `now()`]
  created_by         varchar(100)
  last_modified_at   timestamptz
  last_modified_by   varchar(100)
}

Table warehouse.move_task [headercolor: #8E6C3A] {
  id               uuid [pk]
  task_number      varchar(30) [not null, unique]
  warehouse_id     uuid [not null]
  origin           warehouse.move_task_origin [not null]
  reason           warehouse.move_task_reason
  sku              varchar(64) [not null]
  lot_number       varchar(64)
  from_location_id uuid [not null]
  to_location_id   uuid [not null]
  requested_qty    int [not null]
  picked_qty       int
  placed_qty       int
  status           warehouse.move_task_status [not null, default: 'PENDING']
  priority         int [not null, default: 0]
  assigned_user_id uuid
  approved_by      uuid
  started_at       timestamptz
  completed_at     timestamptz
  note             varchar(1000)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  receipt_line_id  uuid
}

Table warehouse.putaway_task [headercolor: #8E6C3A] {
  id                     uuid [pk]
  goods_receipt_id       uuid
  sku                    varchar(64) [not null]
  quantity               int [not null]
  target_location_id     uuid
  status                 warehouse.putaway_task_status [not null]
  version                bigint [not null, default: 0]
  created_at             timestamptz [not null]
  created_by             varchar(100)
  last_modified_at       timestamptz
  last_modified_by       varchar(100)
  goods_receipt_line_id  uuid
  transfer_order_line_id uuid
  return_request_line_id uuid
}

Table warehouse.shelf [headercolor: #8E6C3A] {
  id                    uuid [pk]
  warehouse_id          uuid [not null]
  zone_id               uuid
  code                  varchar(20) [not null]
  name                  varchar(200) [not null]
  description           varchar(1000)
  x                     decimal(10,3) [not null]
  y                     decimal(10,3) [not null]
  width                 decimal(10,3) [not null]
  length                decimal(10,3) [not null]
  rotation              int [not null]
  is_obstacle           boolean [not null]
  pick_north            boolean [not null]
  pick_east             boolean [not null]
  pick_south            boolean [not null]
  pick_west             boolean [not null]
  default_storage_class warehouse.shelf_default_storage_class [not null]
  status                warehouse.shelf_status [not null]
  version               bigint [not null, default: 0]
  created_at            timestamptz [not null, default: `now()`]
  created_by            varchar(100)
  last_modified_at      timestamptz
  last_modified_by      varchar(100)
  indexes {
    (warehouse_id, code) [unique]
  }
}

Table warehouse.shelf_level [headercolor: #8E6C3A] {
  id               uuid [pk]
  shelf_id         uuid [not null]
  level_index      int [not null]
  elevation        decimal(10,3)
  usable_height    decimal(10,3)
  max_weight       decimal(10,3)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (shelf_id, level_index) [unique]
  }
}

Table warehouse.slotting_rule [headercolor: #8E6C3A] {
  id               uuid [pk]
  warehouse_id     uuid [not null]
  name             varchar(200) [not null]
  criteria         varchar(2000)
  priority         int [not null, default: 0]
  active           boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table warehouse.storage_location [headercolor: #8E6C3A] {
  id                uuid [pk]
  warehouse_id      uuid [not null]
  kind              warehouse.storage_location_kind [not null]
  location_code     varchar(64) [not null, unique]
  storage_class     warehouse.storage_location_storage_class [not null]
  capacity_units    int
  max_weight        decimal(10,3)
  is_pickable       boolean [not null]
  is_putaway_target boolean [not null]
  status            warehouse.storage_location_status [not null]
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null, default: `now()`]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
}

Table warehouse.warehouse [headercolor: #8E6C3A] {
  id               uuid [pk]
  name             varchar(200) [not null]
  status           warehouse.warehouse_status [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  prefix           varchar(10) [not null, unique]
  address          varchar(500) [not null]
  return_address   varchar(500)
  map_unit         varchar(8) [not null]
  map_width        decimal(10,3) [not null]
  map_height       decimal(10,3) [not null]
}

Table warehouse.zone [headercolor: #8E6C3A] {
  id               uuid [pk]
  warehouse_id     uuid [not null]
  name             varchar(100) [not null]
  color            varchar(7)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (warehouse_id, name) [unique]
  }
}

// =============================================================================
// SCHEMA: procurement
// =============================================================================

Table procurement.approval_limits [headercolor: #7D5BA6] {
  id               uuid [pk]
  role_id          uuid [not null]
  currency         varchar(3) [not null, default: 'VND']
  max_po_amount    decimal(18,2) [not null]
  effective_from   date [not null]
  effective_to     date
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table procurement.goods_receipt_lines [headercolor: #7D5BA6] {
  id                uuid [pk]
  receipt_id        uuid [not null]
  po_line_id        uuid [not null]
  inventory_item_id uuid [not null]
  location_id       uuid [not null]
  received_qty      decimal(18,3) [not null]
  lot_number        varchar(64)
  expiry_date       date
  note              varchar(255)
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null, default: `now()`]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
  qc_required       boolean [not null, default: false]
  qc_location_id    uuid
  moved_to_qc_at    timestamptz
  moved_to_qc_by    uuid
}

Table procurement.goods_receipts [headercolor: #7D5BA6] {
  id               uuid [pk]
  receipt_number   varchar(30) [not null, unique]
  po_id            uuid [not null]
  po_revision_id   uuid [not null]
  warehouse_id     uuid [not null]
  status           procurement.goods_receipts_status [not null, default: 'DRAFT']
  received_at      timestamptz [not null]
  received_by      uuid [not null]
  confirmed_at     timestamptz
  confirmed_by     uuid
  delivery_note    varchar(100)
  note             text
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  closed_at        timestamptz
}

Table procurement.po_number_sequence [headercolor: #7D5BA6] {
  sequence_date date [pk]
  last_value    bigint [not null, default: 0]
}

Table procurement.purchase_order_approvals [headercolor: #7D5BA6] {
  id               uuid [pk]
  po_revision_id   uuid [not null]
  step_no          int [not null, default: 1]
  approver_id      uuid [not null]
  decision         procurement.purchase_order_approvals_decision [not null]
  decision_at      timestamptz [not null, default: `now()`]
  reason           varchar(500)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (po_revision_id, step_no) [unique]
  }
}

Table procurement.purchase_order_attachments [headercolor: #7D5BA6] {
  id               uuid [pk]
  po_id            uuid [not null]
  file_name        varchar(255) [not null]
  file_url         text [not null]
  file_type        varchar(20)
  category         procurement.purchase_order_attachments_category [not null, default: 'OTHER']
  file_size        int
  uploaded_by      uuid [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table procurement.purchase_order_events [headercolor: #7D5BA6] {
  id               uuid [pk]
  po_id            uuid [not null]
  po_revision_id   uuid
  action           procurement.purchase_order_events_action [not null]
  actor_id         uuid
  from_status      varchar(20)
  to_status        varchar(20)
  reason           varchar(500)
  payload          jsonb
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table procurement.purchase_order_line_revisions [headercolor: #7D5BA6] {
  id                   uuid [pk]
  po_line_id           uuid [not null]
  po_revision_id       uuid [not null]
  inventory_item_id    uuid [not null]
  uom                  varchar(20) [not null]
  ordered_qty          decimal(18,3) [not null]
  unit_price           decimal(18,2) [not null]
  tax_rate             decimal(5,2) [not null]
  discount_rate        decimal(5,2) [not null]
  line_subtotal        decimal(18,2) [not null, default: 0]
  line_discount_amount decimal(18,2) [not null, default: 0]
  line_net             decimal(18,2) [not null, default: 0]
  line_tax             decimal(18,2) [not null, default: 0]
  line_total           decimal(18,2) [not null, default: 0]
  note                 varchar(255)
  version              bigint [not null, default: 0]
  created_at           timestamptz [not null, default: `now()`]
  created_by           varchar(100)
  last_modified_at     timestamptz
  last_modified_by     varchar(100)
  indexes {
    (po_line_id, po_revision_id) [unique]
  }
}

Table procurement.purchase_order_lines [headercolor: #7D5BA6] {
  id                   uuid [pk]
  po_id                uuid [not null]
  po_revision_id       uuid
  line_no              int [not null]
  inventory_item_id    uuid [not null]
  uom                  varchar(20) [not null, default: 'EACH']
  ordered_qty          decimal(18,3) [not null]
  unit_price           decimal(18,2) [not null]
  tax_rate             decimal(5,2) [not null, default: 0]
  discount_rate        decimal(5,2) [not null, default: 0]
  line_subtotal        decimal(18,2) [not null, default: 0]
  line_discount_amount decimal(18,2) [not null, default: 0]
  line_net             decimal(18,2) [not null, default: 0]
  line_tax             decimal(18,2) [not null, default: 0]
  line_total           decimal(18,2) [not null, default: 0]
  status               procurement.purchase_order_lines_status [not null, default: 'OPEN']
  note                 varchar(255)
  version              bigint [not null, default: 0]
  created_at           timestamptz [not null, default: `now()`]
  created_by           varchar(100)
  last_modified_at     timestamptz
  last_modified_by     varchar(100)
  indexes {
    (po_id, line_no) [unique]
  }
}

Table procurement.purchase_order_revisions [headercolor: #7D5BA6] {
  id               uuid [pk]
  po_id            uuid [not null]
  revision_no      bigint [not null]
  kind             procurement.purchase_order_revisions_kind [not null, default: 'INITIAL']
  snapshot_header  jsonb [not null]
  change_summary   varchar(500)
  changed_at       timestamptz [not null, default: `now()`]
  changed_by       uuid [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (po_id, revision_no) [unique]
  }
}

Table procurement.purchase_orders [headercolor: #7D5BA6] {
  id                  uuid [pk]
  po_number           varchar(30) [not null, unique]
  revision_no         bigint [not null, default: 0]
  status              procurement.purchase_orders_status [not null, default: 'DRAFT']
  supplier_id         uuid [not null]
  warehouse_id        uuid [not null]
  currency            varchar(3) [not null]
  order_date          date [not null]
  expected_date       date
  payment_terms       varchar(50)
  incoterms           varchar(10)
  subtotal            decimal(18,2) [not null, default: 0]
  discount_total      decimal(18,2) [not null, default: 0]
  tax_total           decimal(18,2) [not null, default: 0]
  shipping_fee        decimal(18,2) [not null, default: 0]
  total_amount        decimal(18,2) [not null, default: 0]
  active_revision_id  uuid
  pending_revision_id uuid
  source_proposal_id  uuid
  note                text
  close_kind          procurement.purchase_orders_close_kind
  close_reason        varchar(255)
  cancel_reason       varchar(255)
  submitted_at        timestamptz
  submitted_by        uuid
  approved_at         timestamptz
  approved_by         uuid
  confirmed_at        timestamptz
  confirmed_by        uuid
  closed_at           timestamptz
  closed_by           uuid
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null, default: `now()`]
  created_by          varchar(100)
  last_modified_at    timestamptz
  last_modified_by    varchar(100)
  po_type             procurement.purchase_orders_po_type [not null, default: 'STANDARD']
  production_order_id uuid
}

Table procurement.qc_inspections [headercolor: #7D5BA6] {

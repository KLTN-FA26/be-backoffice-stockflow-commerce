  created_at                    timestamptz [not null, default: `now()`]
  created_by                    varchar(100)
  last_modified_at              timestamptz
  last_modified_by              varchar(100)
  order_number                  varchar(32) [not null]
  request_id                    uuid [not null, unique]
  channel                       ordering.return_request_channel [not null]
  requested_by                  uuid [not null]
  requested_resolution          ordering.return_request_requested_resolution [not null]
  currency                      varchar(3) [not null, default: 'VND']
  decision_note                 varchar(1000)
  return_required               boolean
  return_deadline               timestamptz
  received_by                   uuid
  receiving_location_code       varchar(64)
  receipt_note                  varchar(1000)

{
  "includeCoAuthoredBy": false,
  "permissions": {
"allow": [
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin refactor/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push -u origin test/*)",
      "Bash(git push)"
    ],
    "deny": [
      "Read(./target/**)",
      "Read(./.git/**)",
      "Read(./.idea/**)",
      "Read(./.vscode/**)",
      "Read(./.local-storage/**)",
      "Read(./.mvn/wrapper/*.jar)",
      "Read(./**/*.log)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./deploy/certs/**)",
      "Read(./deploy/auth/**)",
      "Read(./deploy/backups/**)",
      "Read(./tools/db/seed/seed_test_data.sql)",
      "Read(./docs/business-design/stockflow-dataflow.drawio)",
      "Read(./**/*.drawio)",
      "Read(./**/*.png)",
      "Read(./**/*.jpg)",
      "Read(./**/*.pdf)",
      "Read(./**/*.docx)",
      "Read(./**/*.xlsx)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-feature-branch.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify.sh hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify.sh hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify-cloud-setup.sh",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify.sh hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

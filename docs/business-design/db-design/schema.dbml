  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table ordering.order_status_transition [headercolor: #C0392B] {
  from_status varchar(32) [not null]
  to_status   varchar(32) [not null]
  indexes {
    (from_status, to_status) [pk]
  }
}

Table ordering.quote [headercolor: #C0392B] {
  id                      uuid [pk]
  quote_number            varchar(30) [not null, unique]
  request_id              uuid [not null, unique]
  customer_id             uuid [not null]
  status                  ordering.quote_status [not null]
  revision                int [not null, default: 1]
  payment_term            ordering.quote_payment_term [not null]
  deposit_percent         decimal(5,2)
  valid_until             timestamptz [not null]
  terms                   varchar(2000)
  sent_at                 timestamptz
  sent_by                 uuid
  responded_at            timestamptz
  responded_by            uuid
  customer_feedback       varchar(2000)
  cancellation_reason     varchar(500)
  converted_order_id      uuid [unique]
  converted_at            timestamptz
  version                 bigint [not null, default: 0]
  created_at              timestamptz [not null, default: `now()`]
  created_by              varchar(100)
  last_modified_at        timestamptz
  last_modified_by        varchar(100)
  requested_delivery_date date
}

Table ordering.quote_line [headercolor: #C0392B] {
  id                  uuid [pk]
  quote_id            uuid [not null]
  line_no             int [not null]
  blank_sku           varchar(64) [not null]
  design_snapshot_id  uuid [not null]
  print_spec          varchar(2000)
  quantity            int [not null]
  accepted_quantity   int

  tolerance_blanks        int [not null]
  excess_loss             int [not null]
  deduction_per_blank     decimal(18,2)
  deduction_amount        decimal(18,2) [not null, default: 0]
  cancellation_fee        decimal(18,2) [not null, default: 0]
  cancellation_fee_reason varchar(1000)

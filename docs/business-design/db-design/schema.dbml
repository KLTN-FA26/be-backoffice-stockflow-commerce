// =============================================================================
// SCHEMA: production
// =============================================================================

Table production.production_order [headercolor: #E67E22] {
  id                     uuid [pk]
  order_number           varchar(30) [not null, unique]
  type                   production.production_order_type [not null]
  mode                   production.production_order_mode [not null, default: 'IN_HOUSE']
  status                 production.production_order_status [not null]
  status_before_hold     production.production_order_status_before_hold
  hold_reason            production.production_order_hold_reason
  hold_note              varchar(1000)

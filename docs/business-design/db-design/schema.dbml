  indexes {
    (quote_id, line_no) [unique]
  }
}

Table ordering.quote_price_tier [headercolor: #C0392B] {
  quote_line_id uuid [not null]
  min_quantity  int [not null]
  unit_price    decimal(19,4) [not null]

// =============================================================================
// SCHEMA: product
// =============================================================================

Table product.attribute_values [headercolor: #2E86AB] {
  id               uuid [pk]
  attribute_id     uuid [not null]
  code             varchar(50) [not null]
  label            varchar(255) [not null]
  value_number     decimal(18,4)
  hex_color        varchar(7)
  sort_order       int [not null, default: 0]
  is_active        boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (attribute_id, code) [unique]
  }
}

Table product.attributes [headercolor: #2E86AB] {
  id               uuid [pk]
  code             varchar(50) [not null, unique]
  name             varchar(255) [not null]
  data_type        product.attributes_data_type [not null]
  unit             varchar(20)
  is_filterable    boolean [not null, default: false]
  is_searchable    boolean [not null, default: false]
  sort_order       int [not null, default: 0]
  is_active        boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table product.brands [headercolor: #2E86AB] {
  id               uuid [pk]
  code             varchar(50) [not null, unique]
  name             varchar(255) [not null]
  slug             varchar(255) [not null, unique]
  logo_url         text
  is_active        boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table product.categories [headercolor: #2E86AB] {
  id               uuid [pk]
  parent_id        uuid
  code             varchar(50) [not null, unique]
  name             varchar(255) [not null]
  slug             varchar(255) [not null, unique]
  path             text [not null]
  depth            int [not null, default: 0]
  sort_order       int [not null, default: 0]
  image_url        text
  seo_title        varchar(255)
  seo_description  text
  is_active        boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table product.category_attributes [headercolor: #2E86AB] {
  id               uuid [pk]
  category_id      uuid [not null]
  attribute_id     uuid [not null]
  default_role     product.category_attributes_default_role [not null]
  is_required      boolean [not null, default: false]
  sort_order       int [not null, default: 0]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (category_id, attribute_id) [unique]
  }
}

Table product.customization_templates [headercolor: #2E86AB] {
  id                     uuid [pk]
  variant_id             uuid [not null]
  code                   varchar(50) [not null]
  name                   varchar(255) [not null]
  min_dpi                int [not null, default: 300]
  color_mode             product.customization_templates_color_mode [not null, default: 'CMYK']
  allowed_file_formats   text[] [not null]
  max_file_size_mb       int [not null]
  max_colors             int
  allowed_font_codes     text[]
  is_active              boolean [not null, default: false]
  version                bigint [not null, default: 0]
  created_at             timestamptz [not null, default: `now()`]
  created_by             varchar(100)
  last_modified_at       timestamptz
  last_modified_by       varchar(100)
  model_params_json      jsonb
  reference_file_key     varchar(500)
  reference_file_name    varchar(255)
  reference_content_type varchar(100)
  model_file_key         varchar(500)
  model_file_name        varchar(255)
  model_file_checksum    varchar(64)
  model_surfaces_json    jsonb [not null, default: `'[]'::jsonb`]
  indexes {
    (variant_id, code) [unique]
  }
}

Table product.media [headercolor: #2E86AB] {
  id               uuid [pk]
  variant_id       uuid [not null]
  kind             product.media_kind [not null, default: 'IMAGE']
  url              text
  storage_key      varchar(500) [unique]
  original_name    varchar(255)
  content_type     varchar(100)
  size_bytes       bigint
  checksum         varchar(64)
  stored_at        timestamptz
  renditions       jsonb [not null, default: `'[]'::jsonb`]
  upload_key       varchar(300)
  alt_text         varchar(255)
  sort_order       int [not null, default: 0]
  is_primary       boolean [not null, default: false]
  is_published     boolean [not null, default: false]
  published_at     timestamptz
  published_by     uuid
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table product.print_areas [headercolor: #2E86AB] {
  id               uuid [pk]
  template_id      uuid [not null]
  code             product.print_areas_code [not null]
  name             varchar(255) [not null]
  x_mm             decimal(10,2) [not null]
  y_mm             decimal(10,2) [not null]
  width_mm         decimal(10,2) [not null]
  height_mm        decimal(10,2) [not null]
  safe_margin_mm   decimal(10,2) [not null, default: 0]
  bleed_mm         decimal(10,2) [not null, default: 0]
  shape_json       jsonb [not null]
  uv_mapping_json  jsonb [not null]
  sort_order       int [not null, default: 0]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (template_id, code) [unique]
  }
}

Table product.product_attribute_options [headercolor: #2E86AB] {
  id                   uuid [pk]
  product_attribute_id uuid [not null]
  attribute_value_id   uuid [not null]
  version              bigint [not null, default: 0]
  created_at           timestamptz [not null, default: `now()`]
  created_by           varchar(100)
  last_modified_at     timestamptz
  last_modified_by     varchar(100)
  indexes {
    (product_attribute_id, attribute_value_id) [unique]
  }
}

Table product.product_attributes [headercolor: #2E86AB] {
  id               uuid [pk]
  product_id       uuid [not null]
  attribute_id     uuid [not null]
  role             product.product_attributes_role [not null]
  sort_order       int [not null, default: 0]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (product_id, attribute_id) [unique]
  }
}

Table product.product_categories [headercolor: #2E86AB] {
  id               uuid [pk]
  product_id       uuid [not null]
  category_id      uuid [not null]
  is_primary       boolean [not null, default: false]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (product_id, category_id) [unique]
  }
}

Table product.product_change_log [headercolor: #2E86AB] {
  id             uuid [pk]
  product_id     uuid [not null]
  change_type    varchar(32) [not null]
  subject_type   varchar(20) [not null, default: 'PRODUCT']
  subject_id     uuid
  from_status    varchar(32)
  to_status      varchar(32)
  reason         varchar(500)
  changed_fields text[] [not null, default: `'{}'::text[]`]
  actor_id       uuid
  occurred_at    timestamptz [not null, default: `now()`]
}

Table product.product_descriptive_values [headercolor: #2E86AB] {
  id                   uuid [pk]
  product_attribute_id uuid [not null]
  attribute_value_id   uuid
  value_text           text
  value_number         decimal(18,4)
  value_boolean        boolean
  version              bigint [not null, default: 0]
  created_at           timestamptz [not null, default: `now()`]
  created_by           varchar(100)
  last_modified_at     timestamptz
  last_modified_by     varchar(100)
  indexes {
    (product_attribute_id, attribute_value_id) [unique]
  }
}

Table product.products [headercolor: #2E86AB] {
  id                 uuid [pk]
  brand_id           uuid
  code               varchar(50) [not null, unique]
  name               varchar(255) [not null]
  name_en            varchar(300)
  slug               varchar(255) [not null, unique]
  short_description  text
  description        text
  description_en     text
  tax_class          product.products_tax_class
  kind               varchar(16) [not null, default: 'CUSTOMIZABLE']
  status             product.products_status [not null, default: 'DRAFT']
  rejection_reason   text
  seo_title          varchar(255)
  seo_description    text
  submitted_by       uuid
  submitted_at       timestamptz
  approved_by        uuid
  approved_at        timestamptz
  published_at       timestamptz
  discontinued_at    timestamptz
  version            bigint [not null, default: 0]
  created_at         timestamptz [not null, default: `now()`]
  created_by         varchar(100)
  last_modified_at   timestamptz
  last_modified_by   varchar(100)
  ever_published     boolean [not null, default: false]
  discontinue_reason varchar(500)
  suspended_at       timestamptz
  suspend_reason     varchar(500)
  self_approved      boolean [not null, default: false]
}

Table product.variant_attribute_values [headercolor: #2E86AB] {
  id                          uuid [pk]
  variant_id                  uuid [not null]
  product_attribute_option_id uuid [not null]
  version                     bigint [not null, default: 0]
  created_at                  timestamptz [not null, default: `now()`]
  created_by                  varchar(100)
  last_modified_at            timestamptz
  last_modified_by            varchar(100)
  indexes {
    (variant_id, product_attribute_option_id) [unique]
  }
}

Table product.variant_sales_units [headercolor: #2E86AB] {
  id                uuid [pk]
  variant_id        uuid [not null]
  uom_conversion_id uuid [not null]
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null, default: `now()`]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
  indexes {
    (variant_id, uom_conversion_id) [unique]
  }
}

Table product.variants [headercolor: #2E86AB] {
  id                  uuid [pk]
  product_id          uuid [not null]
  sku                 varchar(64) [not null, unique]
  name                varchar(255) [not null]
  status              product.variants_status [not null, default: 'DRAFT']
  is_default          boolean [not null, default: false]
  attribute_signature varchar(512) [not null]
  position            int [not null, default: 0]
  obsoleted_at        timestamptz
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null, default: `now()`]
  created_by          varchar(100)
  last_modified_at    timestamptz
  last_modified_by    varchar(100)
  owner_customer_id   uuid
  design_snapshot_id  uuid
  source_variant_id   uuid
  indexes {
    (product_id, attribute_signature) [unique]
  }
}

// =============================================================================
// SCHEMA: inventory
// =============================================================================

Table inventory.cycle_count [headercolor: #3E7C4A] {
  id               uuid [pk]
  count_number     varchar(30) [not null, unique]
  warehouse_id     uuid [not null]
  trigger_type     inventory.cycle_count_trigger_type [not null]
  status           inventory.cycle_count_status [not null, default: 'PLANNED']
  is_blind         boolean [not null, default: true]
  assigned_user_id uuid
  planned_date     date
  started_at       timestamptz
  completed_at     timestamptz
  note             varchar(1000)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table inventory.cycle_count_line [headercolor: #3E7C4A] {
  id               uuid [pk]
  cycle_count_id   uuid [not null]
  location_code    varchar(64) [not null]
  sku              varchar(64) [not null]
  lot_number       varchar(64)
  expected_qty     int [not null]
  counted_qty      int
  counted_by       uuid
  counted_at       timestamptz
  recount_required boolean [not null, default: false]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  stock_package_id uuid
}

Table inventory.inventory_items [headercolor: #3E7C4A] {
  id                uuid [pk]
  sku               varchar(64) [not null, unique]
  unit_of_measure   varchar(16) [not null, default: 'EACH']
  barcode           varchar(64)
  weight_kg         decimal(10,3)
  length_cm         decimal(10,2)
  width_cm          decimal(10,2)
  height_cm         decimal(10,2)
  package_weight_kg decimal(10,3)
  package_length_cm decimal(10,2)
  package_width_cm  decimal(10,2)
  package_height_cm decimal(10,2)
  package_count     int [not null, default: 1]
  pack_size         int [not null, default: 1]
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null, default: `now()`]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
  rotatable         boolean [not null, default: true]
}

Table inventory.stock_adjustment [headercolor: #3E7C4A] {
  id                  uuid [pk]
  adjustment_number   varchar(30) [not null, unique]
  location_code       varchar(64) [not null]
  sku                 varchar(64) [not null]
  lot_number          varchar(64)
  quantity_delta      int [not null]
  reason_code         inventory.stock_adjustment_reason_code [not null]
  note                varchar(1000)
  status              inventory.stock_adjustment_status [not null, default: 'PENDING_APPROVAL']
  cycle_count_line_id uuid
  requested_by        uuid [not null]
  decided_by          uuid
  decided_at          timestamptz
  rejection_reason    varchar(500)
  posted_at           timestamptz
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null, default: `now()`]
  created_by          varchar(100)
  last_modified_at    timestamptz
  last_modified_by    varchar(100)
  withdrawn_at        timestamptz
  received_at         timestamptz
  reservation_id      uuid
  stock_package_id    uuid
  counted_by          uuid
}

Table inventory.stock_item [headercolor: #3E7C4A] {
  id               uuid [pk]
  sku              varchar(64) [not null]
  location_code    varchar(64) [not null]
  lot_number       varchar(64) [not null]
  on_hand          int [not null, default: 0]
  reserved         int [not null, default: 0]
  status           inventory.stock_item_status [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  received_at      timestamptz
  stock_package_id uuid
  lot_id           uuid [not null]
}

Table inventory.stock_lot [headercolor: #3E7C4A] {
  id                    uuid [pk]
  sku                   varchar(64) [not null]
  lot_number            varchar(64)
  received_at           timestamptz
  origin_type           inventory.stock_lot_origin_type [not null]
  goods_receipt_id      uuid
  goods_receipt_number  varchar(30)
  warehouse_id          uuid
  version               bigint [not null, default: 0]
  created_at            timestamptz [not null, default: `now()`]
  created_by            varchar(100)
  last_modified_at      timestamptz
  last_modified_by      varchar(100)
  production_order_id   uuid
  production_order_code varchar(32)
}

Table inventory.stock_movement [headercolor: #3E7C4A] {
  id                    uuid [pk]
  movement_type         inventory.stock_movement_movement_type [not null]
  sku                   varchar(64) [not null]
  lot_number            varchar(64)
  from_location_code    varchar(64)
  to_location_code      varchar(64)
  quantity              int [not null]
  from_status           varchar(32)
  to_status             varchar(32)
  reference_type        inventory.stock_movement_reference_type [not null]
  reference_id          uuid [not null]
  reason                varchar(500)
  actor_id              uuid
  occurred_at           timestamptz [not null]
  version               bigint [not null, default: 0]
  created_at            timestamptz [not null, default: `now()`]
  created_by            varchar(100)
  last_modified_at      timestamptz
  last_modified_by      varchar(100)
  from_stock_package_id uuid
  to_stock_package_id   uuid
  lot_id                uuid
  order_id              uuid
  order_number          varchar(32)
  requested_by          uuid
  counted_by            uuid
}

Table inventory.stock_package [headercolor: #3E7C4A] {
  id                    uuid [pk]
  lpn                   varchar(30) [not null, unique]
  inventory_item_id     uuid [not null]
  uom_conversion_id     uuid [not null]
  nominal_qty           int [not null]
  received_qty          int
  location_code         varchar(64) [not null]
  status                inventory.stock_package_status [not null, default: 'RECEIVING']
  goods_receipt_line_id uuid
  closed_at             timestamptz
  version               bigint [not null, default: 0]
  created_at            timestamptz [not null, default: `now()`]
  created_by            varchar(100)
  last_modified_at      timestamptz
  last_modified_by      varchar(100)
}

Table inventory.stock_reservation [headercolor: #3E7C4A] {
  id                uuid [pk]
  stock_item_id     uuid
  order_id          uuid [not null]
  root_request_id   uuid [not null]
  request_id        uuid [not null, unique]
  quantity          int [not null]
  reserved_at       timestamptz [not null]
  expires_at        timestamptz
  status            inventory.stock_reservation_status [not null]
  release_reason    varchar(32)
  closed_at         timestamptz
  sku               varchar(64) [not null]
  allocated_from_id uuid
  order_number      varchar(32)
  warehouse_code    varchar(64)
}

Table inventory.uom_conversions [headercolor: #3E7C4A] {
  id                uuid [pk]
  inventory_item_id uuid [not null]
  unit_of_measure   varchar(16) [not null]
  factor            int [not null]
  is_base           boolean [not null, default: false]
  weight_kg         decimal(10,3)
  length_cm         decimal(10,2)
  width_cm          decimal(10,2)
  height_cm         decimal(10,2)
  default_purchase  boolean [not null, default: false]
  active            boolean [not null, default: true]
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null, default: `now()`]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
  default_shipping  boolean [not null, default: false]
  indexes {
    (inventory_item_id, unit_of_measure) [unique]
  }
}

// =============================================================================
// SCHEMA: warehouse
// =============================================================================

Table warehouse.area [headercolor: #8E6C3A] {
  id               uuid [pk]
  warehouse_id     uuid [not null]
  location_id      uuid [unique]
  code             varchar(20) [not null]
  type             warehouse.area_type [not null]
  name             varchar(200) [not null]
  x                decimal(10,3) [not null]
  y                decimal(10,3) [not null]
  width            decimal(10,3) [not null]
  length           decimal(10,3) [not null]
  rotation         int [not null]
  is_obstacle      boolean [not null]
  status           warehouse.area_status [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (warehouse_id, code) [unique]
  }
}

Table warehouse.bin [headercolor: #8E6C3A] {
  id               uuid [pk]
  level_id         uuid [not null]
  location_id      uuid [not null, unique]
  code             varchar(20) [not null]
  description      varchar(1000)
  x                decimal(10,3) [not null]
  y                decimal(10,3) [not null]
  width            decimal(10,3) [not null]
  length           decimal(10,3) [not null]
  rotation         int [not null]
  type             warehouse.bin_type [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (level_id, code) [unique]
  }
}

Table warehouse.boundary [headercolor: #8E6C3A] {
  id                 uuid [pk]
  warehouse_id       uuid [not null]
  type               warehouse.boundary_type [not null]
  start_x            decimal(10,3) [not null]
  start_y            decimal(10,3) [not null]
  end_x              decimal(10,3) [not null]
  end_y              decimal(10,3) [not null]
  is_passable        boolean [not null]
  operational_status varchar(32)
  version            bigint [not null, default: 0]
  created_at         timestamptz [not null, default: `now()`]
  created_by         varchar(100)
  last_modified_at   timestamptz
  last_modified_by   varchar(100)
}

Table warehouse.move_task [headercolor: #8E6C3A] {
  id               uuid [pk]
  task_number      varchar(30) [not null, unique]
  warehouse_id     uuid [not null]
  origin           warehouse.move_task_origin [not null]
  reason           warehouse.move_task_reason
  sku              varchar(64) [not null]
  lot_number       varchar(64)
  from_location_id uuid [not null]
  to_location_id   uuid [not null]
  requested_qty    int [not null]
  picked_qty       int
  placed_qty       int
  status           warehouse.move_task_status [not null, default: 'PENDING']
  priority         int [not null, default: 0]
  assigned_user_id uuid
  approved_by      uuid
  started_at       timestamptz
  completed_at     timestamptz
  note             varchar(1000)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table warehouse.putaway_task [headercolor: #8E6C3A] {
  id                    uuid [pk]
  goods_receipt_id      uuid
  sku                   varchar(64) [not null]
  quantity              int [not null]
  target_location_id    uuid
  status                warehouse.putaway_task_status [not null]
  version               bigint [not null, default: 0]
  created_at            timestamptz [not null]
  created_by            varchar(100)
  last_modified_at      timestamptz
  last_modified_by      varchar(100)
  goods_receipt_line_id uuid
  stock_package_id      uuid
  source                varchar(32) [not null, default: 'RECEIPT']
}

Table warehouse.putaway_trip [headercolor: #8E6C3A] {
  id                uuid [pk]
  warehouse_id      uuid [not null]
  operator_id       uuid [not null]
  status            warehouse.putaway_trip_status [not null]
  start_location_id uuid
  started_at        timestamptz
  last_activity_at  timestamptz [not null]
  closed_at         timestamptz
  closed_by         uuid
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
}

Table warehouse.putaway_trip_item [headercolor: #8E6C3A] {
  id                   uuid [pk]
  trip_id              uuid [not null]
  putaway_task_id      uuid [not null]
  status               warehouse.putaway_trip_item_status [not null]
  assigned_location_id uuid
  stop_sequence        int
  hold_released_at     timestamptz
  loaded_at            timestamptz [not null]
  placed_at            timestamptz
  version              bigint [not null, default: 0]
  created_at           timestamptz [not null]
  created_by           varchar(100)
  last_modified_at     timestamptz
  last_modified_by     varchar(100)
  indexes {
    (trip_id, putaway_task_id) [unique]
  }
}

Table warehouse.shelf [headercolor: #8E6C3A] {
  id               uuid [pk]
  warehouse_id     uuid [not null]
  zone_id          uuid
  code             varchar(20) [not null]
  name             varchar(200) [not null]
  description      varchar(1000)
  x                decimal(10,3) [not null]
  y                decimal(10,3) [not null]
  width            decimal(10,3) [not null]
  length           decimal(10,3) [not null]
  rotation         int [not null]
  is_obstacle      boolean [not null]
  pick_north       boolean [not null]
  pick_east        boolean [not null]
  pick_south       boolean [not null]
  pick_west        boolean [not null]
  status           warehouse.shelf_status [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (warehouse_id, code) [unique]
  }
}

Table warehouse.shelf_level [headercolor: #8E6C3A] {
  id               uuid [pk]
  shelf_id         uuid [not null]
  level_index      int [not null]
  elevation        decimal(10,3)
  usable_height    decimal(10,3)
  max_weight       decimal(10,3)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (shelf_id, level_index) [unique]
  }
}

Table warehouse.slotting_rule [headercolor: #8E6C3A] {
  id               uuid [pk]
  warehouse_id     uuid [not null]
  name             varchar(200) [not null]
  criteria         varchar(2000)
  priority         int [not null, default: 0]
  active           boolean [not null, default: true]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table warehouse.storage_location [headercolor: #8E6C3A] {
  id                uuid [pk]
  warehouse_id      uuid [not null]
  kind              warehouse.storage_location_kind [not null]
  location_code     varchar(64) [not null, unique]
  max_weight        decimal(10,3)
  is_pickable       boolean [not null]
  is_putaway_target boolean [not null]
  status            warehouse.storage_location_status [not null]
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null, default: `now()`]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
}

Table warehouse.warehouse [headercolor: #8E6C3A] {
  id               uuid [pk]
  name             varchar(200) [not null]
  status           warehouse.warehouse_status [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  prefix           varchar(10) [not null, unique]
  address          varchar(500) [not null]
  return_address   varchar(500)
  map_unit         varchar(8) [not null]
  map_width        decimal(10,3) [not null]
  map_height       decimal(10,3) [not null]
}

Table warehouse.zone [headercolor: #8E6C3A] {
  id               uuid [pk]
  warehouse_id     uuid [not null]
  name             varchar(100) [not null]
  color            varchar(7)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (warehouse_id, name) [unique]
  }
}

// =============================================================================
// SCHEMA: procurement
// =============================================================================

Table procurement.goods_receipt_lines [headercolor: #7D5BA6] {
  id                       uuid [pk]
  receipt_id               uuid [not null]
  inventory_item_id        uuid [not null]
  location_id              uuid [not null]
  received_qty             decimal(18,3) [not null]
  lot_number               varchar(64) [not null]
  note                     varchar(255)
  version                  bigint [not null, default: 0]
  created_at               timestamptz [not null, default: `now()`]
  created_by               varchar(100)
  last_modified_at         timestamptz
  last_modified_by         varchar(100)
  uom_conversion_id        uuid [not null]
  production_order_line_id uuid
  indexes {
    (receipt_id, production_order_line_id) [unique]
  }
}

Table procurement.goods_receipt_photos [headercolor: #7D5BA6] {
  id               uuid [pk]
  receipt_id       uuid [not null]
  receipt_line_id  uuid
  stage            varchar(16) [not null]
  storage_key      varchar(512) [not null, unique]
  original_name    varchar(255) [not null]
  content_type     varchar(32) [not null]
  size_bytes       bigint [not null]
  checksum         varchar(64) [not null]
  taken_by         uuid [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table procurement.goods_receipt_return_cartons [headercolor: #7D5BA6] {
  id               uuid [pk]
  receipt_id       uuid [not null]
  stock_package_id uuid [not null]
  lpn              varchar(30) [not null]
  sku              varchar(64) [not null]
  lot_number       varchar(64)
  quantity         int [not null]
  condition_note   varchar(500)
  scanned_by       uuid [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (receipt_id, stock_package_id) [unique]
  }
}

Table procurement.goods_receipts [headercolor: #7D5BA6] {
  id                     uuid [pk]
  receipt_number         varchar(30) [not null, unique]
  warehouse_id           uuid [not null]
  status                 procurement.goods_receipts_status [not null, default: 'DRAFT']
  received_at            timestamptz [not null]
  received_by            uuid [not null]
  confirmed_at           timestamptz
  confirmed_by           uuid
  delivery_note          varchar(100)
  note                   text
  version                bigint [not null, default: 0]
  created_at             timestamptz [not null, default: `now()`]
  created_by             varchar(100)
  last_modified_at       timestamptz
  last_modified_by       varchar(100)
  closed_at              timestamptz
  receipt_type           procurement.goods_receipts_receipt_type [not null]
  production_order_id    uuid
  customer_order_id      uuid
  return_shipment_id     uuid
  return_request_id      uuid
  quarantine_location_id uuid
}

// =============================================================================
// SCHEMA: ordering
// =============================================================================

Table ordering.contract_payment_installment [headercolor: #C0392B] {
  id                uuid [pk]
  contract_id       uuid [not null]
  seq               smallint [not null]
  name              varchar(100) [not null]
  milestone         ordering.contract_payment_installment_milestone [not null]
  percent           decimal(5,2)
  amount            decimal(19,4) [not null]
  due_days          int
  delivery_batch_id uuid
  indexes {
    (contract_id, seq) [unique]
  }
}

Table ordering.customer_order [headercolor: #C0392B] {
  id                           uuid [pk]
  order_number                 varchar(32) [not null, unique]
  customer_id                  uuid
  request_id                   uuid [not null, unique]
  status                       ordering.customer_order_status [not null]
  total_amount                 decimal(19,4) [not null]
  currency                     varchar(3) [not null]
  placed_at                    timestamptz [not null]
  cancellation_reason          varchar(500)
  version                      bigint [not null, default: 0]
  created_at                   timestamptz [not null]
  created_by                   varchar(100)
  last_modified_at             timestamptz
  last_modified_by             varchar(100)
  contact_name                 varchar(200)
  contact_email                varchar(320)
  contact_phone                varchar(32)
  shipping_recipient_name      varchar(200)
  shipping_phone               varchar(32)
  shipping_line1               varchar(255)
  shipping_line2               varchar(255)
  shipping_ward_code           varchar(20)
  shipping_ward_name           varchar(120)
  shipping_province_code       varchar(20)
  shipping_province_name       varchar(120)
  shipping_country_code        varchar(2)
  shipping_postal_code         varchar(20)
  billing_recipient_name       varchar(200)
  billing_phone                varchar(32)
  billing_line1                varchar(255)
  billing_line2                varchar(255)
  billing_ward_code            varchar(20)
  billing_ward_name            varchar(120)
  billing_province_code        varchar(20)
  billing_province_name        varchar(120)
  billing_country_code         varchar(2)
  billing_postal_code          varchar(20)
  warehouse_id                 uuid
  released_at                  timestamptz
  released_by                  uuid
  cancellation_reason_code     ordering.customer_order_cancellation_reason_code
  cancellation_retained_amount decimal(19,4)
  cancellation_fee_reason      varchar(500)
  cancellation_fee_detail      varchar(2000)
  cancellation_fee_amount      decimal(19,4)
  printing_started_at          timestamptz
  packed_at                    timestamptz
  hold_reason                  varchar(24)
  status_before_hold           varchar(32)
  hold_note                    varchar(1000)
  shipped_at                   timestamptz
  delivered_at                 timestamptz
  delivery_failure_reason      varchar(24)
  completed_at                 timestamptz
  refunded_at                  timestamptz
  closed_at                    timestamptz
  allow_partial_shipment       boolean [not null, default: false]
  fulfilment_started_at        timestamptz
  goods_left_at                timestamptz
  closed_amount                decimal(19,4) [not null, default: 0]
  tax_amount                   decimal(19,4) [not null, default: 0]
  net_amount                   decimal(19,4) [note: 'generated: (total_amount - tax_amount)']
  contract_signed_at           timestamptz
  shipping_warehouse_id        uuid
  shipping_warehouse_chosen_at timestamptz
  shipping_warehouse_chosen_by uuid
  first_labeled_at             timestamptz
}

Table ordering.delay_alert [headercolor: #C0392B] {
  id                  uuid [pk]
  type                ordering.delay_alert_type [not null]
  production_order_id uuid
  delivery_batch_id   uuid
  subject_id          uuid [note: 'generated: COALESCE(production_order_id, delivery_batch_id)']
  sales_order_id      uuid [not null]
  opened_at           timestamptz [not null]
  closed_at           timestamptz
}

Table ordering.delivery_batch [headercolor: #C0392B] {
  id           uuid [pk]
  contract_id  uuid [not null]
  seq          smallint [not null]
  window_start date
  window_end   date
  indexes {
    (contract_id, seq) [unique]
  }
}

Table ordering.delivery_batch_hold [headercolor: #C0392B] {
  reservation_id    uuid [pk]
  delivery_batch_id uuid [not null]
  order_id          uuid [not null]
  order_line_id     uuid [not null]
  created_at        timestamptz [not null, default: `now()`]
}

Table ordering.delivery_batch_line [headercolor: #C0392B] {
  id                uuid [pk]
  delivery_batch_id uuid [not null]
  order_line_id     uuid [not null]
  cartons           int [not null]
  indexes {
    (delivery_batch_id, order_line_id) [unique]
  }
}

Table ordering.delivery_batch_release [headercolor: #C0392B] {
  delivery_batch_id uuid [pk]
  order_id          uuid [not null]
  seq               smallint [not null]
  warehouse_id      uuid [not null]
  released_at       timestamptz [not null]
  released_by       uuid [not null]
  indexes {
    (order_id, seq) [unique]
  }
}

Table ordering.delivery_batch_window_change [headercolor: #C0392B] {
  id                  uuid [pk]
  delivery_batch_id   uuid [not null]
  order_id            uuid [not null]
  old_window_start    date [not null]
  old_window_end      date [not null]
  new_window_start    date [not null]
  new_window_end      date [not null]
  reason_code         ordering.delivery_batch_window_change_reason_code [not null]
  note                varchar(1000) [not null]
  evidence_file_key   varchar(512)
  evidence_file_name  varchar(255)
  evidence_message_id uuid
  changed_by          uuid [not null]
  changed_at          timestamptz [not null]
}

Table ordering.delivery_failure_case [headercolor: #C0392B] {
  id                     uuid [pk]
  order_id               uuid [not null]
  shipment_id            uuid [not null, unique]
  delivery_batch_id      uuid
  receipt_id             uuid [not null, unique]
  receipt_number         varchar(40) [not null]
  warehouse_id           uuid [not null]
  failure_reason         ordering.delivery_failure_case_failure_reason [not null]
  failure_note           varchar(500)
  status                 ordering.delivery_failure_case_status [not null, default: 'OPEN']
  opened_at              timestamptz [not null]
  decided_by             uuid
  decided_at             timestamptz
  decision_note          varchar(1000)
  failed_trip_fee        decimal(19,4)
  fee_installment_id     uuid
  carrier_claim          boolean [not null, default: false]
  released_at            timestamptz
  released_by            uuid
  redelivery_shipment_id uuid [unique]
  redelivered_at         timestamptz
  closed_at              timestamptz
  closed_by              uuid
  version                bigint [not null, default: 0]
  created_at             timestamptz [not null, default: `now()`]
}

Table ordering.delivery_failure_case_carton [headercolor: #C0392B] {
  case_id    uuid [not null]
  lpn        varchar(64) [not null]
  sku        varchar(64) [not null]
  lot_number varchar(64)
  quantity   int [not null]
  condition  varchar(500)
  indexes {
    (case_id, lpn) [pk]
  }
}

Table ordering.delivery_failure_case_hold [headercolor: #C0392B] {
  reservation_id uuid [pk]
  case_id        uuid [not null]
  order_line_id  uuid [not null]
  created_at     timestamptz [not null, default: `now()`]
}

Table ordering.order_cancellation_request [headercolor: #C0392B] {
  id               uuid [pk]
  order_id         uuid [not null]
  requested_by     uuid
  reason_code      ordering.order_cancellation_request_reason_code [not null]
  note             varchar(1000)
  requested_at     timestamptz [not null]
  status           ordering.order_cancellation_request_status [not null, default: 'PENDING']
  decided_by       uuid
  decided_at       timestamptz
  decision_note    varchar(1000)
  retained_percent decimal(5,2)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table ordering.order_credit_check [headercolor: #C0392B] {
  id               uuid [pk]
  order_id         uuid [not null]
  checked_at       timestamptz [not null]
  credit_limit     decimal(19,4) [not null]
  exposure         decimal(19,4) [not null]
  order_amount     decimal(19,4) [not null]
  outcome          ordering.order_credit_check_outcome [not null]
  decided_by       uuid
  decided_at       timestamptz
  note             varchar(1000)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table ordering.order_fee_line [headercolor: #C0392B] {
  id         uuid [pk]
  order_id   uuid [not null]
  kind       ordering.order_fee_line_kind [not null]
  sku        varchar(64)
  amount     decimal(19,4) [not null]
  tax_rate   decimal(5,2) [not null]
  tax_amount decimal(19,4) [not null]
  currency   varchar(3) [not null]
}

Table ordering.order_hold [headercolor: #C0392B] {
  id               uuid [pk]
  order_id         uuid [not null]
  reason           ordering.order_hold_reason [not null]
  raised_at        timestamptz [not null]
  resolved_at      timestamptz
  resolved_by      uuid
  resolution_note  varchar(1000)
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  note             varchar(1000)
  raised_by        uuid
}

Table ordering.order_line [headercolor: #C0392B] {
  id                      uuid [pk]
  order_id                uuid [not null]
  sku                     varchar(64) [not null]
  quantity                int [not null]
  unit_price              decimal(19,4) [not null]
  currency                varchar(3) [not null]
  design_snapshot_id      uuid
  design_checksum         varchar(64)
  cancelled_quantity      int [not null, default: 0]
  requested_delivery_date date
  uom_conversion_id       uuid
  cartons                 int
  units_per_carton        int
  tax_rate                decimal(5,2)
  tax_amount              decimal(19,4)
}

Table ordering.order_line_reservation [headercolor: #C0392B] {
  order_line_id  uuid [not null]
  reservation_id uuid [not null]
  indexes {
    (order_line_id, reservation_id) [pk]
  }
}

Table ordering.order_number_sequence [headercolor: #C0392B] {
  sequence_date date [pk]
  last_value    bigint [not null, default: 0]
}

Table ordering.order_partial_shipment_decision [headercolor: #C0392B] {
  id               uuid [pk]
  order_id         uuid [not null]
  allowed          boolean [not null]
  order_status     varchar(32) [not null]
  note             varchar(500)
  decided_by       uuid
  decided_at       timestamptz [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table ordering.order_shipment [headercolor: #C0392B] {
  id                uuid [pk]
  order_id          uuid [not null]
  status            ordering.order_shipment_status [not null]
  amount            decimal(19,4) [not null]
  handed_over_at    timestamptz [not null]
  handed_over_by    uuid
  outcome_at        timestamptz
  outcome_by        uuid
  failure_reason    varchar(24)
  failure_note      varchar(500)
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null, default: `now()`]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
  shipment_code     varchar(48)
  package_count     int
  carrier_name      varchar(120)
  delivery_batch_id uuid
}

Table ordering.order_shipment_line [headercolor: #C0392B] {
  shipment_id   uuid [not null]
  order_line_id uuid [not null]
  quantity      int [not null]
  indexes {
    (shipment_id, order_line_id) [pk]
  }
}

Table ordering.order_status_history [headercolor: #C0392B] {
  id               uuid [pk]
  order_id         uuid [not null]
  from_status      varchar(32)
  to_status        varchar(32) [not null]
  reason           varchar(500)
  actor_id         uuid
  occurred_at      timestamptz [not null]
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table ordering.order_status_transition [headercolor: #C0392B] {
  from_status varchar(32) [not null]
  to_status   varchar(32) [not null]
  indexes {
    (from_status, to_status) [pk]
  }
}

Table ordering.producer [headercolor: #C0392B] {
  id                 uuid [pk]
  code               varchar(32) [not null, unique]
  name               varchar(200) [not null]
  contact_name       varchar(200)
  contact_phone      varchar(32)
  email              varchar(254)
  channel            ordering.producer_channel [not null]
  standard_lead_days int [not null, default: 14]
  status             ordering.producer_status [not null, default: 'ACTIVE']
  note               varchar(500)
  version            bigint [not null, default: 0]
  created_at         timestamptz [not null, default: `now()`]
  created_by         varchar(100)
  last_modified_at   timestamptz
  last_modified_by   varchar(100)
}

Table ordering.production_order [headercolor: #C0392B] {
  id                         uuid [pk]
  code                       varchar(32) [not null, unique]
  sales_order_id             uuid [not null]
  delivery_batch_id          uuid [not null]
  customer_id                uuid [not null]
  producer_id                uuid [not null]
  receiving_warehouse_id     uuid [not null]
  need_by_date               date [not null]
  status                     ordering.production_order_status [not null]
  sample_approval_required   boolean [not null]
  sample_required_by_default boolean [not null]
  sample_waiver_reason       varchar(500)
  unit_price                 decimal(19,4)
  currency                   varchar(3) [not null, default: 'VND']
  note                       varchar(500)
  drawn_up_by                uuid [not null]
  submitted_at               timestamptz
  approved_by                uuid
  approved_at                timestamptz
  returned_reason            varchar(500)
  sent_at                    timestamptz
  production_started_at      timestamptz
  cancelled_by               uuid
  cancelled_at               timestamptz
  cancellation_reason        varchar(500)
  closed_by                  uuid
  closed_at                  timestamptz
  closing_reason             varchar(500)
  version                    bigint [not null, default: 0]
  created_at                 timestamptz [not null, default: `now()`]
  created_by                 varchar(100)
  last_modified_at           timestamptz
  last_modified_by           varchar(100)
  expected_completion_date   date
}

Table ordering.production_order_line [headercolor: #C0392B] {
  id                   uuid [pk]
  production_order_id  uuid [not null]
  order_line_id        uuid [not null]
  sku                  varchar(64) [not null]
  cartons              int [not null]
  units_per_carton     int [not null]
  total_units          int [note: 'generated: (cartons * units_per_carton)']
  design_snapshot_id   uuid [not null]
  print_file_checksum  varchar(128) [not null]
  packing_requirements varchar(500)
  received_cartons     int [not null, default: 0]
  indexes {
    (production_order_id, order_line_id) [unique]
  }
}

Table ordering.production_order_receipt [headercolor: #C0392B] {
  production_order_id uuid [not null]
  goods_receipt_id    uuid [not null, unique]
  receipt_number      varchar(30) [not null]
  status              ordering.production_order_receipt_status [not null]
  opened_at           timestamptz [not null]
  settled_at          timestamptz
  indexes {
    (production_order_id, goods_receipt_id) [pk]
  }
}

Table ordering.production_order_sample_media [headercolor: #C0392B] {
  id              uuid [pk]
  sample_round_id uuid [not null]
  storage_key     varchar(512) [not null, unique]
  file_name       varchar(255) [not null]
  content_type    varchar(100) [not null]
  size_bytes      bigint [not null]
  uploaded_by     uuid [not null]
  uploaded_at     timestamptz [not null]
}

Table ordering.production_order_sample_round [headercolor: #C0392B] {
  id                      uuid [pk]
  production_order_id     uuid [not null]
  round_no                int [not null]
  reprint_reason          varchar(16)
  physical_sample_sent_on date
  opened_by               uuid [not null]
  opened_at               timestamptz [not null]
  result                  ordering.production_order_sample_round_result
  customer_note           varchar(500)
  answered_by             uuid
  answered_at             timestamptz
  created_at              timestamptz [not null, default: `now()`]
  indexes {
    (production_order_id, round_no) [unique]
  }
}

Table ordering.production_order_slip [headercolor: #C0392B] {
  production_order_id uuid [pk]
  storage_key         varchar(512) [not null, unique]
  sha256              character(64) [not null]
  size_bytes          bigint [not null]
  created_at          timestamptz [not null, default: `now()`]
}

Table ordering.production_order_status_history [headercolor: #C0392B] {
  id                  uuid [pk]
  production_order_id uuid [not null]
  from_status         varchar(24)
  to_status           varchar(24) [not null]

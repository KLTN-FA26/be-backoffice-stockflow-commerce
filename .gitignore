# target/ covers everything under it, including target/spring-modulith-docs/ - git does not
# descend into an ignored directory, so listing children would be inert.
target/

# maven-wrapper.properties IS committed (it pins the Maven version). The jar is not - the wrapper
# is configured as distributionType=only-script, which needs no jar. See the README for generating
# the mvnw scripts.
.mvn/wrapper/maven-wrapper.jar

.idea/
*.iml
.vscode/
.settings/
.classpath
.project

*.log
.DS_Store

# Real credentials. .env.example is the documented template and IS committed.
.env
.env.*
!.env.example
# Server-only state of deploy/ (TLS key, JWT signing key, database dumps, the running tag) - never committed.
deploy/certs/
deploy/auth/
deploy/jwt/
deploy/backups/
deploy/.nginx-config-hash

# LocalFileStorage's directory when the local storage provider is selected.
.local-storage/

# AssistantGoldenSetEval's results against a real model, kept between runs and out of target/ so `mvn clean` keeps
# them: a run on a free model quota takes several days (docs/assistant-design.md §10.3).
/assistant-eval-runs/

# Generated from the code by ModularityTest on every build; never committed, or it goes stale.
target/spring-modulith-docs/

# Python bytecode (tools/)
__pycache__/
*.pyc

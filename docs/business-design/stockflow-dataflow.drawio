tyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="ACCEPTED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="event  RefundCompleted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="từ chối" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#A03426;strokeWidth=2;fontSize=10;fontColor=#A03426;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c16" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="REJECTED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#A03426;strokeWidth=2;fontSize=10;fontColor=#A03426;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c22" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="!  Hàng in theo yêu cầu KHÔNG được trả trừ khi lỗi — BR-RMA-002. Cốc in ảnh của khách không bán lại cho ai được." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#A03426;" vertex="1" parent="1"><mxGeometry x="40" y="1730" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c39" value="·  Hàng in bị lỗi trả về thì vào thẳng DAMAGED, không phải QUARANTINE — không có gì để kiểm lại." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1754" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="87885221af10" name="F-RTO Hàng hoàn về vì giao không thành"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1730" pageHeight="1203" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="F-RTO — Hàng hoàn về vì giao không thành công" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.9.7  ·  Khác RMA ở chỗ khách chưa từng nhận hàng. Nhưng hàng vẫn phải qua kiểm mới bán lại được." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="fulfillment-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="907" as="geometry"/></mxCell><mxCell id="c5" value="order-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="907" as="geometry"/></mxCell><mxCell id="c7" value="warehouse-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="314" height="907" as="geometry"/></mxCell><mxCell id="c9" value="inventory-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1030" y="162" width="314" height="907" as="geometry"/></mxCell><mxCell id="c11" value="NHÁNH RẼ · NGOẠI LỆ" style="rounded=0;html=1;fillColor=#F7E3E0;strokeColor=#E5C9C4;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#A03426;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=0;html=1;fillColor=#FDF6F5;strokeColor=#EBD5D1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1360" y="162" width="314" height="907" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Hãng báo giao không thành công&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /webhooks/carriers/{carrier}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; shipment.tracking_status&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; tracking_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → RTO_IN_TRANSIT&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Sau N lần thử không giao được&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="120" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Ghi nhận kiện quay về kho&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /shipping/rto/{id}/receive&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; shipment.status&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → RTO_RECEIVED&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="352" width="292" height="95" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Cập nhật đơn sang trạng thái hoàn về&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: OrderReturnedToOrigin&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; order.status&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; order_status_history&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → RTO&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; RTO là trạng thái kết thúc của đơn&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="493" width="292" height="132" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Sinh việc xếp lại kho&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /shipping/rto/{id}/re-putaway&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; putaway_task&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ tái xếp kho&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="671" width="292" height="95" as="geometry"/></mxCell><mxCell id="c17" value="Kiện hàng&lt;br&gt;còn nguyên?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="765" y="812" width="200" height="74" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Nhập lại tồn kho&lt;/b&gt;&
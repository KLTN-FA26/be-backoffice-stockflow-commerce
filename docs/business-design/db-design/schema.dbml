  resolution_note               varchar(1000)
  settled_by                    uuid
  settled_at                    timestamptz
  refunded_amount               decimal(19,4) [not null, default: 0]
  credited_amount               decimal(19,4) [not null, default: 0]
  offset_amount                 decimal(19,4) [not null, default: 0]
  credit_transfer_id            uuid
  replacement_order_id          uuid
  vat_adjustment_required       boolean [not null, default: false]
  cancelled_by                  uuid
  cancellation_reason           varchar(500)
  closed_at                     timestamptz
  withdrawal_status             varchar(16)
  withdrawal_reason             varchar(500)
  withdrawal_amount             decimal(19,4) [not null, default: 0]
  withdrawal_proposed_by        uuid
  withdrawal_proposed_at        timestamptz
  withdrawal_decided_by         uuid
  withdrawal_decided_at         timestamptz
  withdrawal_decision_note      varchar(500)
  withdrawal_offset_amount      decimal(19,4) [not null, default: 0]
  withdrawal_credited_amount    decimal(19,4) [not null, default: 0]
  withdrawal_credit_transfer_id uuid
}

Table ordering.return_request_discrepancy [headercolor: #C0392B] {
  id                     uuid [pk]

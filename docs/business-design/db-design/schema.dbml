  return_required         boolean
  return_deadline         timestamptz
  received_by             uuid
  receiving_location_code varchar(64)
  window_override_reason  varchar(500)
  money_mode              varchar(16)
  settlement_amount       decimal(19,4) [not null, default: 0]
  proposed_by             uuid
  proposed_at             timestamptz
  resolution_note         varchar(1000)
  settled_by              uuid
  settled_at              timestamptz
  refunded_amount         decimal(19,4) [not null, default: 0]
  offset_amount           decimal(19,4) [not null, default: 0]
  vat_adjustment_required boolean [not null, default: false]
  cancelled_by            uuid
  cancellation_reason     varchar(500)
  closed_at               timestamptz
  goods_receipt_id        uuid
}

Table ordering.return_request_discrepancy [headercolor: #C0392B] {
  id                     uuid [pk]
  return_request_id      uuid [not null]
  return_request_line_id uuid

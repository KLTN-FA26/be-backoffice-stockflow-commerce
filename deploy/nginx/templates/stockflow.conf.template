# =============================================================================
# Sites. ${DOMAIN} and ${BFF_ORIGIN_SECRET} are substituted at container start; every other
# $variable is nginx's own and is left alone (the entrypoint only substitutes variables that are set).
#
#   api.${DOMAIN}    DNS-only  the application
#   jaeger.${DOMAIN} proxied   trace UI, behind basic auth
#   logs.${DOMAIN}   proxied   Dozzle, live container logs of this stack, behind basic auth
#
# Files are not served from here: presigned links point at the AWS S3 bucket itself, and published
# product images at CloudFront (PRODUCT_MEDIA_CDN_BASE_URL). The s3. and media. hosts (MinIO) and
# mail. (Mailpit) went with those containers on 2026-11-18.
#
# DNS-only (grey cloud) for what a browser or the frontend calls: Cloudflare Free sends Vietnamese
# ISPs to PoPs as far as Europe and back to a VPS in Vietnam, adding up to seconds per request.
# Those servers carry no origin lock and get the edge_req/edge_conn limits instead. The internal
# UIs stay proxied and locked: nobody needs them fast, and the lock keeps them off the open
# internet even though the VPS address is now public.
# =============================================================================

# The sales chat's STOMP socket (/ws below) is an HTTP/1.1 upgrade; the upgrade headers must be forwarded for it.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      "";
}

# -----------------------------------------------------------------------------
# Back-office BFF client IP (login rate limit).
#
# The Next.js back-office calls the API server-to-server, so after Cloudflare/realip every admin
# has the BFF's egress address and RateLimitInterceptor puts the whole team in one login bucket.
# The BFF sends the browser IP it took from its hosting platform, plus the shared
# BFF_ORIGIN_SECRET. Only with the exact secret is that IP used; otherwise X-Stockflow-Client-IP
# is ignored and $remote_addr (CF-Connecting-IP via realip) stays the identity, as before.
#
# Fail closed: compose refuses an unset or empty BFF_ORIGIN_SECRET, and the explicit "" key makes
# an empty rendering a duplicate key - `nginx -t` fails instead of every header-less request
# matching. The secret must be hex (openssl rand -hex 32): it is pasted into this file verbatim.
# proxy-headers.conf consumes $effective_client_ip and strips both headers before Spring; the
# edge_req/edge_conn limits in nginx.conf key on it too.
# map_hash_bucket_size (nginx.conf) is sized for the 64-character secret key.
# -----------------------------------------------------------------------------
map $http_x_stockflow_bff_secret $stockflow_bff_trusted {
    default                0;
    ""                     0;
    "${BFF_ORIGIN_SECRET}" 1;
}

# Defence in depth on top of the BFF's own validation: one bare IPv4/IPv6 token, no list.
map "$stockflow_bff_trusted:$http_x_stockflow_client_ip" $effective_client_ip {
    default                                     $remote_addr;
    "~^1:(?<bff_client_ip>[0-9A-Fa-f:.]{2,45})$" $bff_client_ip;
}

# -----------------------------------------------------------------------------
# Plain HTTP: redirect only. With Cloudflare in "Full (strict)" the edge always connects on 443;
# this catches anything else. The DNS-only hosts get their own redirect without the lock - a
# browser that types http://api... reaches the VPS directly, not through Cloudflare.
# -----------------------------------------------------------------------------
server {
    listen 80 default_server;
    server_name _;
    include /etc/nginx/snippets/cloudflare-only.conf;
    return 301 https://$host$request_uri;
}

server {
    listen 80;
    server_name api.${DOMAIN};
    return 301 https://$host$request_uri;
}

# An unknown Host on 443 gets no certificate and no response.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name api.${DOMAIN};

    include /etc/nginx/snippets/tls.conf;

    limit_req  zone=edge_req burst=40 nodelay;
    limit_conn edge_conn 50;

    # nginx's default is 1 MB. The application accepts 50 MB design renders
    # (spring.servlet.multipart.max-request-size: 51MB); this sits just above it so the
    # application, not nginx, produces the error body for an oversized file.
    client_max_body_size 52m;

    # /actuator is passed through: on this dev server the team uses loggers and threaddump. The
    # application guards it itself - only the liveness/readiness probes and info are anonymous,
    # everything else needs a token holding platform-actuator:READ (ActuatorPermission). For a
    # production server, return 404 here instead.
    #
    # Swagger UI for the frontend team: https://api.${DOMAIN}/swagger-ui.html (anonymous).

    location / {
        set $app_upstream http://stockflow-app-1:8080;
        proxy_pass $app_upstream;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    # The sales chat's STOMP socket (F-13): an HTTP/1.1 upgrade, kept open. proxy-headers.conf is not included because
    # it clears Connection, which would refuse the upgrade; the forwarding headers it sets are repeated here, and the
    # BFF headers need no clearing (the browser connects directly, without them). The token travels in the STOMP CONNECT
    # frame, never in the URL, so the access log carries no credential. Heartbeats every 10 s keep the socket busy;
    # the read timeout only has to outlast a missed one.
    location = /ws {
        set $app_upstream http://stockflow-app-1:8080;
        proxy_pass $app_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $effective_client_ip;
        proxy_set_header X-Real-IP         $effective_client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  443;
        proxy_set_header Forwarded          "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Forwarded-Ssl    "";
        proxy_set_header X-Stockflow-Bff-Secret "";
        proxy_set_header X-Stockflow-Client-IP  "";
        proxy_connect_timeout 5s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
        proxy_buffering off;
    }

    # A producer's signed links (4A-3): the query string is the credential. The access log drops it ($logged_uri in
    # nginx.conf); an error-log line quotes the whole request with no way to change its format, so this location
    # writes only crit and above - an upstream failure here shows in the application's log instead.
    location /api/v1/production-order-files/ {
        error_log /var/log/nginx/error.log crit;
        set $app_upstream http://stockflow-app-1:8080;
        proxy_pass $app_upstream;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}

# -----------------------------------------------------------------------------
# Jaeger UI
#
# Jaeger has no authentication, and a trace carries request paths, SQL text and user ids - so it
# is never reachable without the password in auth/htpasswd (README: "Jaeger password").
# -----------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name jaeger.${DOMAIN};

    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/cloudflare-only.conf;

    auth_basic           "StockFlow dev";
    auth_basic_user_file /etc/nginx/auth/htpasswd;

    # Never cached at the edge: Cloudflare could otherwise serve one user's authenticated page to
    # the next visitor.
    add_header Cache-Control "private, no-store" always;

    location / {
        set $jaeger_upstream http://jaeger:16686;
        proxy_pass $jaeger_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # The password is for nginx; Jaeger has no use for it.
        proxy_set_header Authorization "";
    }
}

# -----------------------------------------------------------------------------
# Dozzle UI (container logs)
#
# Logs are streamed as server-sent events. Any buffering on the way makes them arrive in bursts or
# not at all, so it is off here; Dozzle also sends X-Accel-Buffering: no, but saying it twice costs
# nothing. A quiet container sends nothing for minutes, hence the long read timeout.
# -----------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name logs.${DOMAIN};

    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/cloudflare-only.conf;

    auth_basic           "StockFlow dev";
    auth_basic_user_file /etc/nginx/auth/htpasswd;

    add_header Cache-Control "private, no-store" always;

    location / {
        set $dozzle_upstream http://dozzle:8080;
        proxy_pass $dozzle_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 1h;
    }
}

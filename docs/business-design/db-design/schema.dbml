  settled_at              timestamptz [not null]
  settled_by              uuid
  approved_at             timestamptz
  approved_by             uuid
  approval_note           varchar(1000)
  version                 bigint [not null, default: 0]
}

Table procurement.supplier_addresses [headercolor: #7D5BA6] {

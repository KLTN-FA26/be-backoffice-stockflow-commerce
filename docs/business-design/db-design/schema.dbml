Table procurement.supplier_invoices [headercolor: #7D5BA6] {
  id                      uuid [pk]
  invoice_number          varchar(64) [not null]
  supplier_id             uuid [not null]
  po_id                   uuid
  status                  procurement.supplier_invoices_status [not null, default: 'DRAFT']
  currency                varchar(3) [not null, default: 'VND']
  invoice_date            date [not null]
  due_date                date
  subtotal                decimal(18,2) [not null, default: 0]
  tax_total               decimal(18,2) [not null, default: 0]
  total_amount            decimal(18,2) [not null, default: 0]
  file_url                text
  version                 bigint [not null, default: 0]
  created_at              timestamptz [not null, default: `now()`]
  created_by              varchar(100)
  last_modified_at        timestamptz
  last_modified_by        varchar(100)
  received_by             uuid
  note                    varchar(500)
  file_name               varchar(255)
  file_content_type       varchar(100)
  matched_at              timestamptz
  matched_by              uuid
  price_tolerance_percent decimal(5,2)
  voided_at               timestamptz
  voided_by               uuid
  void_reason             varchar(500)
  indexes {
    (supplier_id, invoice_number) [unique]
  }
}

Table procurement.supplier_item_prices [headercolor: #7D5BA6] {
  id               uuid [pk]
  supplier_item_id uuid [not null]
  unit_price       decimal(18,2) [not null]
  currency         varchar(3) [not null, default: 'VND']
  effective_from   timestamptz [not null, default: `now()`]
  effective_to     timestamptz
  version          bigint [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]
  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
  indexes {
    (supplier_item_id, effective_from) [unique]
  }
}

Table procurement.supplier_items [headercolor: #7D5BA6] {
  id                uuid [pk]
  supplier_id       uuid [not null]
  inventory_item_id uuid [not null]
  supplier_sku_code varchar(50)
  current_price     decimal(18,2) [not null]
  currency          varchar(3) [not null, default: 'VND']
  moq               int [not null, default: 1]
  pack_size         int [not null, default: 1]
  lead_time_days    int [default: 7]
  version           bigint [not null, default: 0]
  created_at        timestamptz [not null, default: `now()`]
  created_by        varchar(100)
  last_modified_at  timestamptz
  last_modified_by  varchar(100)
  indexes {
    (supplier_id, inventory_item_id) [unique]
  }
}

Table procurement.suppliers [headercolor: #7D5BA6] {
  id                     uuid [pk]
  code                   varchar(30) [not null, unique]
  name                   varchar(200) [not null]
  legal_name             varchar(200)
  tax_id                 varchar(30)
  status                 procurement.suppliers_status [not null, default: 'ACTIVE']
  currency               varchar(3) [not null, default: 'VND']
  payment_terms          varchar(50)
  incoterms              varchar(10)
  over_receipt_tolerance decimal(5,2)
  lead_time_days         int [default: 7]
  bank_account_name      varchar(200)
  bank_account_number    varchar(50)
  bank_name              varchar(150)
  note                   text
  version                bigint [not null, default: 0]
  created_at             timestamptz [not null, default: `now()`]
  created_by             varchar(100)
  last_modified_at       timestamptz
  last_modified_by       varchar(100)
  is_print_subcontractor boolean [not null, default: false]
  loss_tolerance_percent decimal(5,2) [not null, default: 2]
  payment_term_days      int [not null, default: 30]
  communication_channel  procurement.suppliers_communication_channel [not null, default: 'EMAIL']
  api_endpoint           varchar(500)
}

// =============================================================================
// SCHEMA: ordering
// =============================================================================

Table ordering.cart [headercolor: #C0392B] {
  id                  uuid [pk]
  customer_id         uuid
  guest_token         varchar(64) [unique]
  status              ordering.cart_status [not null, default: 'ACTIVE']
  currency            varchar(3) [not null, default: 'VND']
  converted_order_id  uuid
  merged_into_cart_id uuid
  last_activity_at    timestamptz [not null, default: `now()`]
  expires_at          timestamptz
  version             bigint [not null, default: 0]
  created_at          timestamptz [not null, default: `now()`]
  created_by          varchar(100)
  last_modified_at    timestamptz
  last_modified_by    varchar(100)
}

Table ordering.cart_line [headercolor: #C0392B] {
  id                  uuid [pk]

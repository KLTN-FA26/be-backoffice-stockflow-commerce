onolith." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1400" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="a61b52e23b93" name="02 · Cơ chế outbox"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Một event rời khỏi service bằng đường nào" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="Mọi mũi tên nét đứt trong 25 trang sau đều đi qua đây. Không luồng nào gửi thẳng message ra Kafka." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="40" as="geometry"/></mxCell><mxCell id="c3" value="MỘT TRANSACTION Ở SERVICE PHÁT" style="rounded=1;arcSize=6;html=1;fillColor=#FDF6EC;strokeColor=#8A5209;strokeWidth=2;verticalAlign=top;align=left;spacing=8;fontSize=12;fontStyle=1;fontColor=#8A5209;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="530" height="250" as="geometry"/></mxCell><mxCell id="c4" value="aggregate" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="205" width="160" height="54" as="geometry"/></mxCell><mxCell id="c5" value="bảng nghiệp vụ" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FDF6EC;strokeColor=#8A5209;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="195" width="220" height="50" as="geometry"/></mxCel
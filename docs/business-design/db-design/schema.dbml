  created_by       varchar(100)
  last_modified_at timestamptz
  last_modified_by varchar(100)
}

Table procurement.subcontract_settlement [headercolor: #7D5BA6] {
  po_id                   uuid [pk]
  production_order_id     uuid [not null, unique]
  status                  procurement.subcontract_settlement_status [not null]
  currency                varchar(3) [not null]
  unit_price              decimal(18,2) [not null]
  received_quantity       int [not null]
  passed_quantity         int [not null]
  failed_quantity         int [not null]
  payable_amount          decimal(18,2) [not null]
  blanks_sent             int [not null]
  blanks_used             int [not null]
  blanks_returned         int [not null]
  blanks_lost             int [not null]

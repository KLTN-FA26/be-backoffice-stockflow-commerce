    (return_request_id, order_line_id) [unique]
  }
}

Table ordering.return_request_status_history [headercolor: #C0392B] {
  id                uuid [pk]
  return_request_id uuid [not null]
  from_status       varchar(24)
  to_status         varchar(24) [not null]

=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="782" as="geometry"/></mxCell><mxCell id="c5" value="order-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="782" as="geometry"/></mxCell><mxCell id="c7" value="catalog-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="314" height="782" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Job quét giữ chỗ quá hạn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;cron mỗi phút&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;&lt;b&gt;·&lt;/b&gt; quét stock_reservation WHERE expires_at &amp;lt; now AND status = HELD&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Điều kiện: expires_at &amp;lt; now AND status = HELD — BR-STK-002&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="95" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Giải phóng giữ chỗ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; stock_reservation.status = RELEASED&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ reason = RESERVATION_EXPIRED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; reason = RESERVATION_EXPIRED&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="327" width="292" height="107" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Trả lại số tồn khả dụng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; stock_item.reserved −&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ StockReservationReleased&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Allocation KHÔNG có expires_at — đã phân bổ thì không tự hết hạn&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="480" width="292" height="132" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Đơn chuyển sang thanh toán thất bại&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: StockReservationReleased&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; order.status&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → PAYMENT_FAILED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Giỏ hàng được giữ lại để khách thử lại&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="659" width="292" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Số tồn hiển thị phục hồi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: StockLevelChanged&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; atp_cache&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ ATP phục hồi tự động&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="825" width="292" height="95" as="geometry"/></mxCell><mxCell id="c14" value="job nền" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#7B808A;strokeWidth=2;fontSize=10;fontColor=#7B808A;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="job nền" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#7B808A;strokeWidth=2;fontSize=10;fontColor=#7B808A;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="event  StockReservationReleased" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="event  StockLevelChanged" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="·  expires_at &lt; now → status = RELEASED, reason = RESERVATION_EXPIRED — BR-STK-002." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c19" value="·  Đơn tương ứng → PAYMENT_FAILED. Giỏ hàng của khách được giữ lại để họ thử lại." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="994" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c20" value="*  Allocation KHÔNG có expires_at — đã phân bổ rồi thì không tự hết hạn nữa." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#8A5209;" vertex="1" parent="1"><mxGeometry x="40" y="1018" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5657ce4aa694" name="X-CHK Lệch checksum thiết kế — dừng đó"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1128" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="X-CHK — Lệch checksum thiết kế — dừng đóng gói" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.8.3  ·  Nghĩa là kiện hàng sắp chứa thứ khác với thứ khách đã duyệt. Đây là lỗi phải chặn, không phải cảnh báo." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="fulfillment-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="832" as="geometry"/></mxCell><mxCell id="c5" value="design-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="832" as="geometry"/></mxCell><mxCell id="c7" value="order-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="314" height="832" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Nhân viên quét kiện trước khi đóng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /packing/{orderId}/design-check&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; design_verification&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ expected_checksum vs actual&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="107" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Đọc artifact thật và tính lại checksum&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;GET /design/snapshots/{id}/verify&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;&lt;b&gt;·&lt;/b&gt; đọc design-snapshots/{id}.json&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ tính lại SHA-256&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="339" width="292" height="107" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Phát hiện lệch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; design_verification.result = MISMATCH&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ + outbox_event&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Nghĩa là kiện sắp chứa thứ KHÁC với thứ khách đã duyệt&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="493" width="292" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Dừng đóng gói, đơn sang tạm giữ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; order.status&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; order_hold&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → ON_HOLD, reason = DESIGN_MISMATCH&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; reason = DESIGN_MISMATCH. Không có nút bỏ qua — BR-DSG-003&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="659" width="292" height="132" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Kinh doanh xử lý: in lại hoặc đổi snapshot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /orders/{id}/replace-design&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; order_line.design_snapshot_id (nếu cần in lại)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ BR-DSG-002&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Chỉ đổi được khi đơn còn ở PENDING_PAYMENT hoặc CONFIRMED — BR-DSG-002&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="837" width="292" height="132" as="geometry"/></mxCell><mxCell id="c14" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="·  So checksum lưu trên order_line với artifact thật trong MinIO — BR-DSG-003." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c19" value="!  Lệch thì đơn → ON_HOLD, và phải người có quyền mới giải quyết được. Không có nút bỏ qua." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#A03426;" vertex="1" parent="1"><mxGeometry x="40" y="1044" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="85012bc64523" name="P-PERM 14 service tự đăng ký catalog ph"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1394" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="P-PERM — 14 service tự đăng ký catalog phân quyền" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.19.1  ·  Cơ chế làm cho con số 387 quyền là số ĐƯỢC TÍNH RA, không phải danh sách ai đó phải nhớ cập nhật." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="mỗi service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="1098" as="geometry"/></mxCell><mxCell id="c5" value="identity-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="1098" as="geometry"/></mxCell><mxCell id="c7" value="NHÁNH RẼ · NGOẠI LỆ" style="rounded=0;html=1;fillColor=#F7E3E0;strokeColor=#E5C9C4;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#A03426;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#FDF6F5;strokeColor=#EBD5D1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="314" height="1098" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Service quét annotation lúc khởi động&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;PermissionCatalogScanner&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;&lt;b&gt;·&lt;/b&gt; quét @PermissionResource bằng reflection&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ dựng PermissionCatalog&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Đọc @PermissionResource bằng reflection&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="120" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Đối chiếu với @RequiresPermission&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;&lt;b&gt;·&lt;/b&gt; đối chiếu @RequiresPermission&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ lệch → chặn khởi động&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Endpoint đòi quyền mà không resource nào khai báo → service KHÔNG KHỞI ĐỘNG — BR-SEC-001&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="352" width="292" height="120" as="geometry"/></mxCell><mxCell id="c11" value="Catalog khớp&lt;br&gt;với code?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="105" y="518" width="200" height="74" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Đăng ký catalog lên identity-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /identity/permissions/register&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; permission_resource (upsert)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ code, group, route, api_path&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Upsert, chạy lại nhiều lần vẫn đúng&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="618" width="292" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Sinh từng ô quyền (resource × action)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; permission (upsert)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ một dòng cho mỗi (resource, action)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Con số 387 là ĐƯỢC TÍNH RA, không phải danh sách gõ tay&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="784" width="292" height="132" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Tăng permission_version&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; permission_version&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ tăng counter, token cũ bị từ chối&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Token phát trước đó bị từ chối, thu hồi quyền có hiệu lực ngay&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="962" width="292" height="120" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;06 &amp;nbsp;·&amp;nbsp; Trả ma trận cho màn hình quản trị&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;GET /identity/roles/{code}/matrix&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;&lt;b&gt;·&lt;/b&gt; → trả RoleMatrixView cho màn hình&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ đã gom nhóm và tính counter&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Đã gom nhóm và tính counter sẵn&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="1128" width="292" height="107" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; CHẶN KHỞI ĐỘNG service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;IllegalStateException&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;&lt;b&gt;·&lt;/b&gt; in ra mọi endpoint đòi quyền không tồn tại&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ Service không lên, build đỏ&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Thà chết lúc khởi động còn hơn 403 bí ẩn ba tuần sau — BR-SEC-001&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FDF0EE;strokeColor=#A03426;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="500" width="292" height="120" as="geometry"/></mxCell><mxCell id="c17" value="job nền" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#7B808A;strokeWidth=2;fontSize=10;fontColor=#7B808A;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="khớp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="lệch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#A03426;strokeWidth=2;fontSize=10;fontColor=#A03426;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="!  Endpoint đòi quyền mà không resource nào khai báo thì service KHÔNG KHỞI ĐỘNG ĐƯỢC — BR-SEC-001." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#A03426;" vertex="1" parent="1"><mxGeometry x="40" y="1286" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c25" value="·  Service chưa chạy thì quyền của nó tạm chưa hiện trên màn hình. Tự chữa lành, không cần seed script." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1310" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="f7f77eb819f1" name="P-NOTI Thông báo — một event, nhiều kên"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1065" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="P-NOTI — Thông báo — một event, nhiều kênh" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.19.2  ·  notification-service nghe gần như mọi topic. Đây là lý do nó không được phép có logic nghiệp vụ nào." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="notification-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="769" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Nhận event từ bất kỳ service nào&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: mọi topic&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; processed_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ chống trùng&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Kiểm processed_event trước — cùng event giao hai lần không được gửi hai email&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Tạo bản ghi thông báo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; notification&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ channel, recipient, template_code&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; channel = EMAIL | SMS | IN_APP&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="352" width="292" height="107" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Render template với biến&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;Thymeleaf&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;&lt;b&gt;·&lt;/b&gt; render template + biến&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ Thymeleaf&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="505" width="292" height="95" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Gửi qua kênh tương ứng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;SMTP / SMS gateway / WebSocket&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; notification.status&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ SENT | FAILED&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="646" width="292" height="95" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Ghi nhật ký từng lần gửi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; notification_attempt&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ nhật ký từng lần gửi&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Gửi hỏng thì lưu lại cho gửi lại thủ công, không im lặng bỏ qua&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="787" width="292" height="120" as="geometry"/></mxCell><mxCell id="c10" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="·  Consumer phải idempotent: cùng một event giao hai lần không được gửi hai email — BR-SEC-001 áp dụng chung." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="957" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c15" value="·  Gửi thất bại thì lưu lại và cho phép gửi lại thủ công, không im lặng bỏ qua." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="981" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="078521b61058" name="P-RPT Read model báo cáo dựng từ event"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="924" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="P-RPT — Read model báo cáo dựng từ event stream" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.20  ·  reporting-service không gọi API của ai cả. Nó chỉ nghe event và tự dựng bảng của mình — vì thế nó không làm chậm hệ thống chính." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="reporting-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="628" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Nghe mọi event nghiệp vụ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: mọi topic&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; processed_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ chống trùng&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="95" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Dựng bảng phẳng cho từng loại báo cáo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;projector&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; projection (một bảng phẳng mỗi loại báo cáo)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ denormalise sẵn&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Denormalise sẵn, không JOIN lúc truy vấn&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="327" width="292" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Tổng hợp KPI theo ngày&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;cron 01:00&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; kpi_daily&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ job tổng hợp chạy đêm&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="493" width="292" height="95" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Trả dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;GET /api/v1/reports/*&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;&lt;b&gt;·&lt;/b&gt; → trả dashboard&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ truy vấn một bảng, không JOIN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Truy vấn MỘT bảng. Đây là câu trả lời cho &amp;#x27;báo cáo lấy dữ liệu ở đâu&amp;#x27; khi không có JOIN xuyên database&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="634" width="292" height="132" as="geometry"/></mxCell><mxCell id="c9" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="job nền" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#7B808A;strokeWidth=2;fontSize=10;fontColor=#7B808A;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="*  Không có JOIN xuyên database — đây chính là câu trả lời cho &#x27;vậy báo cáo lấy dữ liệu ở đâu&#x27; — ADR-0002." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#8A5209;" vertex="1" parent="1"><mxGeometry x="40" y="816" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c13" value="·  Read model có thể dựng lại từ đầu bằng cách replay event, nên sai sót projector là sửa được." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="678b70e2c973" name="P-CHAT Chat tư vấn dẫn tới đơn hàng đặt"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1206" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="P-CHAT — Chat tư vấn dẫn tới đơn hàng đặt hộ" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.16  ·  Luồng duy nhất mà nhân viên thao tác thay mặt khách. Quyền và dấu vết ai làm gì phải rõ." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="chat-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="910" as="geometry"/></mxCell><mxCell id="c5" value="design-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="910" as="geometry"/></mxCell><mxCell id="c7" value="order-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="314" height="910" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Khách mở khung chat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;WebSocket /ws/chat&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; conversation&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; message&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ status = OPEN&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="107" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Định tuyến hội thoại tới nhân viên&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;tự động theo routing rule&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; conversation.assigned_to&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ theo routing rule&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="339" width="292" height="107" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Trao đổi, gửi ảnh và link sản phẩm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /chat/conversations/{id}/messages&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; message (rich: ảnh, link sản phẩm)&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="493" width="292" height="82" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Nhân viên sửa thiết kế hộ khách&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /design/drafts&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; design_draft (nhân viên tạo hộ)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ khách vẫn phải confirm&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Khách VẪN phải tự confirm snapshot mới&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="621" width="292" height="107" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Nhân viên đặt đơn hộ khách&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/orders/assisted&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; order, created_by = nhân viên&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ customer_id vẫn là khách&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; customer_id là khách, created_by là nhân viên — audit phải phân biệt được&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="775" width="292" height="120" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;06 &amp;nbsp;·&amp;nbsp; Đóng hội thoại&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /chat/conversations/{id}/resolve&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; conversation.status&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → RESOLVED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Khách trả lời trong 24h thì mở lại&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="941" width="292" height="107" as="geometry"/></mxCell><mxCell id="c15" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="*  Đơn đặt hộ vẫn ghi customer_id của khách, nhưng created_by là nhân viên — audit phải phân biệt được." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#8A5209;" vertex="1" parent="1"><mxGeometry x="40" y="1098" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c21" value="·  Nhân viên sửa thiết kế hộ khách thì khách vẫn phải confirm lại snapshot mới." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1122" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
# =============================================================================
# Every environment variable the application reads. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored. This file is the documentation - if you add a ${VAR} to any yml, add it here
# in the same commit, or the next person deploying finds out by reading a stack trace.
#
# Variables with NO DEFAULT in application-prod.yml are marked REQUIRED. The application refuses to
# start without them, which is deliberate: booting with a development fallback and failing to
# connect looks like a network problem and wastes an afternoon.
# =============================================================================

# ---- profile ----------------------------------------------------------------
# local | prod. Anything that is not local/dev/test gets JSON logging and security ON.
SPRING_PROFILES_ACTIVE=local

# ---- database (REQUIRED in prod) --------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockflow
DB_USER=stockflow
DB_PASSWORD=stockflow
# Sized for the machine, not the module count. Roughly cores * 2 + effective spindles.
DB_POOL_MAX=20

# ---- redis (REQUIRED in prod) -----------------------------------------------
# Cache, rate limiting and the ad-hoc distributed lock. NOT the scheduler lock - that is in
# Postgres, because Redis runs with allkeys-lru and may evict a lock key.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ---- authentication (REQUIRED in prod) --------------------------------------
# Where the JWT signing keys are published. The identity module serves this today; keeping it a URI
# means moving identity out later is configuration, not code.
JWT_JWK_SET_URI=http://localhost:8080/oauth2/jwks
# The key tokens are signed with. Unset = a new key per start (every restart signs everyone out): fine locally,
# wrong for any shared server. JWT_PRIVATE_KEY_PATH: a PKCS#8 PEM file, created (owner-only) on the first start
# when missing and read afterwards; its directory must be writable by the application's user. JWT_PRIVATE_KEY: the
# PEM content itself (\n allowed for line breaks); wins over the path. An unusable configured key stops startup.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out signing-key.pem
JWT_PRIVATE_KEY_PATH=
JWT_PRIVATE_KEY=

# ---- object storage ---------------------------------------------------------
# S3_BUCKET is REQUIRED in prod.
S3_BUCKET=stockflow
# Set for MinIO; leave EMPTY for real S3.
S3_ENDPOINT=http://localhost:9000
AWS_REGION=ap-southeast-1
# true for MinIO, false for real S3. The wrong value produces a DNS failure that looks nothing
# like a configuration problem.
S3_PATH_STYLE=true
# Leave BLANK in a deployment so the SDK picks up the instance role. Static keys are for MinIO only.
S3_ACCESS_KEY=stockflow
S3_SECRET_KEY=stockflow123
# CloudFormation output ProductMediaBaseUrl. A custom media domain is optional; CloudFront's
# generated HTTPS hostname works without DNS changes. This is public for PUBLISHED product images.
PRODUCT_MEDIA_CDN_BASE_URL=https://replace-me.cloudfront.net
# Aliases used by docker-compose for the MinIO container itself.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=stockflow
MINIO_SECRET_KEY=stockflow123

# ---- observability ----------------------------------------------------------
# OpenTelemetry collector - Jaeger's OTLP HTTP port locally. The FULL endpoint including
# /v1/traces: this feeds management.otlp.tracing.endpoint, which is a URL, not a base.
# (OTEL_EXPORTER_OTLP_ENDPOINT is deliberately NOT used - Boot's exporter does not read it.)
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
# Fraction of requests traced. 1.0 locally, 0.1 in production - sampling everything costs more in
# storage than it returns.
TRACE_SAMPLING=1.0
LOG_LEVEL=INFO

# ---- cache ------------------------------------------------------------------
# Every cache key is prefixed with this. BUMP IT on any release whose cached types changed shape,
# so new instances start from a clean namespace instead of deserialising yesterday's objects.
CACHE_VERSION=v1

# ---- audit retention --------------------------------------------------------
# ISO-8601 durations. THE PURGE JOB DELETES PERMANENTLY - confirm both against the retention policy
# the business actually signed before go-live.
AUDIT_ROUTINE_RETENTION=P180D
AUDIT_SECURITY_RETENTION=P730D

# ---- e-mail (SCRUM-352) -------------------------------------------------------
# Every e-mail - supplier purchase orders, staff notices, the portal invitation and the customer order mail - goes
# through ONE transport:
#   resend    Resend's HTTP API. The default of the prod profile; the dev server switches to it with this variable
#             once its sending domain is verified in Resend.
#   smtp      the MAIL_* relay below. The default locally and on the dev server (Mailpit catches everything).
#   recording kept in memory, never sent. The test profile only.
# EMAIL_PROVIDER=resend
#
# REQUIRED with resend: the application does not start without it. Create it in the Resend dashboard
# (API Keys, "Sending access" is enough). NEVER commit a real key; it lives in the server's .env only.
RESEND_API_KEY=
# REQUIRED with resend: the sender of every message, "Name <address>" or a bare address. Its domain must be
# verified in Resend (Domains: SPF and DKIM records in your DNS), or Resend refuses every send with 403 - and only
# lets you send test mail to the account owner's own address until then. A .local or example.com sender is refused
# at startup. Quote it: the value has spaces and angle brackets. Unset locally (MAIL_FROM below is used).
# RESEND_FROM="StockFlow <no-reply@your-domain.vn>"
# Optional: where a customer's reply goes (e.g. Sales' shared mailbox). Blank: customer mail says not to reply.
RESEND_REPLY_TO=
# Optional: the signing secret of the Resend webhook (Webhooks > your endpoint > Signing secret, "whsec_..."), for
# delivery reports on customer mail (delivered, bounced, marked as spam). Endpoint to register:
#   https://<api-domain>/api/v1/notifications/webhooks/resend   events: email.delivered, email.bounced,
#   email.complained, email.delivery_delayed, email.failed
# Blank: that endpoint answers 503 and Resend keeps retrying until it is set.
RESEND_WEBHOOK_SECRET=
# Resend allows a team 2 requests per second by default; raise only if your plan allows more.
# RESEND_REQUESTS_PER_SECOND=2
# How the customer mail signs off.
# EMAIL_SENDER_NAME=StockFlow
# false: no customer order mail at all (each recorded as skipped, not sent later), staff and supplier mail unchanged.
# Set it on any server holding a copy of real customers that must not hear from it.
# CUSTOMER_EMAIL_ENABLED=true
# The SMTP health probe; only meaningful with EMAIL_PROVIDER=smtp on a server.
# MAIL_HEALTH_ENABLED=false

# ---- supplier communication -------------------------------------------------
# Mailpit listens on 1025 in the local Docker stack. With EMAIL_PROVIDER=smtp on a server, use the SMTP credentials
# supplied by the chosen relay. Leave username/password empty only for a local unauthenticated SMTP.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@stockflow.local
# Exact trusted HTTPS supplier API hosts, comma-separated; blank disables API delivery.
SUPPLIER_API_ALLOWED_HOSTS=
# Required before sending a new PO. Real buyer contact and the default receiving warehouse.
PO_BUYER_COMPANY_NAME=
PO_BUYER_COMPANY_ADDRESS=
PO_BUYER_CONTACT_NAME=
PO_BUYER_PHONE=
PO_BUYER_EMAIL=
PO_RECEIVING_ADDRESS=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
# Host name sent in SMTP EHLO. Blank = JavaMail resolves this machine's name, which is slow where
# reverse DNS is (seen: ~10 s per e-mail on a laptop).
MAIL_SMTP_LOCALHOST=

# ---- customer onboarding (SCRUM-450) ------------------------------------------
# The customer portal page that redeems an invitation; the token is appended as #token=...
# Set the real frontend URL before deploying; a blank value makes Sales invitations return 503.
# deploy/docker-compose.yml rejects a missing or empty value.
PORTAL_ACTIVATION_URL=
PORTAL_INVITATION_LIFETIME=PT72H
PORTAL_INVITATION_RESEND_COOLDOWN=PT1M

# ---- bank transfer instructions (SCRUM-193) -----------------------------------
# The company account a customer is told to transfer to (GET /api/v1/orders/me/{id}/transfer-instructions,
# kltn-docs 15 §4.1). Set all three per deployment: while any is blank the endpoint answers 503
# TRANSFER_INSTRUCTIONS_UNAVAILABLE rather than show a made-up account. The local and dev profiles fall back to an
# obvious demo account when the variables are NOT SET AT ALL (an empty value counts as set).
# COMPANY_BANK_NAME=Vietcombank
# COMPANY_BANK_ACCOUNT_NUMBER=
# COMPANY_BANK_ACCOUNT_NAME=

# ---- server -----------------------------------------------------------------
SERVER_PORT=8080
# Browser origins allowed to call the API, comma-separated patterns (see CorsProperties). Needed
# once a frontend runs anywhere other than localhost.
# STOCKFLOW_SECURITY_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,https://*.stockflow.vn

# ---- upload security inspection ---------------------------------------------
# Required for new media uploads. Start docker-compose.media.yml alongside the base stack.
STOCKFLOW_UPLOAD_INSPECTION_HOST=localhost
STOCKFLOW_UPLOAD_INSPECTION_PORT=3310
# Defaults to true (fail closed). Only the `local` profile turns it off; never set false in a deployment.
# STOCKFLOW_UPLOAD_INSPECTION_ENABLED=true

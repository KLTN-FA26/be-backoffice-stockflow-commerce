e" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;dashed=1;dashPattern=6 4;fillColor=#EAF1F8;strokeColor=#2C5A88;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="900" y="225" width="220" height="78" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="MỘT TRANSACTION Ở SERVICE NHẬN" style="rounded=1;arcSize=6;html=1;fillColor=#FDF6EC;strokeColor=#8A5209;strokeWidth=2;verticalAlign=top;align=left;spacing=8;fontSize=12;fontStyle=1;fontColor=#8A5209;" vertex="1" parent="1"><mxGeometry x="1190" y="150" width="360" height="250" as="geometry"/></mxCell><mxCell id="c15" value="processed_event" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FDF6EC;strokeColor=#8A5209;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1215" y="205" width="310" height="50" as="geometry"/></mxCell><mxCell id="c16" value="bảng nghiệp vụ" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FDF6EC;strokeColor=#8A5209;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1215" y="290" width="310" height="50" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="chưa thấy id này bao giờ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#FDF6EC;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="cũng một transaction" style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#8A5209;" vertex="1" parent="1"><mxGeometry x="1215" y="356" width="320" height="24" as="geometry"/></mxCell><mxCell id="c20" value="*  Tiến trình chết ở bất kỳ đâu: dòng chưa published vẫn nằm trong outbox, relay chạy lại đẩy tiếp.&lt;br&gt;*  Kafka giao trùng: processed_event chặn ở phía nhận. Không bao giờ trừ kho hai lần.&lt;br&gt;*  Hai bảng outbox_event và processed_event có sẵn trong cả 14 database, do V1__init.sql tạo.&lt;br&gt;!  Điều KHÔNG được làm: repository.save() rồi kafkaTemplate.send() ở hai dòng liền nhau." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1500" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="94d2f31ba706" name="F-PRD Tạo sản phẩm, duyệt, đưa lên sàn"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1522" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="F-PRD — Tạo sản phẩm, duyệt, đưa lên sàn" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.1  ·  Luồng ngắn nhất nhưng là gốc của mọi thứ khác: không có SKU thì không mua được, không nhập được, không bán được." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="product-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="1226" as="geometry"/></mxCell><mxCell id="c5" value="catalog-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="1226" as="geometry"/></mxCell><mxCell id="c7" value="NHÁNH RẼ · NGOẠI LỆ" style="rounded=0;html=1;fillColor=#F7E3E0;strokeColor=#E5C9C4;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#A03426;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#FDF6F5;strokeColor=#EBD5D1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="314" height="1226" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Tạo bản nháp sản phẩm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/products&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; product&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; variant × N&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ status = DRAFT&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="107" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Sinh biến thể và mã SKU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /products/{id}/variants/generate-matrix&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; sku (unique toàn hệ thống)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ BR-PRD-002&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; SKU phải duy nhất toàn hệ thống — BR-PRD-002&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="339" width="292" height="107" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Gửi duyệt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /products/{id}/submit&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; product.status&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → PENDING_APPROVAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Đủ tên, danh mục, đơn vị, kích thước — BR-PRD-001&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="493" width="292" height="120" as="geometry"/></mxCell><mxCell id="c12" value="Người duyệt&lt;br&gt;đồng ý?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="105" y="659" width="200" height="74" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Người duyệt phê duyệt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /products/{id}/approve&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; product&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; product_approval&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → APPROVED · ProductApproved&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Người duyệt PHẢI khác người gửi — BR-PRD-003&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="759" width="292" height="132" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Đưa lên sàn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /products/{id}/publish&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; product&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → PUBLISHED · ProductPublished&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Phải có giá bán, ảnh và danh mục — BR-PRD-004&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="937" width="292" height="120" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;06 &amp;nbsp;·&amp;nbsp; Dựng bản sao đọc cho storefront&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: ProductPublished&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; processed_event&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; catalog_product&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; catalog_price&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ bản sao đọc&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="1103" width="292" height="120" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;07 &amp;nbsp;·&amp;nbsp; Đánh index tìm kiếm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;PUT /catalog/_doc/{sku}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;&lt;b&gt;·&lt;/b&gt; → Elasticsearch index&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ tài liệu tìm kiếm&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="1269" width="292" height="95" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; Trả về bản nháp để sửa&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /products/{id}/reject&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; product.status → DRAFT&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; product_approval  lý do từ chối&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ Quay lại bước 01, không phát event nào&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Bắt buộc nêu lý do — người gửi phải biết sửa gì&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FDF0EE;strokeColor=#A03426;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="719" y="641" width="292" height="132" as="geometry"/></mxCell><mxCell id="c18" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="đồng ý" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="người dùng thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="event  ProductPublished" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#2C5A88;strokeWidth=2;fontSize=10;fontColor=#2C5A88;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="REST đồng bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=0;strokeColor=#5B6169;strokeWidth=2;fontSize=10;fontColor=#5B6169;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="từ chối" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=8 5;strokeColor=#A03426;strokeWidth=2;fontSize=10;fontColor=#A03426;labelBackgroundColor=#F7F6F3;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c12" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="·  DRAFT → PENDING_APPROVAL → APPROVED → PUBLISHED. Người duyệt phải khác người gửi — BR-PRD-003." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1414" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c27" value="·  catalog-service giữ BẢN SAO chỉ gồm sản phẩm đã publish, không phải toàn bộ product master." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="1438" width="1400" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="28d311ec72d4" name="F-PO Đơn mua hàng gửi nhà cung cấp"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1497" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="F-PO — Đơn mua hàng gửi nhà cung cấp" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="32" as="geometry"/></mxCell><mxCell id="c2" value="WBS 3.2  ·  Từ nháp tới lúc nhà cung cấp xác nhận. Ngưỡng duyệt là chỗ dễ làm sai nhất." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;fontColor=#4A4E55;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="procurement-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="314" height="1201" as="geometry"/></mxCell><mxCell id="c5" value="notification-service" style="rounded=0;html=1;fillColor=#EDEBE5;strokeColor=#D6D2C8;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#1A1C21;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#F7F6F3;strokeColor=#E0DDD5;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="162" width="314" height="1201" as="geometry"/></mxCell><mxCell id="c7" value="NHÁNH RẼ · NGOẠI LỆ" style="rounded=0;html=1;fillColor=#F7E3E0;strokeColor=#E5C9C4;strokeWidth=1;fontSize=13;fontStyle=1;fontColor=#A03426;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="122" width="314" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#FDF6F5;strokeColor=#EBD5D1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="314" height="1201" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;01 &amp;nbsp;·&amp;nbsp; Lập đơn mua hàng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /api/v1/purchase-orders&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; purchase_order&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; po_line × N&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ status = DRAFT&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;strokeColor=#8A5209;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="59" y="186" width="292" height="107" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;02 &amp;nbsp;·&amp;nbsp; Gửi duyệt theo ngưỡng giá trị&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /purchase-orders/{id}/submit&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; purchase_order.status&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → PENDING_APPROVAL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Số lượng phải đạt MOQ của NCC — BR-PO-001&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="339" width="292" height="107" as="geometry"/></mxCell><mxCell id="c11" value="Trong hạn mức&lt;br&gt;người duyệt?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFF8E8;strokeColor=#8A5209;strokeWidth=2;fontColor=#8A5209;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="105" y="493" width="200" height="74" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;03 &amp;nbsp;·&amp;nbsp; Phê duyệt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /purchase-orders/{id}/approve&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; purchase_order&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; po_approval&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → APPROVED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Hạn mức người duyệt phải ≥ giá trị PO — BR-PO-002&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="593" width="292" height="145" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;04 &amp;nbsp;·&amp;nbsp; Gửi PO cho nhà cung cấp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /purchase-orders/{id}/send&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; purchase_order.sent_at&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; outbox_event&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → SENT · PurchaseOrderSent&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="784" width="292" height="107" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;05 &amp;nbsp;·&amp;nbsp; Gửi email hoặc gọi API của NCC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;consumer: PurchaseOrderSent&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; processed_event&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; notification&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ gửi PO cho NCC&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="937" width="292" height="107" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;06 &amp;nbsp;·&amp;nbsp; Ghi nhận NCC xác nhận&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /purchase-orders/{id}/confirm&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; purchase_order.confirmed_at&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ → CONFIRMED&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="1091" width="292" height="95" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;07 &amp;nbsp;·&amp;nbsp; Sửa PO — tạo revision mới&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /purchase-orders/{id}/amend&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; po_revision (nếu sửa)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ PurchaseOrderAmended&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; CẤM sửa khi đã có phiếu nhập — BR-PO-004&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fillColor=#FFFFFF;strokeColor=#C9C5BB;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="59" y="1232" width="292" height="107" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;↯ &amp;nbsp;·&amp;nbsp; Chuyển lên cấp duyệt cao hơn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#7B808A&quot;&gt;POST /purchase-orders/{id}/escalate&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;+&lt;/b&gt; po_approval  cấp 2&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot; color=&quot;#8A5209&quot;&gt;&lt;b&gt;~&lt;/b&gt; purchase_order  vẫn PENDING_APPROVAL&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4A4E55&quot;&gt;→ Chờ cấp cao hơn duyệt&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#A03426&quot;&gt;&lt;b&gt;!&lt;/b&gt; Hạn mức người duyệt phải ≥ giá trị PO — BR-PO-002&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=7;spacingTop=2;fi
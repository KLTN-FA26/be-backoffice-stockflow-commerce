}

Table ordering.order_line_reservation [headercolor: #C0392B] {
  order_line_id  uuid [not null]
  reservation_id uuid [not null]
  indexes {
    (order_line_id, reservation_id) [pk]
  }
}

Table ordering.order_number_sequence [headercolor: #C0392B] {
  sequence_date date [pk]
  last_value    bigint [not null, default: 0]
}

Table ordering.order_partial_shipment_decision [headercolor: #C0392B] {
  id               uuid [pk]
  order_id         uuid [not null]

  picked_qty             int [not null, default: 0]
  short_qty              int [not null, default: 0]
  status                 fulfillment.pick_line_status [not null, default: 'OPEN']
  picked_by              uuid
  picked_at              timestamptz
  version                bigint [not null, default: 0]
  created_at             timestamptz [not null, default: `now()`]
  created_by             varchar(100)
  last_modified_at       timestamptz
  last_modified_by       varchar(100)
  consumed_at            timestamptz
  scanned_location_code  varchar(64)
  scanned_code           varchar(64)
  put_back_qty           int [not null, default: 0]
  put_back_location_code varchar(64)
  put_back_by            uuid
  put_back_at            timestamptz
  lpn                    varchar(30)
  whole_carton           boolean [not null, default: false]
  damaged_qty            int [not null, default: 0]
  damage_report_id       uuid
  packing_damaged_qty    int [not null, default: 0]
}

Table fulfillment.shipment [headercolor: #2C7873] {
  id                   uuid [pk]
  pack_id              uuid
  order_id             uuid [not null]
  carrier              varchar(120)
  tracking_number      varchar(128)
  status               fulfillment.shipment_status [not null]
  dispatched_at        timestamptz
  version              bigint [not null, default: 0]
  created_at           timestamptz [not null]
  created_by           varchar(100)
  last_modified_at     timestamptz
  last_modified_by     varchar(100)
  code                 varchar(48) [not null, unique]
  request_id           uuid [unique]
  warehouse_id         uuid [not null]
  package_count        int [not null, default: 1]
  partial              boolean [not null, default: false]
  partial_note         varchar(500)
  ready_at             timestamptz [not null]
  ready_by             uuid
  handed_over_at       timestamptz
  handed_over_by       uuid
  outcome_at           timestamptz
  outcome_by           uuid
  failure_reason       varchar(24)
  failure_note         varchar(500)
  cancelled_at         timestamptz
  cancel_reason        varchar(500)
  carrier_id           uuid
  load_id              uuid
  whole_order_handover boolean [not null, default: false]
}

Table fulfillment.shipment_event [headercolor: #2C7873] {
  id               uuid [pk]
  shipment_id      uuid [not null]
  status           fulfillment.shipment_event_status [not null]

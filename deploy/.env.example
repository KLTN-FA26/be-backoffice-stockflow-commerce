# =============================================================================
# Environment for the dev server (deploy/docker-compose.yml).
#
# On the VPS:   cp .env.example .env && chmod 600 .env   then fill in every CHANGE_ME.
# CI never touches .env (rsync excludes it); it lives only on the server.
#
# Generate secrets with:   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# Avoid $ and quotes in values: compose interpolates $ and keeps quotes literally.
# =============================================================================

# ---- where and what ---------------------------------------------------------
# The zone in Cloudflare. Sites are served at api., s3., media. and jaeger. under it.
DOMAIN=example.com
# GHCR image, ALWAYS lowercase (registry rule) even though the GitHub org is KLTN-FA26.
APP_IMAGE=ghcr.io/kltn-fa26/be-backoffice-stockflow-commerce

# IMAGE_TAG (the running image) is appended here by scripts/deploy.sh on the first deploy and
# kept up to date by it. Leave it alone: compose reads it, so it is what a plain
# `docker compose up -d` runs. Until the first deploy, check this file with
#   IMAGE_TAG=check docker compose config --quiet && echo CONFIG OK

# ---- PostgreSQL ---------------------------------------------------------------
DB_NAME=stockflow
DB_USER=stockflow
DB_PASSWORD=CHANGE_ME
# Postgres allows 40 connections and has 768 MB; 10 is plenty for a team-sized load.
DB_POOL_MAX=10

# ---- Redis --------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# ---- MinIO --------------------------------------------------------------------
# MinIO refuses to start with a password (or secret key) shorter than 8 characters.
# Root account: used only by minio-init, never given to the application.
MINIO_ROOT_USER=stockflow-root
MINIO_ROOT_PASSWORD=CHANGE_ME
# The application's own account, scoped to S3_BUCKET by minio-init.
S3_BUCKET=stockflow
S3_ACCESS_KEY=stockflow-app
S3_SECRET_KEY=CHANGE_ME
AWS_REGION=ap-southeast-1

# ---- object storage on AWS S3 instead of MinIO (README, "Object storage on AWS S3") ----------
# Uncomment all of these together. S3_BUCKET above becomes the AWS bucket, and S3_ACCESS_KEY /
# S3_SECRET_KEY the keys of the IAM user holding infra/aws's application policy (never root keys).
# S3_ENDPOINT must be present and EMPTY: empty means "AWS"; absent means "MinIO at s3.<domain>".
# S3_ENDPOINT=
# S3_PATH_STYLE=false
# AWS_REGION=ap-southeast-2
# PRODUCT_MEDIA_CDN_BASE_URL=https://dxxxxxxxxxxxx.cloudfront.net
# Only after infra/aws/configure-existing-bucket.sh enabled Object Lock on the bucket:
# S3_OBJECT_LOCK_ENABLED=true
# Upload scanning needs the ClamAV container (~1.2 GB, not on the 4 GB machine): both lines together.
# The first starts it (docker-compose.yml, service clamav); the second points the application at it.
# COMPOSE_PROFILES=scan
# UPLOAD_INSPECTION_ENABLED=true

# ---- application --------------------------------------------------------------
# No JWT key setting here: docker-compose.yml points JWT_PRIVATE_KEY_PATH at ./jwt, which scripts/deploy.sh
# prepares and the application fills on its first start (README, "The JWT signing key").
# Demo data (db/demo). OFF for now: it seeds the NEW product/procurement tables, which the code
# does not read yet (old and new tables coexist until each module moves), so the frontend would
# see none of it. Switching it on or off later requires resetting the database (README, "Reset the
# database"), because Flyway refuses migrations that appear out of order. Demo data includes no
# usable login either way: create accounts with scripts/create-user.sh.
FLYWAY_LOCATIONS=classpath:db/migration
# FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo
# Lets the storefront check out without an account. The request carries its own unit price and
# nothing checks it yet, so leave this false unless the frontend team is testing that flow.
GUEST_CHECKOUT_ENABLED=false

# Browser origins allowed to call the API, comma-separated. localhost:* lets the frontend team run
# their dev server against this backend; add the host a deployed frontend is served from.
# Each entry needs its scheme and no trailing slash; a bare '*' is refused at startup.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,https://*.example.com
# Optional. Regex over the peer address of connections allowed to set the client IP through
# X-Forwarded-For (what the login rate limit keys on). Unset = private ranges, which is the compose
# network nginx reaches the application over. Narrow it (e.g. to nginx's fixed IP) only if you pin the
# network's subnet; an empty value trusts nobody and every client then shares nginx's address.
# TRUSTED_PROXIES=
# com.stockflow log level. The dev profile also logs SQL statements (not their parameters).
LOG_LEVEL=DEBUG
# Fraction of requests traced into Jaeger. 1.0 = every request.
TRACE_SAMPLING=1.0
# Bump on a release whose cached types changed shape (see .env.example at the repository root).
CACHE_VERSION=v1
# THE PURGE JOB DELETES PERMANENTLY - confirm against the signed retention policy.
AUDIT_ROUTINE_RETENTION=P180D
AUDIT_SECURITY_RETENTION=P730D

# Required before deploying supplier PO communication. Set real buyer details on the VPS.
PO_BUYER_COMPANY_NAME=CHANGE_ME
PO_BUYER_COMPANY_ADDRESS=CHANGE_ME
PO_BUYER_CONTACT_NAME=CHANGE_ME
PO_BUYER_PHONE=CHANGE_ME
PO_BUYER_EMAIL=CHANGE_ME
PO_RECEIVING_ADDRESS=CHANGE_ME
# Comma-separated exact HTTPS supplier API hosts; empty disables API delivery.
SUPPLIER_API_ALLOWED_HOSTS=
# BE deploy/.env.example
BFF_ORIGIN_SECRET=CHANGE_ME_openssl_rand_hex_32
# Optional: seals carriers' API keys and webhook secrets in the database (openssl rand -base64 32).
# Blank: they cannot be saved until it is set. Back it up with the database.
STOCKFLOW_SECRETS_KEY=

# Links a producer opens without signing in (4A-3: its production order slip and print files, mailed when a
# production order is approved). The HMAC key the links are signed with, base64 of at least 32 bytes - use exactly
# `openssl rand -base64 32` (NOT the shortened secret recipe at the top). Required while STOCKFLOW_PUBLIC_BASE_URL
# below is unset or set: blank, the application (not compose) refuses to start, so set it before deploying a
# release with 4A-3. Changing it breaks every link already mailed; staff re-send them from the production order.
STOCKFLOW_LINKS_KEY=
# Optional: where the API is reached from outside; every link starts with it. Unset = https://api.<DOMAIN>.
# Set it present and EMPTY to mail no links (the mail then says the coordinator sends the files).
# STOCKFLOW_PUBLIC_BASE_URL=https://api.example.com

# Required: public frontend URL where customers redeem Sales invitations.
# Set the real HTTPS URL (for example, https://your-domain/portal/activate) on the VPS.
# Leave blank in this template so docker compose fails until it is configured.
PORTAL_ACTIVATION_URL=

# Bank transfer instructions (SCRUM-193): the company account customers are told to transfer to, shown by
# GET /api/v1/orders/me/{orderId}/transfer-instructions. Set all three; while any is blank that endpoint answers
# 503 TRANSFER_INSTRUCTIONS_UNAVAILABLE (nothing else fails). The account holder as the bank prints it.
COMPANY_BANK_NAME=
COMPANY_BANK_ACCOUNT_NUMBER=
COMPANY_BANK_ACCOUNT_NAME=

Ref: fulfillment.waybill_import_row.load_id > fulfillment.dispatch_load.id
Ref: catalog.catalog_entry.sku > product.variants.sku [delete: restrict]
Ref: catalog.customer_price.customer_id > customer.customer.id [delete: cascade]
Ref: catalog.customer_price.sku > product.variants.sku [delete: restrict]
Ref: catalog.customer_price_tier.customer_price_id > catalog.customer_price.id [delete: cascade]
Ref: catalog.pricing_rule.segment_id > customer.segment.id [delete: restrict]
Ref: catalog.pricing_rule.sku > product.variants.sku [delete: restrict]
Ref: catalog.product_listing.product_id > product.products.id
Ref: chat.conversation.assigned_agent_id > identity.app_user.id
Ref: chat.conversation.customer_id > customer.customer.id [delete: restrict]
Ref: chat.conversation.order_id > ordering.customer_order.id [delete: restrict]
Ref: chat.message.conversation_id > chat.conversation.id [delete: cascade]
Ref: notification.po_delivery_control.purchase_order_id > procurement.purchase_orders.id [delete: cascade]
Ref: notification.preference.user_id > identity.app_user.id [delete: cascade]
Ref: notification.user_notification.recipient_id > identity.app_user.id [delete: cascade]
Ref: reporting.product_sales_summary.sku > product.variants.sku [delete: restrict]
Ref: identity.portal_invitation.issued_by > identity.app_user.id
Ref: identity.portal_invitation.user_id > identity.app_user.id [delete: cascade]
Ref: identity.role_permission.permission_id > identity.permission.id [delete: cascade]
Ref: identity.role_permission.role_id > identity.app_role.id [delete: cascade]
Ref: identity.user_role.role_id > identity.app_role.id [delete: cascade]
Ref: identity.user_role.user_id > identity.app_user.id [delete: cascade]
Ref: identity.user_session.user_id > identity.app_user.id
Ref: identity.user_status_change.actor_id > identity.app_user.id
Ref: identity.user_status_change.user_id > identity.app_user.id [delete: cascade]
Ref: identity.user_warehouse.user_id > identity.app_user.id
Ref: identity.user_warehouse.warehouse_id > warehouse.warehouse.id


# =============================================================================
# Every environment variable the application reads. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored. This file is the documentation - if you add a ${VAR} to any yml, add it here
# in the same commit, or the next person deploying finds out by reading a stack trace.
#
# Variables with NO DEFAULT in application-prod.yml are marked REQUIRED. The application refuses to
# start without them, which is deliberate: booting with a development fallback and failing to
# connect looks like a network problem and wastes an afternoon.
# =============================================================================

# ---- profile ----------------------------------------------------------------
# local | prod. Anything that is not local/dev/test gets JSON logging and security ON.
SPRING_PROFILES_ACTIVE=local

# ---- database (REQUIRED in prod) --------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockflow
DB_USER=stockflow
DB_PASSWORD=stockflow
# Sized for the machine, not the module count. Roughly cores * 2 + effective spindles.
DB_POOL_MAX=20

# ---- redis (REQUIRED in prod) -----------------------------------------------
# Cache, rate limiting and the ad-hoc distributed lock. NOT the scheduler lock - that is in
# Postgres, because Redis runs with allkeys-lru and may evict a lock key.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ---- authentication (REQUIRED in prod) --------------------------------------
# Where the JWT signing keys are published. The identity module serves this today; keeping it a URI
# means moving identity out later is configuration, not code.
JWT_JWK_SET_URI=http://localhost:8080/oauth2/jwks

# ---- object storage ---------------------------------------------------------
# S3_BUCKET is REQUIRED in prod.
S3_BUCKET=stockflow
# Set for MinIO; leave EMPTY for real S3.
S3_ENDPOINT=http://localhost:9000
AWS_REGION=ap-southeast-1
# true for MinIO, false for real S3. The wrong value produces a DNS failure that looks nothing
# like a configuration problem.
S3_PATH_STYLE=true
# Leave BLANK in a deployment so the SDK picks up the instance role. Static keys are for MinIO only.
S3_ACCESS_KEY=stockflow
S3_SECRET_KEY=stockflow123
# CloudFormation output ProductMediaBaseUrl. A custom media domain is optional; CloudFront's
# generated HTTPS hostname works without DNS changes. This is public for PUBLISHED product images.
PRODUCT_MEDIA_CDN_BASE_URL=https://replace-me.cloudfront.net
# Aliases used by docker-compose for the MinIO container itself.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=stockflow
MINIO_SECRET_KEY=stockflow123

# ---- observability ----------------------------------------------------------
# OpenTelemetry collector - Jaeger's OTLP HTTP port locally. The FULL endpoint including
# /v1/traces: this feeds management.otlp.tracing.endpoint, which is a URL, not a base.
# (OTEL_EXPORTER_OTLP_ENDPOINT is deliberately NOT used - Boot's exporter does not read it.)
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
# Fraction of requests traced. 1.0 locally, 0.1 in production - sampling everything costs more in
# storage than it returns.
TRACE_SAMPLING=1.0
LOG_LEVEL=INFO

# ---- cache ------------------------------------------------------------------
# Every cache key is prefixed with this. BUMP IT on any release whose cached types changed shape,
# so new instances start from a clean namespace instead of deserialising yesterday's objects.
CACHE_VERSION=v1

# ---- audit retention --------------------------------------------------------
# ISO-8601 durations. THE PURGE JOB DELETES PERMANENTLY - confirm both against the retention policy
# the business actually signed before go-live.
AUDIT_ROUTINE_RETENTION=P180D
AUDIT_SECURITY_RETENTION=P730D

# ---- supplier communication -------------------------------------------------
# Mailpit listens on 1025 in the local Docker stack. Production uses the SMTP credentials supplied
# by the chosen mail provider. Leave username/password empty only for a local unauthenticated SMTP.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@stockflow.local
# Exact trusted HTTPS supplier API hosts, comma-separated; blank disables API delivery.
SUPPLIER_API_ALLOWED_HOSTS=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# ---- server -----------------------------------------------------------------
SERVER_PORT=8080

# ---- upload security inspection ---------------------------------------------
# Required for new media uploads. Start docker-compose.media.yml alongside the base stack.
STOCKFLOW_UPLOAD_INSPECTION_HOST=localhost
STOCKFLOW_UPLOAD_INSPECTION_PORT=3310
# Defaults to true (fail closed). Only the `local` profile turns it off; never set false in a deployment.
# STOCKFLOW_UPLOAD_INSPECTION_ENABLED=true
